{
	# Trust Cloudflare's edge IPs so {client_ip} resolves to the real visitor, not the CF edge.
	# Ranges from https://www.cloudflare.com/ips/ (update if Cloudflare changes them).
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

(spectralcodex-tls) {
	tls /certs/spectralcodex.com.pem /certs/spectralcodex.com.private.pem
}

(access-log) {
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 20
			roll_keep_for 2160h
		}
	}
}

# Stable names overwritten in place: the deploy purges the edge on change, browsers recheck after 30 days
(derivative-cache-control) {
	header {args[0]} Cache-Control "public, max-age=2592000, stale-while-revalidate=604800, s-maxage=31536000, no-transform"
}

# A missing file may land with the next deploy, so the edge holds the 404 only briefly
(derivative-not-found) {
	header Cache-Control "public, max-age=60"
	respond 404
}

(umami) {
	handle /robots.txt {
		respond "User-agent: *
Disallow: /"
	}
	import umami-origins.conf
	respond @foreign_beacon 403
	reverse_proxy umami:3000
}

(images-legacy) {
	@legacy_width path_regexp legacy_width ^/[A-Za-z0-9_-]{20}/([1-9][0-9]*)x0/filters:quality\([0-9]+\):format\((jpg|webp)\)/(.+)\.[a-z]+$
	@legacy_crop path_regexp legacy_crop ^/[A-Za-z0-9_-]{20}/([1-9][0-9]*)x([1-9][0-9]*)/filters:quality\([0-9]+\):format\((jpg|webp)\)/(.+)\.[a-z]+$
	redir @legacy_width /{re.legacy_width.3}-{re.legacy_width.1}.{re.legacy_width.2} 301
	redir @legacy_crop /{re.legacy_crop.4}-{re.legacy_crop.1}x{re.legacy_crop.2}.{re.legacy_crop.3} 301
}

www.spectralcodex.com {
	import spectralcodex-tls
	redir https://spectralcodex.com{uri} permanent
}

spectralcodex.com {
	import spectralcodex-tls
	import access-log
	root * /var/www/spectralcodex
	file_server {
		precompressed br
	}
	encode gzip

	# Scoped to 404: basic_auth fails as a Caddy error, and an unscoped block serves /404.html as a publicly cacheable 401
	handle_errors 404 {
		# WordPress-era URLs, redirected only on a miss; first match wins
		@legacy_paged path_regexp legacy_paged ^(/.+)/page/[0-9]+/$
		redir @legacy_paged {re.legacy_paged.1}/ 301

		@legacy_places path_regexp legacy_places ^/places/(?:[^/]+/)*([^/]+)/$
		redir @legacy_places /regions/{re.legacy_places.1}/ 301

		@legacy_nested_region path_regexp legacy_nested_region ^/regions/(?:[^/]+/)+([^/]+)/$
		redir @legacy_nested_region /regions/{re.legacy_nested_region.1}/ 301

		@legacy_theme {
			path_regexp legacy_theme ^/themes/([^/]+)/$
			not path /themes/taiwan-*
		}
		redir @legacy_theme /themes/taiwan-{re.legacy_theme.1}/ 301

		@legacy_attachment path_regexp legacy_attachment ^/([^/]+)/[^/]+/$
		redir @legacy_attachment /{re.legacy_attachment.1}/ 301

		@open_graph_missing path /og/*
		handle @open_graph_missing {
			import derivative-not-found
		}
		handle {
			rewrite * /404.html
			header Cache-Control "public, max-age=0, s-maxage=600"
			file_server
		}
	}

	# Split by query presence so the no-query redirect never emits a bare trailing "?"
	@no_trailing_slash_query {
		path_regexp notrailq ^(.+[^/])$
		not path_regexp \.[a-zA-Z0-9_-]+$
		expression {query} != ''
	}
	redir @no_trailing_slash_query {re.notrailq.1}/?{query} 301

	@no_trailing_slash {
		path_regexp notrail ^(.+[^/])$
		not path_regexp \.[a-zA-Z0-9_-]+$
	}
	redir @no_trailing_slash {re.notrail.1}/ 301

	import spectralcodex-redirects.conf
	import spectralcodex-redirects-generated.conf

	# geolocation kept on self for the map's GeolocateControl
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(self), camera=(), microphone=(), browsing-topics=()"
	}

	@immutable path /_x/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Caddy sorts single-path matchers by specificity and keeps the rest in file order, so the tiers must not overlap
	@static {
		path *.css *.js *.jpg *.jpeg *.png *.gif *.svg *.webp *.avif *.woff2 *.woff
		not path /_x/* /og/*
	}
	header @static Cache-Control "public, max-age=31536000"

	@open_graph path /og/*
	import derivative-cache-control @open_graph

	@data {
		path *.json
		not path /api/map/*
	}
	header @data Cache-Control "public, max-age=3600, s-maxage=86400, stale-while-revalidate=86400"

	@map_api {
		path /api/map/*
		not path /api/map/map-manifest.json /api/map/objectives/*
	}
	header @map_api Cache-Control "public, max-age=31536000, immutable"

	# Deploy manifest: stable URL, build-varying content; must not be immutable-cached
	@map_manifest path /api/map/map-manifest.json
	header @map_manifest Cache-Control "no-store"

	# Explicit paths, not *.xml, so a future feed can pick its own tier
	@meta path /robots.txt /sitemap*.xml
	header @meta Cache-Control "public, max-age=3600, s-maxage=86400"

	@html path *.html */
	header @html Cache-Control "public, max-age=3600, s-maxage=86400, stale-while-revalidate=86400"
	header @html No-Vary-Search `params=("utm_source" "utm_medium" "utm_campaign" "utm_content" "utm_term" "utm_id" "gclid" "fbclid" "mc_cid" "mc_eid"), key-order`

	# Half of the gate lives in Cloudflare cache rules; see .claude/docs/deploy-operations.md
	# `route` sorts after every top-level header, so this Cache-Control overrides the tiers above wherever the block sits
	@gated path /objectives /objectives/* /api/map/objectives/*
	route @gated {
		header Cache-Control "private, no-store"
		import spectralcodex-auth.conf
	}
}

u.spectralcodex.com {
	import spectralcodex-tls
	import umami
}

img.spectralcodex.com {
	import spectralcodex-tls
	import access-log
	root * /srv/img

	header X-Content-Type-Options nosniff
	import derivative-cache-control *

	handle_errors 404 {
		import derivative-not-found
	}

	import images-legacy

	handle /robots.txt {
		header Cache-Control "public, max-age=3600, s-maxage=86400"
		respond "User-agent: *
Allow: /"
	}

	# rsync stages partial and delayed files in dot-directories beside the served ones
	file_server {
		hide .*
	}
}
