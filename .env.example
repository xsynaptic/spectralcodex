# Config-time variables (used by Vite loadEnv in the Astro config)
DEV_SERVER_URL=http://localhost:4321/
PROD_SERVER_URL=
BUILD_ASSETS_PATH=_x

# Content paths (defaults to demo content if unset)
CONTENT_DATA_PATH=
CONTENT_MEDIA_PATH=

# Map
MAP_PROTOMAPS_API_KEY=

# Analytics
UMAMI_DOMAIN=
UMAMI_ID=

# Image derivatives (dev defaults to /_img, rendered on demand by the dev server)
IMAGE_BASE_URL=

# Webmentions
WEBMENTION_API_KEY=
WEBMENTION_DOMAIN=
WEBMENTIONS_SHOW=false

# Cache directory
CUSTOM_CACHE_PATH=
