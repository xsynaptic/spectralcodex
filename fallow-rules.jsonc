{
	"$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/rule-pack-schema.json",
	"version": 1,
	"name": "spectralcodex",
	"description": "Collection read paths and the Zod-free map island",
	"rules": [
		{
			"id": "collection-access",
			"kind": "banned-call",
			"callees": [
				"astro:content.getCollection",
				"astro:content.getEntry",
				"astro:content.getEntries",
			],
			"exclude": ["src/lib/utils/collections.ts"],
			"message": "Read collections through the collection wrappers from createCollectionData, or getRawCollection on the read path; both live in src/lib/utils/collections.ts and own the load order.",
		},
		{
			"id": "raw-read-path",
			"kind": "banned-call",
			"callees": ["getRawCollection"],
			"exclude": [
				"src/lib/collections/*/*-data.ts",
				"src/lib/utils/collections.ts",
				"**/*.test.ts",
			],
			"message": "Raw reads return pristine frontmatter without computed `_` fields; they exist for cross-collection assembly in *-data.ts that must dodge circular init. Use the wrapper's collection data instead.",
		},
		{
			"id": "client-zod",
			"kind": "banned-import",
			"specifiers": ["zod", "@spectralcodex/map-codec/schemas", "@spectralcodex/shared/schemas"],
			"files": [
				"packages/react-map-component/src/**",
				"packages/map-codec/src/**",
				"packages/shared/src/map/**",
			],
			"exclude": ["packages/map-codec/src/schemas/**", "**/*.test.ts"],
			"message": "The map island ships without Zod; classic schemas never tree-shake. Put schemas in packages/map-codec/src/schemas or @spectralcodex/shared/schemas, and keep both out of client code.",
			"severity": "error",
		},
	],
}
