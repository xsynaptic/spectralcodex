{
	"$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/rule-pack-schema.json",
	"version": 1,
	"name": "spectralcodex",
	"description": "Keeps collection reads on their sanctioned paths and Zod out of the map island",
	"rules": [
		{
			"id": "collection-access",
			"kind": "banned-call",
			"callees": [
				"astro:content.getCollection",
				"astro:content.getEntry",
				"astro:content.getEntries",
			],
			"exclude": ["src/lib/utils/collections.ts"],
			"message": "Read collections through a wrapper made by createCollectionData, or through getRawCollection on the read path. Both live in src/lib/utils/collections.ts, which decides the order collections load in.",
		},
		{
			"id": "raw-read-path",
			"kind": "banned-call",
			"callees": ["getRawCollection"],
			"exclude": [
				"src/lib/collections/*/*-data.ts",
				"src/lib/utils/collections.ts",
				"**/*.test.ts",
			],
			"message": "getRawCollection returns frontmatter as written, without the computed `_` fields. It exists for the *-data.ts files that assemble across collections and would otherwise import each other in a circle at startup. Everywhere else, use the wrapper's collection data.",
		},
		{
			"id": "client-zod",
			"kind": "banned-import",
			"specifiers": [
				"zod",
				"@spectralcodex/map-codec/directory",
				"@spectralcodex/map-codec/schemas",
				"@spectralcodex/shared/schemas",
				"#directory",
				"#schemas",
			],
			"ignoreTypeOnly": true,
			"files": [
				"packages/react-map-component/src/**",
				"packages/map-codec/src/**",
				"packages/shared/src/map/**",
				"packages/shared/src/constants.ts",
				"packages/shared/src/i18n.ts",
				"packages/shared/src/search-tracker.ts",
				"packages/shared/src/text.ts",
			],
			"exclude": [
				"packages/map-codec/src/directory/**",
				"packages/map-codec/src/schemas/**",
				"**/*.test.ts",
			],
			"message": "The map island ships without Zod, because Zod's classic schemas don't tree-shake. Schemas belong in packages/map-codec/src/schemas or @spectralcodex/shared/schemas, and client code imports neither, nor the build-only @spectralcodex/map-codec/directory.",
			"severity": "error",
		},
	],
}
