{
	"extends": "astro/tsconfigs/strictest",
	"compilerOptions": {
		"outDir": "dist",
		"strictNullChecks": true,
		"erasableSyntaxOnly": true,
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"types": ["vitest/globals"]
	},
	"include": [".astro/types.d.ts", "**/*", "**/*.astro"],
	"exclude": [".cache", "dist", "node_modules", "**/*/temp"]
}
