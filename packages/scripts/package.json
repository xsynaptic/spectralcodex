{
	"name": "@spectralcodex/scripts",
	"version": "1.1.1",
	"description": "Scripts for Spectral Codex",
	"type": "module",
	"private": true,
	"scripts": {
		"check-links": "tsx ./src/check-links/index.ts",
		"content-schemas": "tsx ./src/content-schemas/index.ts",
		"deploy-app": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../deploy/.env ./src/deploy/deploy-app.cli.ts",
		"deploy-caddy": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../deploy/.env ./src/deploy/deploy-caddy.cli.ts",
		"deploy-infra": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../deploy/.env ./src/deploy/deploy-infra.cli.ts",
		"deploy-media": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../deploy/.env ./src/deploy/deploy-media.cli.ts",
		"deploy-og": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../deploy/.env ./src/deploy/deploy-og.cli.ts",
		"deploy-site": "NODE_ENV=production tsx --env-file-if-exists=../../.env --env-file-if-exists=../../deploy/.env ./src/deploy/deploy.ts",
		"generate-redirects": "tsx ./src/generate-redirects/index.ts",
		"improve-content": "tsx ./src/improve-content/index.ts",
		"map-divisions": "tsx ./src/map-divisions/index.ts",
		"media-orphans": "tsx ./src/media-orphans/index.ts",
		"og-image": "tsx ./src/og-image/index.ts",
		"similar-content": "tsx ./src/similar-content/index.ts",
		"sitemap-lastmod": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../deploy/.env ./src/sitemap-lastmod/index.cli.ts",
		"validate-content": "tsx ./src/validate-content/index.ts",
		"webmentions": "tsx --env-file-if-exists=../../.env ./src/webmentions/index.ts"
	},
	"devDependencies": {
		"@astrojs/markdown-remark": "^7.2.4",
		"@duckdb/node-api": "1.5.5-r.4",
		"@fontsource/lora": "^5.3.0",
		"@fontsource/noto-serif-tc": "^5.3.0",
		"@fontsource/noto-serif-thai": "^5.3.0",
		"@fontsource/zen-antique": "^5.3.0",
		"@huggingface/transformers": "^4.2.0",
		"@spectralcodex/shared": "workspace:*",
		"@turf/helpers": "^7.4.0",
		"@turf/turf": "^7.4.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/d3-geo": "^3.1.1",
		"@types/geojson": "^7946.0.16",
		"@types/sanitize-html": "^2.16.1",
		"@xsynaptic/unified-tools": "^5.1.3",
		"astro": "^7.2.8",
		"better-sqlite3": "^13.0.3",
		"chalk": "^6.0.0",
		"d3-geo": "^3.1.1",
		"devalue": "^5.9.1",
		"flatgeobuf": "^4.4.0",
		"geokdbush": "^2.1.0",
		"kdbush": "^4.1.0",
		"keyv": "^5.6.0",
		"keyv-file": "^5.3.5",
