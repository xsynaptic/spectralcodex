---
import { render } from 'astro:content';

import type { ComputedEntry } from '#lib/collections/collections-types.ts';

import ContentEntryArticle from '#components/content/content-entry-article.astro';
import { navigationFooterItems } from '#components/navigation/navigation-footer.ts';
import Prose from '#components/parts/prose.astro';
import { getMultilingualContent } from '#lib/i18n/i18n-utils.ts';
import { buildAuthorSchema } from '#lib/utils/seo-structured-data.ts';

interface Props {
	entry: ComputedEntry<'pages'>;
}

const { entry } = Astro.props;

// The about page is the canonical home of the Person entity, so emit it with sameAs links
const schemas =
	entry.id === 'about'
		? [
				buildAuthorSchema({
					sameAs: navigationFooterItems.filter((item) => item.rel === 'me').map((item) => item.url),
				}),
			]
		: [];

const titleMultilingual = getMultilingualContent({ data: entry.data, prop: 'title' })?.primary;

const { Content } = await render(entry);
---

<ContentEntryArticle entry={entry} schemas={schemas} titleMultilingual={titleMultilingual}>
	<Prose class:list={['e-content', 'pb-4']} data-reading-frame showBlocks={true}>
		<Content />
	</Prose>
</ContentEntryArticle>
