---
// fallow-ignore-file code-duplication -- Feed sits outside the section that collection-list slots into
import type { Page } from 'astro';

import { render } from 'astro:content';

import type { ComputedEntry } from '#lib/collections/collections-types.ts';

import ContentDate from '#components/content/content-date.astro';
import ContentExcerpt from '#components/content/content-excerpt.astro';
import ContentHeader from '#components/content/content-header.astro';
import ContentSection from '#components/content/content-section.astro';
import MainSite from '#components/main/main-site.astro';
import PaginationCounter from '#components/parts/pagination-counter.astro';
import PaginationSelect from '#components/parts/pagination-select.astro';
import { MicroformatClassNames } from '#components/types.ts';
import { getTranslations } from '#lib/i18n/i18n-translations.ts';
import { getImageFeaturedId } from '#lib/image/image-featured.ts';
import { getPagination } from '#lib/utils/pagination.ts';
import { getContentPath } from '#lib/utils/routing.ts';
import { getIndexCard } from '#lib/utils/seo-cards.ts';
import { getSeoImageProps } from '#lib/utils/seo.ts';
import { renderMarkdownInline } from '#lib/utils/text.ts';

interface Props {
	page: Page<ComputedEntry<'posts'>>;
}

const { page } = Astro.props;

const t = getTranslations();

const title = t('collection.posts.labelPlural');
const description = t('collection.posts.description');
---

<MainSite
	meta={{
		description,
		image: getSeoImageProps({ alt: title, card: getIndexCard({ key: 'posts', title }) }),
		title,
	}}
>
	<ContentHeader>
		<Fragment slot="header-title">{title}</Fragment>
		<Fragment slot="header-subtitle">
			<PaginationCounter page={page} />
		</Fragment>
	</ContentHeader>
	<ContentSection>
		<Fragment
			set:html={page.currentPage === 1 ? renderMarkdownInline(description) : undefined}
			slot="section-description"
		/>
	</ContentSection>
	{page.data.length > 0 ? (
		<div class={MicroformatClassNames.Feed}>
			{page.data.map(async (entry, index) => {
				const { Content } = await render(entry);
				const imageFeaturedId = getImageFeaturedId({ imageFeatured: entry.data.imageFeatured });

				return (
					<ContentExcerpt
						entryUrl={getContentPath(entry.collection, entry.id)}
						imageId={imageFeaturedId}
						showDivider={index + 1 < page.data.length}
					>
						<Fragment slot="excerpt-title">{entry.data.title}</Fragment>
						<Fragment slot="excerpt-subtitle">
							<ContentDate
								dateCreated={entry.data.dateCreated}
								dateUpdated={entry.data.dateUpdated}
							/>
						</Fragment>
						<Content />
					</ContentExcerpt>
				);
			})}
		</div>
	) : undefined}
	<ContentSection>
		<PaginationSelect class="mt-4 md:mt-8" pagination={getPagination(page)} />
	</ContentSection>
</MainSite>
