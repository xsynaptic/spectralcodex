---
import type { MapComponentData } from '@spectralcodex/react-map-component';
import type { Page } from 'astro';
import type { CollectionEntry } from 'astro:content';

import type { CatalogItem } from '#lib/catalog/catalog-types.ts';

import ContentEntryDetail from '#components/content/content-entry-detail.astro';
import ContentProse from '#components/content/content-prose.astro';
import Anchor from '#components/parts/anchor.astro';
import DividedItem from '#components/parts/divided-item.astro';
import SectionLinks from '#components/sections/section-links.astro';
import SectionMap from '#components/sections/section-map.astro';
import SectionPreviews from '#components/sections/section-previews.astro';
import SectionRegions from '#components/sections/section-regions.astro';
import SectionThemes from '#components/sections/section-themes.astro';
import { formatCitation } from '#lib/collections/resources/resources-citation.ts';
import { getTranslations } from '#lib/i18n/i18n-translations.ts';
import { LanguageCodeEnum } from '#lib/i18n/i18n-types.ts';
import { formatNumber } from '#lib/utils/text.ts';

interface Props {
	entry: CollectionEntry<'resources'>;
	mapData: MapComponentData;
	page: Page<CatalogItem>;
}

const { entry, mapData, page } = Astro.props;

// The header carries a short citation; the full one, with publishedDetails, lives in Sources
const citation = formatCitation({
	lang: LanguageCodeEnum.English,
	title: entry.data.title,
	authorNames: entry.data.authors?.map((author) => author.name),
	publisher: entry.data.publisher,
	publishedDate: entry.data.publishedDate,
	publishedDetails: undefined,
});

const citationLine = [citation.authors, citation.published]
	.filter((part) => part !== undefined)
	.join(citation.delimiter);

const regionIds = entry.data.regions?.map(({ id }) => id);
const themeIds = entry.data.themes?.map(({ id }) => id);

const t = getTranslations();
---

<ContentEntryDetail entry={entry} page={page} prefetchUrls={mapData.prefetchUrls}>
	<Fragment slot="header-subtitle">
		{entry.data.url ? (
			<DividedItem>
				<Anchor href={entry.data.url}>{t('collection.resources.homepage.label')}</Anchor>
			</DividedItem>
		) : undefined}
		{entry.data._entryCount ? (
			<DividedItem>
				<span
					set:html={`${t('collection.resources.entryCount.label')}: ${formatNumber({ number: entry.data._entryCount })}`}
				/>
			</DividedItem>
		) : undefined}
		{citationLine ? <DividedItem>{citationLine}</DividedItem> : undefined}
	</Fragment>
	<ContentProse entry={entry} />
	<SectionMap mapData={mapData} entryTitle={entry.data.title} />
	<SectionLinks entry={entry} />
	<SectionRegions regionIds={regionIds} />
	<SectionThemes themeIds={themeIds} />
	<SectionPreviews page={page} />
</ContentEntryDetail>
