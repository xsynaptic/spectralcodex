---
import type { ChronologyIndexData } from '#lib/collections/chronology/chronology-types.ts';

import ChronologyNavigation from '#components/chronology/chronology-navigation.astro';
import ChronologyPeriod from '#components/chronology/chronology-period.astro';
import ContentHeader from '#components/content/content-header.astro';
import MainSite from '#components/main/main-site.astro';
import { getTranslations } from '#lib/i18n/i18n-translations.ts';
import { getImageFeaturedGroupByCatalog } from '#lib/image/image-featured.ts';
import { getSitePath } from '#lib/utils/routing.ts';
import { getSeoImageProps } from '#lib/utils/seo.ts';

interface Props {
	chronologyIndexData: ChronologyIndexData;
	chronologyYears: Array<string>;
}

const { chronologyIndexData, chronologyYears } = Astro.props;

const t = getTranslations();

const title = t('chronology.index.title');
---

<MainSite
	meta={{
		description: t('chronology.index.description'),
		image: getSeoImageProps({
			alt: title,
			id: 'index-chronology',
		}),
		title,
	}}
>
	<ContentHeader>
		<Fragment slot="header-title">{title}</Fragment>
		<Fragment slot="header-subtitle">
			<ChronologyNavigation chronologyYears={chronologyYears} />
		</Fragment>
	</ContentHeader>
	{Object.entries(chronologyIndexData)
		.sort(([yearA], [yearB]) => yearB.localeCompare(yearA))
		.map(([year, monthlyData]) => {
			const imageFeaturedGroup = getImageFeaturedGroupByCatalog({
				items: monthlyData.highlights,
			});

			return (
				<ChronologyPeriod
					anchorColor="primary"
					href={getSitePath('chronology', year)}
					imageFeaturedGroup={imageFeaturedGroup}
					summary={monthlyData}
					title={year}
				/>
			);
		})}
</MainSite>
