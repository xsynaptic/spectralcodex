---
import type { Page } from 'astro';

import type { CatalogItem } from '#lib/catalog/catalog-types.ts';

import CollectionList from '#components/parts/collection-list.astro';
import PaginationCounter from '#components/parts/pagination-counter.astro';
import PreviewGrid from '#components/parts/preview-grid.astro';

interface Props {
	page: Page<CatalogItem>;
}

const { page } = Astro.props;
---

<CollectionList collection="locations" page={page}>
	<Fragment slot="header-subtitle">
		<PaginationCounter page={page} />
	</Fragment>
	<PreviewGrid
		items={page.data}
		showDate={true}
		showMicroformats={true}
		showRegion={true}
		showTitleMultilingual={true}
		titleAs="h2"
	/>
</CollectionList>
