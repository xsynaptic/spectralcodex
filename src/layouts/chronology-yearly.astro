---
import type {
	ChronologyDailyCounts,
	ChronologyMonthlyItem,
} from '#lib/collections/chronology/chronology-types.ts';

import ChronologyActivity from '#components/chronology/chronology-activity.astro';
import ChronologyItem from '#components/chronology/chronology-item.astro';
import ChronologyNavigation from '#components/chronology/chronology-navigation.astro';
import ContentHeader from '#components/content/content-header.astro';
import ImageCarousel from '#components/image/image-carousel.astro';
import MainSite from '#components/main/main-site.astro';
import Anchor from '#components/parts/anchor.astro';
import { createChronologyImageFeaturedGroupFunction } from '#lib/collections/chronology/chronology-utils.ts';
import { getTranslations } from '#lib/i18n/i18n-translations.ts';
import { getSiteUrl } from '#lib/utils/routing.ts';
import { getSeoHideSearch, getSeoImageProps } from '#lib/utils/seo.ts';
import { formatStringTemplate } from '#lib/utils/text.ts';

interface Props {
	chronologyMonthlyData: Array<ChronologyMonthlyItem>;
	chronologyYear: string;
	chronologyYears: Array<string>;
	chronologyDailyData: Record<string, ChronologyDailyCounts>;
}

const { chronologyMonthlyData, chronologyYear, chronologyYears, chronologyDailyData } = Astro.props;

const getChronologyImageFeaturedGroup = await createChronologyImageFeaturedGroupFunction();

const t = getTranslations();

const title = formatStringTemplate(t('chronology.yearly.title'), { date: chronologyYear });
---

<MainSite
	meta={{
		title,
		description: formatStringTemplate(t('chronology.yearly.description'), { date: chronologyYear }),
		image: getSeoImageProps({
			id: chronologyYear,
			alt: title,
		}),
		...getSeoHideSearch(true),
	}}
>
	<ContentHeader>
		<Fragment slot="header-title">{title}</Fragment>
		<Fragment slot="header-subtitle"
			><ChronologyNavigation currentYear={chronologyYear} chronologyYears={chronologyYears}
				><Anchor href={getSiteUrl('chronology')} linkColor="accent" class="font-semibold"
					>{t('chronology.index.label')}</Anchor
				></ChronologyNavigation
			></Fragment
		>
	</ContentHeader>
	{
		chronologyMonthlyData
			.sort((a, b) => Number(a.month) - Number(b.month))
			.map((monthlyData) => {
				const imageFeaturedGroup = getChronologyImageFeaturedGroup(monthlyData);
				const monthlyUrl = getSiteUrl('chronology', monthlyData.year, monthlyData.month);

				return (
					<div class="content-column-fill mb-8">
						<div class="flex flex-col gap-2 px-4 text-sm text-primary-700 sm:px-0 dark:text-primary-400">
							<h2 class="border-b border-primary-200 pb-1 text-sm font-semibold uppercase dark:border-primary-700">
								<Anchor href={monthlyUrl} linkColor="highlight">
									{monthlyData.monthName}
								</Anchor>
							</h2>
							<div class="flex flex-col gap-2">
								<ChronologyItem
									title={t('chronology.updated.label')}
									items={monthlyData.updated}
									count={monthlyData.updatedCount}
									url={monthlyUrl}
								/>
								<ChronologyItem
									title={t('chronology.created.label')}
									items={monthlyData.created}
									count={monthlyData.createdCount}
									url={monthlyUrl}
								/>
								<ChronologyItem
									title={t('chronology.visited.label')}
									items={monthlyData.visited}
									count={monthlyData.visitedCount}
									url={monthlyUrl}
								/>
							</div>
						</div>
						{imageFeaturedGroup && imageFeaturedGroup.length > 0 ? (
							<ImageCarousel class="mt-4" imageFeaturedGroup={imageFeaturedGroup} />
						) : undefined}
					</div>
				);
			})
	}
	<ChronologyActivity year={chronologyYear} dailyData={chronologyDailyData} />
</MainSite>
