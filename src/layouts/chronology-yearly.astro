---
import type { CatalogItem } from '#lib/catalog/catalog-types.ts';
import type {
	ChronologyDailyCounts,
	ChronologyMonthlyItem,
} from '#lib/collections/chronology/chronology-types.ts';

import ChronologyActivity from '#components/chronology/chronology-activity.astro';
import ChronologyNavigation from '#components/chronology/chronology-navigation.astro';
import ChronologyPeriod from '#components/chronology/chronology-period.astro';
import ContentHeader from '#components/content/content-header.astro';
import MainSite from '#components/main/main-site.astro';
import Anchor from '#components/parts/anchor.astro';
import { createChronologyImageFeaturedGroupFunction } from '#lib/collections/chronology/chronology-queries.ts';
import { getTranslations } from '#lib/i18n/i18n-translations.ts';
import { getImageFeaturedGroupByCatalog } from '#lib/image/image-featured.ts';
import { getSitePath } from '#lib/utils/routing.ts';
import { getChronologyCard } from '#lib/utils/seo-cards.ts';
import { getSeoImageProps } from '#lib/utils/seo.ts';
import { formatStringTemplate } from '#lib/utils/text.ts';

interface Props {
	chronologyDailyData: Record<string, ChronologyDailyCounts>;
	chronologyMonthlyData: Array<ChronologyMonthlyItem>;
	chronologyYear: string;
	chronologyYearHighlights: Array<CatalogItem> | undefined;
	chronologyYears: Array<string>;
}

const {
	chronologyDailyData,
	chronologyMonthlyData,
	chronologyYear,
	chronologyYearHighlights,
	chronologyYears,
} = Astro.props;

const getChronologyImageFeaturedGroup = await createChronologyImageFeaturedGroupFunction();

const t = getTranslations();

const title = formatStringTemplate(t('chronology.yearly.title'), { date: chronologyYear });
---

<MainSite
	meta={{
		description: formatStringTemplate(t('chronology.yearly.description'), { date: chronologyYear }),
		image: getSeoImageProps({
			alt: title,
			card: getChronologyCard({
				id: chronologyYear,
				imageId: getImageFeaturedGroupByCatalog({ items: chronologyYearHighlights })?.[0]?.id,
				title,
			}),
		}),
		title,
	}}
>
	<ContentHeader>
		<Fragment slot="header-title">{title}</Fragment>
		<Fragment slot="header-subtitle">
			<ChronologyNavigation chronologyYears={chronologyYears} currentYear={chronologyYear}>
				<Anchor anchorColor="accent" href={getSitePath('chronology')}>
					{t('chronology.index.label')}
				</Anchor>
			</ChronologyNavigation>
		</Fragment>
	</ContentHeader>
	{chronologyMonthlyData
		.toSorted((a, b) => Number(a.month) - Number(b.month))
		.map((monthlyData) => {
			const imageFeaturedGroup = getChronologyImageFeaturedGroup(monthlyData);
			const monthlyUrl = getSitePath('chronology', monthlyData.year, monthlyData.month);

			return (
				<ChronologyPeriod
					anchorColor="highlight"
					href={monthlyUrl}
					imageFeaturedGroup={imageFeaturedGroup}
					summary={monthlyData}
					title={monthlyData.monthName}
					url={monthlyUrl}
				/>
			);
		})}
	<ChronologyActivity dailyData={chronologyDailyData} year={chronologyYear} />
</MainSite>
