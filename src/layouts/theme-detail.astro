---
import type { MapComponentData } from '@spectralcodex/react-map-component';
import type { Page } from 'astro';
import type { CollectionEntry } from 'astro:content';

import type { CatalogItem } from '#lib/catalog/catalog-types.ts';

import ContentCollectionLink from '#components/content/content-collection-link.astro';
import ContentEntryCounts from '#components/content/content-entry-counts.astro';
import ContentEntryDetail from '#components/content/content-entry-detail.astro';
import ContentProse from '#components/content/content-prose.astro';
import DividedItem from '#components/parts/divided-item.astro';
import SectionLinks from '#components/sections/section-links.astro';
import SectionMap from '#components/sections/section-map.astro';
import SectionPreviewList from '#components/sections/section-preview-list.astro';
import SectionPreviews from '#components/sections/section-previews.astro';
import SectionRegions from '#components/sections/section-regions.astro';
import SectionSources from '#components/sections/section-sources.astro';
import SectionThemes from '#components/sections/section-themes.astro';
import SectionWebmentions from '#components/sections/section-webmentions.astro';

interface Props {
	entry: CollectionEntry<'themes'>;
	mapData: MapComponentData;
	catalogItems: Array<CatalogItem>;
	catalogItemsCount: number;
	backlinksCount: number;
	relatedThemeIds: Array<string>;
	page: Page<CatalogItem>;
}

const { entry, mapData, catalogItems, catalogItemsCount, backlinksCount, relatedThemeIds, page } =
	Astro.props;

const regionIds = entry.data.regions?.map(({ id }) => id);
const themeIds = entry.data.themes?.map(({ id }) => id);
const allThemeIds = [...new Set([...(themeIds ?? []), ...relatedThemeIds])];
---

<ContentEntryDetail
	entry={entry}
	page={page}
	prefetchUrls={mapData.prefetchUrls}
	hideSearch={entry.data.hideSearch}
>
	<Fragment slot="header-subtitle">
		<DividedItem>
			<ContentCollectionLink collection={entry.collection} />
		</DividedItem>
		<ContentEntryCounts entryCount={entry.data._entryCount ?? 0} backlinksCount={backlinksCount} />
	</Fragment>
	<ContentProse entry={entry} />
	<SectionMap mapData={mapData} />
	<SectionLinks entry={entry} />
	<SectionSources entry={entry} />
	<SectionRegions regionIds={regionIds} />
	<SectionThemes themeIds={allThemeIds} />
	<SectionWebmentions entry={entry} />
	<SectionPreviews page={page} showMicroformats={true} />
	{page.currentPage === 1 && catalogItems.length > 0 ? (
		<SectionPreviewList items={catalogItems} count={catalogItemsCount} />
	) : undefined}
</ContentEntryDetail>
