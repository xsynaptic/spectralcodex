---
import type { CatalogItem } from '#lib/catalog/catalog-types.ts';

import ContentSection from '#components/content/content-section.astro';
import ImageHero from '#components/image/image-hero.astro';
import MainSite from '#components/main/main-site.astro';
import Anchor from '#components/parts/anchor.astro';
import AuthorCard from '#components/parts/author-card.astro';
import AuthorPhoto from '#components/parts/author-photo.astro';
import CardFrame from '#components/parts/card-frame.astro';
import PreviewGrid from '#components/parts/preview-grid.astro';
import Prose from '#components/parts/prose.astro';
import SectionWebmentions from '#components/sections/section-webmentions.astro';
import { MicroformatClassNames } from '#components/types.ts';
import { tailwindBreakpointSm } from '#constants.ts';
import { getCatalogStats } from '#lib/catalog/catalog-stats.ts';
import { getTranslations } from '#lib/i18n/i18n-translations.ts';
import { getImageFeaturedGroupByCatalog } from '#lib/image/image-featured.ts';
import { getSitePath } from '#lib/utils/routing.ts';
import { buildAuthorSchema, buildWebSiteSchema } from '#lib/utils/seo-structured-data.ts';
import { getSeoImageProps } from '#lib/utils/seo.ts';
import { renderMarkdownInline } from '#lib/utils/text.ts';
import { formatStringTemplate } from '#lib/utils/text.ts';

interface Props {
	featuredCatalogItems: Array<CatalogItem>;
	recentCatalogItems: Array<CatalogItem>;
	themesCatalogItems: Array<CatalogItem>;
	seriesCatalogItems: Array<CatalogItem>;
}

const t = getTranslations();

const contentStats = await getCatalogStats();

const { featuredCatalogItems, recentCatalogItems, themesCatalogItems, seriesCatalogItems } =
	Astro.props;

const imageFeaturedGroup = getImageFeaturedGroupByCatalog({
	items: featuredCatalogItems,
	shuffle: true,
	hero: true,
});

const hasHeroImage = !!imageFeaturedGroup && imageFeaturedGroup.length > 0;
---

<MainSite
	meta={{
		image: getSeoImageProps({
			id: 'index-homepage',
			alt: t('site.title'),
		}),
	}}
	schemas={[buildWebSiteSchema(), buildAuthorSchema()]}
	hasHeroImage={hasHeroImage}
	isHomepage={true}
>
	{hasHeroImage ? (
		<ImageHero imageFeaturedGroup={imageFeaturedGroup} withTitle={false} />
	) : undefined}
	<ContentSection class="mt-4" {...(hasHeroImage ? { id: 'main-content' } : {})}>
		<CardFrame
			class:list={[
				'mb-4 min-w-45 xs:float-end xs:mt-1 xs:mb-1 xs:ml-4 xs:w-3/10 xs:max-w-75 lg:mt-2 lg:mb-2',
				MicroformatClassNames.Card,
			]}
		>
			<AuthorPhoto
				sizes={`(min-width: 360px) 180px, (min-width: ${tailwindBreakpointSm}) 300px, 300px`}
			/>
			<AuthorCard />
		</CardFrame>
		<Prose>
			<Fragment set:html={renderMarkdownInline(t('home.introduction'))} />
			<Fragment
				set:html={renderMarkdownInline(
					formatStringTemplate(t('home.overview'), {
						locationsCount: contentStats.locations.itemCount,
						locationsWithImagesCount: contentStats.locations.withImages,
						postsCount: contentStats.posts.itemCount,
						regionsCount: contentStats.regions.itemCount,
						themesCount: contentStats.themes.itemCount,
						imagesCount: contentStats.images.itemCount,
						linksExternalCount: contentStats.linksExternal.itemCount,
						totalWordCount: contentStats.total.wordCount,
					}),
				)}
			/>
		</Prose>
	</ContentSection>
	<ContentSection class="clear-both">
		<Fragment slot="section-title">{t('home.recent.label')}</Fragment>
		<PreviewGrid
			items={recentCatalogItems}
			showDate={true}
			showMicroformats={true}
			showRegion={true}
			showTitleMultilingual={true}
		/>
	</ContentSection>
	<ContentSection>
		<Fragment slot="section-title">
			<Anchor href={getSitePath('themes')} anchorColor="primary">
				{t('collection.themes.labelPlural')}
			</Anchor>
		</Fragment>
		<Fragment slot="section-description" set:html={renderMarkdownInline(t('home.themes'))} />
		<PreviewGrid
			items={themesCatalogItems}
			showLocations={true}
			showPosts={true}
			showTitleMultilingual={true}
		/>
	</ContentSection>
	<ContentSection>
		<Fragment slot="section-title">
			<Anchor href={getSitePath('series')} anchorColor="primary">
				{t('collection.series.labelPlural')}
			</Anchor>
		</Fragment>
		<Fragment slot="section-description" set:html={renderMarkdownInline(t('home.series'))} />
		<PreviewGrid items={seriesCatalogItems} showLocations={true} showPosts={true} />
	</ContentSection>
	<SectionWebmentions entry={undefined} />
</MainSite>
