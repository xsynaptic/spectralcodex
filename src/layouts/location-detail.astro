---
import type { CatalogItem } from '#lib/catalog/catalog-types.ts';
import type { ComputedEntry } from '#lib/collections/collections-types.ts';
import type { MapComponentData } from '#lib/map/map-data.ts';

import ContentCollectionLink from '#components/content/content-collection-link.astro';
import ContentEntryArticle from '#components/content/content-entry-article.astro';
import ContentImage from '#components/content/content-image.astro';
import ContentProse from '#components/content/content-prose.astro';
import SectionDetails from '#components/locations/locations-section-details.astro';
import SectionNearbyList from '#components/locations/locations-section-nearby-list.astro';
import SectionNotices from '#components/locations/locations-section-notices.astro';
import SectionPoints from '#components/locations/locations-section-points.astro';
import DividedItem from '#components/parts/divided-item.astro';
import RegionsBreadcrumbs from '#components/regions/regions-breadcrumbs.astro';
import SectionBacklinks from '#components/sections/section-backlinks.astro';
import SectionDateList from '#components/sections/section-date-list.astro';
import SectionLinks from '#components/sections/section-links.astro';
import SectionMap from '#components/sections/section-map.astro';
import SectionPreviews from '#components/sections/section-previews.astro';
import SectionSeries from '#components/sections/section-series.astro';
import SectionSimilar from '#components/sections/section-similar.astro';
import SectionSources from '#components/sections/section-sources.astro';
import SectionThemes from '#components/sections/section-themes.astro';
import SectionWebmentions from '#components/sections/section-webmentions.astro';
import { getAtlasLocationPage } from '#lib/atlas/atlas-data.ts';
import { createLocationEntryDisplayFunction } from '#lib/collections/locations/locations-queries.ts';
import { getLocationStructuredData } from '#lib/collections/locations/locations-structured-data.ts';
import { getTranslations } from '#lib/i18n/i18n-translations.ts';
import { getImageFeaturedId, getImageHeroId } from '#lib/image/image-featured.ts';
import { hasEntryContent } from '#lib/utils/astro.ts';
import { isGeometryHidden } from '#lib/utils/content-policy.ts';

interface Props {
	backlinks: Array<CatalogItem> | undefined;
	catalogItems: Array<CatalogItem>;
	entry: ComputedEntry<'locations'>;
	mapData: MapComponentData;
}

const { backlinks, catalogItems, entry, mapData } = Astro.props;

const getLocationEntryDisplay = await createLocationEntryDisplayFunction();
const {
	addressBase,
	addressMultilingual,
	regionLangCode,
	regionPrimary,
	titleMultilingual,
	titleMultilingualAdditional,
} = getLocationEntryDisplay(entry);

const themeIds = entry.data.themes?.map(({ id }) => id);

const hasContent = hasEntryContent(entry);
const hasHeroImage = !!getImageHeroId({ imageFeatured: entry.data.imageFeatured });
const imageFeaturedId = getImageFeaturedId({ imageFeatured: entry.data.imageFeatured });

const hideGeometry = isGeometryHidden(entry);

const showChinese = regionLangCode?.startsWith('zh');

const atlas = await getAtlasLocationPage(entry, mapData);

const t = getTranslations();
---

<ContentEntryArticle
	atlas={atlas}
	entry={entry}
	schemas={await getLocationStructuredData(entry, { url: Astro.url.toString() })}
	titleMultilingual={titleMultilingual}
	titleMultilingualAdditional={titleMultilingualAdditional}
>
	<Fragment slot="header-subtitle">
		<DividedItem>
			<ContentCollectionLink collection="locations" />
		</DividedItem>
		{regionPrimary ? (
			<DividedItem>
				<RegionsBreadcrumbs entry={regionPrimary} showCurrentLink={true} />
			</DividedItem>
		) : undefined}
	</Fragment>
	{!hasContent && !hasHeroImage && imageFeaturedId ? (
		<ContentImage
			alt={entry.data.title}
			imageId={imageFeaturedId}
			priority={true}
			showMetadata={true}
		/>
	) : undefined}
	<ContentProse
		class="e-content"
		entry={entry}
		{...(hasContent ? { 'data-reading-frame': '' } : {})}
	/>
	{hideGeometry ? undefined : (
		<SectionMap
			class="atlas-inline-map"
			entryTitle={entry.data.title}
			mapData={mapData}
			showAtlasOpen={!!atlas}
		/>
	)}
	<SectionNotices entry={entry} hideGeometry={hideGeometry} langCode={regionLangCode} />
	{hideGeometry ? undefined : <SectionPoints entry={entry} showChinese={showChinese} />}
	<SectionDetails
		address={addressBase}
		addressMultilingual={addressMultilingual}
		entry={entry}
		hideGeometry={hideGeometry}
		showChinese={showChinese}
	/>
	{hideGeometry ? undefined : (
		<SectionDateList dates={entry.data.dateRecorded} sectionTitle={t('section.dateRecorded')} />
	)}
	{hideGeometry ? undefined : <SectionLinks entry={entry} />}
	{hideGeometry ? undefined : <SectionSources entry={entry} />}
	<SectionThemes themeIds={themeIds} />
	<SectionSeries entry={entry} />
	<SectionBacklinks backlinks={backlinks} />
	<SectionWebmentions entry={entry} />
	{hideGeometry ? undefined : <SectionNearbyList entry={entry} showChinese={showChinese} />}
	<SectionPreviews items={catalogItems} sectionTitle={t('section.content.locations')} />
	<SectionSimilar entry={entry} limit={12} showPreviews={true} />
</ContentEntryArticle>
