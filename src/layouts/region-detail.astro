---
import type { Page } from 'astro';
import type { CollectionEntry } from 'astro:content';

import type { CatalogItem } from '#lib/catalog/catalog-types.ts';
import type { RegionsOption } from '#lib/collections/regions/regions-options.ts';
import type { MapComponentData } from '#lib/map/map-data.ts';

import ContentCollectionLink from '#components/content/content-collection-link.astro';
import ContentEntryDetail from '#components/content/content-entry-detail.astro';
import ContentProse from '#components/content/content-prose.astro';
import DividedItem from '#components/parts/divided-item.astro';
import RegionsBreadcrumbs from '#components/regions/regions-breadcrumbs.astro';
import RegionsDivision from '#components/regions/regions-division.astro';
import RegionsRelated from '#components/regions/regions-related.astro';
import SectionLinks from '#components/sections/section-links.astro';
import SectionMap from '#components/sections/section-map.astro';
import SectionPreviewList from '#components/sections/section-preview-list.astro';
import SectionPreviews from '#components/sections/section-previews.astro';
import SectionSources from '#components/sections/section-sources.astro';
import SectionStats from '#components/sections/section-stats.astro';
import SectionWebmentions from '#components/sections/section-webmentions.astro';
import { getAtlasPage } from '#lib/atlas/atlas-data.ts';
import { createRegionAncestorsFunction } from '#lib/collections/regions/regions-utils.ts';

interface Props {
	backlinksCount: number;
	catalogItems: Array<CatalogItem>;
	catalogItemsCount: number;
	entry: CollectionEntry<'regions'>;
	mapData: MapComponentData;
	page: Page<CatalogItem>;
	regionsOption?: RegionsOption;
}

const { backlinksCount, catalogItems, catalogItemsCount, entry, mapData, page, regionsOption } =
	Astro.props;

const getRegionAncestors = await createRegionAncestorsFunction();

const atlas = await getAtlasPage(entry, mapData);
---

<ContentEntryDetail
	atlas={atlas}
	breadcrumbRegions={getRegionAncestors(entry).slice(1).toReversed()}
	entry={entry}
>
	<Fragment slot="header-subtitle">
		<DividedItem>
			<ContentCollectionLink collection={entry.collection} />
		</DividedItem>
		{entry.data.parent ? (
			<DividedItem>
				<RegionsBreadcrumbs entry={entry} />
			</DividedItem>
		) : undefined}
	</Fragment>
	<ContentProse entry={entry} />
	<RegionsRelated entry={entry} limit={regionsOption?.termsRelatedLimit}>
		{regionsOption?.termsChildrenLabel ? (
			<Fragment slot="regions-children-title">{regionsOption.termsChildrenLabel}</Fragment>
		) : undefined}
		{regionsOption?.termsSiblingsLabel ? (
			<Fragment slot="regions-siblings-title">{regionsOption.termsSiblingsLabel}</Fragment>
		) : undefined}
	</RegionsRelated>
	<SectionMap
		class="atlas-inline-map"
		entryTitle={entry.data.title}
		mapData={mapData}
		showAtlasOpen={!!atlas}
	/>
	<SectionLinks entry={entry} />
	<SectionSources entry={entry} />
	<SectionWebmentions entry={entry} />
	<SectionPreviews page={page} showMicroformats={true} />
	{page.currentPage === 1 && catalogItems.length > 0 ? (
		<SectionPreviewList count={catalogItemsCount} items={catalogItems} />
	) : undefined}
	<SectionStats backlinksCount={backlinksCount} entryCount={entry.data._entryCount ?? 0} />
	<RegionsDivision entryId={entry.id} />
</ContentEntryDetail>
