---
import type { Page } from 'astro';
import type { CollectionEntry } from 'astro:content';

import Anchor from '#components/parts/anchor.astro';
import CollectionList from '#components/parts/collection-list.astro';
import ListColumnItem from '#components/parts/list-column-item.astro';
import ListColumn from '#components/parts/list-column.astro';
import { getContentPath } from '#lib/utils/routing.ts';
import { formatNumber } from '#lib/utils/text.ts';

interface Props {
	page: Page<CollectionEntry<'resources'>>;
}

const { page } = Astro.props;
---

<CollectionList collection="resources" page={page}>
	<ListColumn>
		{page.data.map((entry) => (
			<ListColumnItem>
				<Anchor href={getContentPath(entry.collection, entry.id)}>{entry.data.title}</Anchor>
				{entry.data._entryCount ? (
					<span
						class="text-sm text-gray-500"
						set:html={`(${formatNumber({ number: entry.data._entryCount })})`}
					/>
				) : undefined}
			</ListColumnItem>
		))}
	</ListColumn>
</CollectionList>
