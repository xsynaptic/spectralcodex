---
import { getMapPayloadUrl, mapPayloadName } from '@spectralcodex/map-codec';

import Document from '#components/main/main-document.astro';
import TextMultilingual from '#components/parts/text-multilingual.astro';
import { atlasPage } from '#lib/atlas/atlas-constants.ts';
import { getAtlasMapData } from '#lib/atlas/atlas-data.ts';
import { getTranslations } from '#lib/i18n/i18n-translations.ts';
import { LanguageCodeEnum } from '#lib/i18n/i18n-types.ts';
import { formatTitleMultilingual } from '#lib/i18n/i18n-utils.ts';
import { getSitePath } from '#lib/utils/routing.ts';
import { getSeoImageProps } from '#lib/utils/seo.ts';

const { props: atlasMapProps } = await getAtlasMapData();

const t = getTranslations();

const langCodeZh = LanguageCodeEnum.ChineseTraditional;

const titleMultilingual = { lang: langCodeZh, value: t('atlas.title', langCodeZh) };
---

<Document
	atlas={{ page: atlasPage.map }}
	meta={{
		description: t('atlas.description'),
		image: getSeoImageProps({ alt: t('atlas.title'), id: 'index-atlas' }),
		preloadUrls: atlasMapProps
			? [getMapPayloadUrl(atlasMapProps.payloadBase, mapPayloadName.directory)]
			: undefined,
		title: formatTitleMultilingual(t('atlas.title'), titleMultilingual),
	}}
>
	<main class="sr-only">
		<h1>
			{t('atlas.title')}
			<TextMultilingual content={titleMultilingual} parenthesis={true} />
		</h1>
		<p>{t('atlas.intro')}</p>
		<p lang={langCodeZh}>{t('atlas.intro', langCodeZh)}</p>
		<ul>
			<li>
				<a class="anchor-base anchor-accent" href={getSitePath('regions')}>
					{t('collection.regions.labelPlural')}
				</a>
			</li>
			<li>
				<a class="anchor-base anchor-accent" href={getSitePath('locations')}>
					{t('collection.locations.labelPlural')}
				</a>
			</li>
		</ul>
	</main>
	<noscript>
		<div class="z-divider fixed inset-0 grid place-content-center gap-2 bg-(--color-body-bg) p-4 text-center">
			<p>{t('atlas.noscript')}</p>
			<a class="anchor-base anchor-accent" href={getSitePath('regions')}>
				{t('collection.regions.labelPlural')}
			</a>
			<a class="anchor-base anchor-accent" href={getSitePath('locations')}>
				{t('collection.locations.labelPlural')}
			</a>
		</div>
	</noscript>
</Document>
