---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';

import RegionDetail from '#layouts/region-detail.astro';
import { getRegionsCollection } from '#lib/collections/regions/regions-data.ts';
import { createQueryRegionsEntryFunction } from '#lib/collections/regions/regions-utils.ts';

export const getStaticPaths = (async ({ paginate }) => {
	const { entries } = await getRegionsCollection();

	const queryRegionsEntry = await createQueryRegionsEntryFunction();

	const results = [];

	for (const entry of entries) {
		const {
			backlinksCount,
			catalogItems,
			catalogItemsCount,
			catalogItemsFiltered,
			mapData,
			regionsOption,
		} = queryRegionsEntry(entry);

		results.push(
			...paginate(catalogItemsFiltered, {
				pageSize: 20,
				params: { id: entry.id },
				props: {
					backlinksCount,
					catalogItems,
					catalogItemsCount,
					entry,
					mapData,
					regionsOption,
				},
			}),
		);
	}

	return results;
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
---

<RegionDetail {...Astro.props} />
