---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';

import ThemeDetail from '#layouts/theme-detail.astro';
import { getThemesCollection } from '#lib/collections/themes/themes-data.ts';
import { createQueryThemesEntryFunction } from '#lib/collections/themes/themes-utils.ts';

export const getStaticPaths = (async ({ paginate }) => {
	const { entries: themes } = await getThemesCollection();

	const queryThemesEntry = await createQueryThemesEntryFunction();

	const results = [];

	for (const entry of themes) {
		const {
			backlinksCount,
			catalogItems,
			catalogItemsCount,
			catalogItemsFiltered,
			mapData,
			relatedThemeIds,
		} = queryThemesEntry(entry);

		results.push(
			...paginate(catalogItemsFiltered, {
				pageSize: 20,
				params: { id: entry.id },
				props: {
					backlinksCount,
					catalogItems,
					catalogItemsCount,
					entry,
					mapData,
					relatedThemeIds,
				},
			}),
		);
	}
	return results;
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
---

<ThemeDetail {...Astro.props} />
