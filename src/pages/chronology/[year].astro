---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';

import ChronologyYearly from '#layouts/chronology-yearly.astro';
import { getChronologyData } from '#lib/collections/chronology/chronology-data.ts';

export const getStaticPaths = (async () => {
	const {
		chronologyDailyData,
		chronologyIndexData,
		chronologyMonthlyData,
		chronologyYearlyData,
		chronologyYears,
	} = await getChronologyData();

	function getEarliestMonthHighlights(year: string) {
		return chronologyMonthlyData
			.filter((month) => month.year === year)
			.toSorted((monthA, monthB) => monthA.month.localeCompare(monthB.month))
			.find((month) => month.highlights)?.highlights;
	}

	return Object.entries(chronologyYearlyData).map(([chronologyYear, chronologyYearMonths]) => ({
		params: { year: chronologyYear },
		props: {
			chronologyDailyData: chronologyDailyData[chronologyYear] ?? {},
			chronologyMonthlyData: chronologyYearMonths,
			chronologyYear,
			chronologyYearHighlights:
				chronologyIndexData[chronologyYear]?.highlights ??
				getEarliestMonthHighlights(chronologyYear),
			chronologyYears,
		},
	}));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
---

<ChronologyYearly {...Astro.props} />
