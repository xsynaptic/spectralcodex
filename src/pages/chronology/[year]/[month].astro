---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';

import ChronologyMonthly from '#layouts/chronology-monthly.astro';
import { getChronologyData } from '#lib/collections/chronology/chronology-data.ts';

export const getStaticPaths = (async () => {
	const { chronologyMonthlyData, chronologyMonths, chronologyYears } = await getChronologyData();

	return chronologyMonthlyData.map((chronologyMonthlyItem) => ({
		params: { month: chronologyMonthlyItem.month, year: chronologyMonthlyItem.year },
		props: {
			chronologyMonthlyItem,
			chronologyMonths: chronologyMonths[chronologyMonthlyItem.year],
			chronologyYears,
		},
	}));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
---

<ChronologyMonthly {...Astro.props} />
