---
import type { ComponentProps } from 'astro/types';

import { openGraphImageHeight, openGraphImageWidth } from '@spectralcodex/shared/constants';

import ChronologyActivity from '#components/chronology/chronology-activity.astro';
import ChronologyItem from '#components/chronology/chronology-item.astro';
import ChronologyNavigation from '#components/chronology/chronology-navigation.astro';
import ContentCollectionLink from '#components/content/content-collection-link.astro';
import ContentDate from '#components/content/content-date.astro';
import ContentExcerpt from '#components/content/content-excerpt.astro';
import ContentHeader from '#components/content/content-header.astro';
import ContentImage from '#components/content/content-image.astro';
import ContentSection from '#components/content/content-section.astro';
import ImageMetadata from '#components/image-metadata/image-metadata.astro';
import ImageCarousel from '#components/image/image-carousel.astro';
import ImageHero from '#components/image/image-hero.astro';
import ImagePlaceholder from '#components/image/image-placeholder.astro';
import LocationsAddress from '#components/locations/locations-address.astro';
import LocationsHeritageList from '#components/locations/locations-heritage-list.astro';
import LocationsNearbyList from '#components/locations/locations-nearby-list.astro';
import LocationsNotices from '#components/locations/locations-notices.astro';
import LocationsTable from '#components/locations/locations-table.astro';
import MainSite from '#components/main/main-site.astro';
import MapComponent from '#components/map/map-component.astro';
import ImgGroup from '#components/mdx/img-group.astro';
import Img from '#components/mdx/img.astro';
import ActivityGraph from '#components/parts/activity-graph.astro';
import AlertBox from '#components/parts/alert-box.astro';
import Anchor from '#components/parts/anchor.astro';
import AuthorCard from '#components/parts/author-card.astro';
import CardFrame from '#components/parts/card-frame.astro';
import CitationLine from '#components/parts/citation-line.astro';
import DateDisplay from '#components/parts/date-display.astro';
import DividedItem from '#components/parts/divided-item.astro';
import Grid from '#components/parts/grid.astro';
import Image from '#components/parts/image.astro';
import ListColumnItem from '#components/parts/list-column-item.astro';
import ListColumn from '#components/parts/list-column.astro';
import ListRow from '#components/parts/list-row.astro';
import PaginationCounter from '#components/parts/pagination-counter.astro';
import PaginationSelect from '#components/parts/pagination-select.astro';
import PreviewCard from '#components/parts/preview-card.astro';
import PreviewColumn from '#components/parts/preview-column.astro';
import PreviewGrid from '#components/parts/preview-grid.astro';
import PreviewList from '#components/parts/preview-list.astro';
import PreviewSubtitle from '#components/parts/preview-subtitle.astro';
import Prose from '#components/parts/prose.astro';
import TextMultilingual from '#components/parts/text-multilingual.astro';
import TextParenthesis from '#components/parts/text-parenthesis.astro';
import TextSeparated from '#components/parts/text-separated.astro';
import TextWash from '#components/parts/text-wash.astro';
import RegionsBreadcrumbs from '#components/regions/regions-breadcrumbs.astro';
import RegionsDivision from '#components/regions/regions-division.astro';
import RegionsList from '#components/regions/regions-list.astro';
import RegionsRelated from '#components/regions/regions-related.astro';
import ResourcesLinks from '#components/resources/resources-links.astro';
import ResourcesSources from '#components/resources/resources-sources.astro';
import SectionAuthor from '#components/sections/section-author.astro';
import SectionBacklinks from '#components/sections/section-backlinks.astro';
import SectionDateList from '#components/sections/section-date-list.astro';
import SectionPreviewList from '#components/sections/section-preview-list.astro';
import SectionPreviews from '#components/sections/section-previews.astro';
import SectionRegions from '#components/sections/section-regions.astro';
import SeriesSection from '#components/series/series-section.astro';
import ThemesList from '#components/themes/themes-list.astro';
import WebmentionsList from '#components/webmentions/webmentions-list.astro';
import {
	createSampleActivityValues,
	createSampleCatalogItems,
	createSampleDailyData,
	createSampleImageFeaturedGroup,
	createSampleImageProps,
	createSampleMapData,
	createSampleNotices,
	createSamplePage,
	getSampleDivisionRegionId,
	getSampleImages,
	getSampleLocations,
	getSampleNearbyLocations,
	getSampleOpenGraphCards,
	getSampleRelatedRegion,
	getSampleRegions,
	getSampleResources,
	getSampleThemes,
	sampleChronologyMonths,
	sampleChronologyYears,
	sampleLinkInline,
	samplePlaces,
	sampleCitation,
	sampleHeritage,
	sampleCitationMultilingual,
	sampleDate,
	sampleDateEnd,
	sampleDatesRecorded,
	sampleDateUpdated,
	sampleTitleChinese,
	sampleTitleChineseSimplified,
	sampleTitleJapanese,
	sampleTitleKorean,
	sampleTitleThai,
	sampleSourceInline,
	sampleTitleVietnamese,
	sampleUrl,
	sampleWebmentionCounts,
	sampleWebmentionReplies,
} from '#inventory/inventory-fixtures.ts';
import ProseSample from '#inventory/inventory-prose-sample.mdx';
import Section from '#inventory/inventory-section.astro';
import Specimen from '#inventory/inventory-specimen.astro';
import { getSectionId } from '#inventory/inventory-utils.ts';
import { getTranslations } from '#lib/i18n/i18n-translations.ts';
import { ImageContextEnum, ImageLayoutEnum } from '#lib/image/image-types.ts';
import { DatePresetEnum } from '#lib/utils/date.ts';
import { renderMarkdownInline } from '#lib/utils/text.ts';
import '#inventory/inventory.css';

const t = getTranslations();

const sampleImages = await getSampleImages();
const sampleRegions = await getSampleRegions();
const sampleRegionId = sampleRegions.deepest?.id;
const sampleRegionIds = sampleRegions.nested.map((entry) => entry.id);
const sampleDivisionRegionId = await getSampleDivisionRegionId();
const sampleLocations = await getSampleLocations();
const sampleNearbyLocations = await getSampleNearbyLocations();
const sampleRelatedRegion = await getSampleRelatedRegion();
const sampleThemes = await getSampleThemes();
const sampleResources = await getSampleResources();
const sampleMapData = await createSampleMapData();
const sampleOpenGraphCards = await getSampleOpenGraphCards();

const sampleImage = sampleImages.landscape[0]
	? { entry: sampleImages.landscape[0], ...createSampleImageProps(sampleImages.landscape[0]) }
	: undefined;
const sampleImageIds = sampleImages.landscape.map((entry) => entry.id);
const sampleImageFeaturedGroup = createSampleImageFeaturedGroup(sampleImages.landscape.slice(0, 3));

const sampleItems = createSampleCatalogItems({
	imageIds: sampleImageIds,
	regionId: sampleRegionId,
});
const sampleItem = sampleItems[0];

const samplePageFirst = createSamplePage({ items: sampleItems, currentPage: 1, lastPage: 1 });
const samplePageMiddle = createSamplePage({ items: sampleItems, currentPage: 3, lastPage: 12 });

const sampleYear = String(new Date().getUTCFullYear());
const sampleActivityValues = createSampleActivityValues(sampleYear);
const sampleDailyData = createSampleDailyData(sampleYear);
const sampleNotices = createSampleNotices();
const sampleChronologyYear = sampleChronologyYears.at(-1) ?? sampleYear;
const sampleChronologyMonth = sampleChronologyMonths[1];

const noMedia = 'The Images collection is empty, so nothing here can resolve a photograph.';

const noOpenGraphEntry = 'No Entry resolves an image, so there is no ground to draw on.';

const openGraphSpecimens = [
	{
		key: 'ground-dark',
		name: 'og-image',
		note: 'A Latin title over a dark ground: gradient fill on the title, white branding line, scrim at the foot.',
		missing: noOpenGraphEntry,
	},
	{
		key: 'ground-bright',
		name: 'og-image (bright ground)',
		note: 'The branding line flips to dark above a mean luminance of 190, sampled from the top of the frame. The titles read the foot of the frame against the same threshold, which a photograph rarely crosses.',
		missing: noOpenGraphEntry,
	},
	{
		key: 'title-long',
		name: 'og-image (long title)',
		note: 'A written title long enough to overrun both clamps: the Latin line holds at two, the multilingual line above it at one.',
		missing: noMedia,
	},
	{
		key: 'title-zh',
		name: 'og-image (Chinese title)',
		note: 'Noto Serif TC, and a <code>lang</code> of <code>zh-Hant</code> so Han unification resolves the right glyphs.',
		missing: noMedia,
	},
	{
		key: 'title-ja',
		name: 'og-image (Japanese title)',
		note: 'Zen Antique at its own weight and optical size. Only the first title present is drawn, so a card reaches this face only without a Chinese title above it.',
		missing: noMedia,
	},
	{
		key: 'title-th',
		name: 'og-image (Thai title)',
		note: 'Noto Serif Thai, set tighter than the CJK faces to fit its ascenders and tone marks.',
		missing: noMedia,
	},
	{
		key: 'image-fallback',
		name: 'og-image (fallback image)',
		note: 'An Entry with no Featured Image draws a stand-in photograph, blurred, picked by collection and Theme. The batch script also reads the Entry Region, which this section does not.',
		missing: 'No Entry falls back to a stand-in image.',
	},
];

const sections = [
	'Foundations',
	'Prose',
	'Text',
	'Parts',
	'Images',
	'Content',
	'Sections',
	'Domain',
	'Open Graph',
];

const colorRamps = [
	{ name: 'primary', source: 'zinc' },
	{ name: 'accent', source: 'calypso' },
	{ name: 'highlight', source: 'honey' },
	{ name: 'alternate', source: 'lima' },
];

const colorSteps = [50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950];

const typeSteps = ['xs', 'sm', 'base', 'lg', 'xl', '2xl', '3xl', '4xl', '5xl'];

const fontFamilies = [
	{ name: 'font-display', note: 'Geologica, 300 to 700; headings and card titles' },
	{ name: 'font-sans', note: 'Commissioner, 300 to 700; the body default' },
	{ name: 'font-serif', note: 'Lora, 300 to 700, normal and italic; prose and metadata lists' },
];

// Every script the content carries, so a font change can be judged against all of them at once
const scriptSamples = [
	{ label: 'Latin', lang: 'en', value: 'Sugar railway workshops, 1907' },
	{ label: 'Vietnamese', ...sampleTitleVietnamese },
	{ label: 'Chinese', ...sampleTitleChinese },
	{ label: 'Japanese', ...sampleTitleJapanese },
	{ label: 'Korean', ...sampleTitleKorean },
	{ label: 'Thai', ...sampleTitleThai },
];

const backgroundUtilities = [
	{ name: 'bg-fallback', note: 'Seigaiha pattern; stands in for a missing Image' },
	{ name: 'bg-placeholder', note: 'LQIP frame; pixelated, cover, centered' },
	{ name: 'bg-gradient-a', note: 'Fade from the top, over a hero' },
	{ name: 'bg-gradient-b', note: 'Fade from the bottom, under a caption' },
	{ name: 'bg-header-fade', note: 'Header scrim; swaps lightness in dark mode' },
];

type AnchorColor = NonNullable<ComponentProps<typeof Anchor>['anchorColor']>;

const anchorColorsOnLight = [
	'accent',
	'highlight',
	'primary',
	'title',
] satisfies Array<AnchorColor>;

const anchorColorOnDark = 'primary-bright' satisfies AnchorColor;

type WashColor = NonNullable<ComponentProps<typeof TextWash>['washColor']>;

const washColorsOnLight = ['primary', 'accent', 'highlight'] as const satisfies Array<WashColor>;

const washColorsOnDark = [
	'primary-bright',
	'accent-bright',
	'highlight-bright',
] as const satisfies Array<WashColor>;

// Both featured variants swap at sm, so they are shown on the ground they resolve to above it
const washColorsFeatured = [
	'primary-featured',
	'accent-featured',
] as const satisfies Array<WashColor>;

const datePresets = Object.values(DatePresetEnum);

type AlertStatus = NonNullable<ComponentProps<typeof AlertBox>['status']>;

const alertStatuses = [
	'default',
	'success',
	'notice',
	'warning',
	'error',
] as const satisfies Array<AlertStatus>;

type DividerContent = NonNullable<ComponentProps<typeof DividedItem>['dividerContent']>;

const dividerContents = ['slash', 'chevron', 'dot'] as const satisfies Array<DividerContent>;

const imageLayouts = Object.values(ImageLayoutEnum);

const captionClass = 'font-mono text-xs text-primary-500 dark:text-primary-400';

const cellClass = 'border-b border-primary-200 py-1.5 align-top dark:border-primary-700';
---

<MainSite meta={{ noIndex: true, title: 'Inventory' }}>
	<div class="pb-16">
		<div class="content-column pt-6">
			<h1 class="font-display text-2xl font-semibold text-primary-800 dark:text-primary-200">
				Inventory
			</h1>
			<p class="mt-2 max-w-prose text-sm text-primary-600 dark:text-primary-400">
				Every common component, rendered from its real source with fixture props. Dev only: neither
				the route nor a utility written here reaches a build.
			</p>
			<nav class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-sm">
				{sections.map((section) => <Anchor href={`#${getSectionId(section)}`}>{section}</Anchor>)}
			</nav>
		</div>
		<Section title="Foundations">
			<Specimen
				name="Color ramps"
				note="Each ramp aliases a named primitive; only <code>primary</code> comes from Tailwind."
				source="styles/main/parts/theme.css"
			>
				<div class="flex flex-col gap-5">
					{
						colorRamps.map((ramp) => (
							<div>
								<div class={captionClass}>
									--color-{ramp.name}-* <span class="text-primary-400">({ramp.source})</span>
								</div>
								<div class="mt-2 grid grid-cols-[repeat(auto-fit,minmax(3.5rem,1fr))] gap-1">
									{colorSteps.map((step) => (
										<div>
											<div
												class="h-12 rounded-xs border border-primary-300 dark:border-primary-700"
												style={`background-color: var(--color-${ramp.name}-${String(step)})`}
											/>
											<div class={`mt-1 ${captionClass}`}>{step}</div>
										</div>
									))}
								</div>
							</div>
						))
					}
				</div>
			</Specimen>
			<Specimen
				name="Type scale"
				note="Prose headings size in <code>em</code>, so they sit under Prose rather than here."
				source="styles/main/parts/theme.css"
			>
				<div class="flex flex-col gap-4">
					{
						typeSteps.map((step) => (
							<div class="border-t border-primary-200 pt-4 first:border-0 first:pt-0 dark:border-primary-700">
								<div class={captionClass}>text-{step}</div>
								<div style={`font-size: var(--text-${step})`}>
									The quick brown fox jumps over the lazy dog
								</div>
							</div>
						))
					}
				</div>
			</Specimen>
			<Specimen
				name="Font families"
				note="Latin and Vietnamese subsets only; CJK and Thai fall through to the platform stack."
				source="styles/main/parts/theme.css"
			>
				<div class="flex flex-col gap-6">
					{
						fontFamilies.map((family) => (
							<div class="border-t border-primary-200 pt-4 first:border-0 first:pt-0 dark:border-primary-700">
								<div class={captionClass}>
									{family.name}, {family.note}
								</div>
								<div class="mt-2 flex flex-col gap-1" style={`font-family: var(--${family.name})`}>
									<div style="font-size: var(--text-xl)">
										Spectral Codex 0123456789 <em>italic</em> <strong>bold</strong>
									</div>
									{scriptSamples.map((script) => (
										<div class="flex flex-wrap items-baseline gap-x-3">
											<span class={`w-24 shrink-0 ${captionClass}`}>{script.label}</span>
											<span lang={script.lang} style="font-size: var(--text-lg)">
												{script.value}
											</span>
										</div>
									))}
								</div>
							</div>
						))
					}
				</div>
			</Specimen>
			<Specimen name="Background utilities" source="styles/main/parts/utilities.css">
				<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
					{
						backgroundUtilities.map((utility) => (
							<div>
								<div
									class:list={[
										'h-24 rounded-xs border border-primary-300 dark:border-primary-700',
										utility.name,
									]}
								/>
								<div class={`mt-1 ${captionClass}`}>{utility.name}</div>
								<div class="text-xs text-primary-500 dark:text-primary-400">{utility.note}</div>
							</div>
						))
					}
				</div>
			</Specimen>
			<Specimen
				bleed={true}
				name="content-column / content-column-fill"
				note="<code>content-column-fill</code> drops the base padding below <code>sm</code>."
				source="styles/main/parts/utilities.css"
			>
				{
					/* No flex wrapper: `mx-auto` on a flex child shrink-wraps it, so neither box shows its width */
				}
				<div class="content-column">
					<div class="rounded-xs bg-accent-200 py-3 text-center text-sm dark:bg-accent-800">
						content-column
					</div>
				</div>
				<div class="content-column-fill mt-2">
					<div class="rounded-xs bg-highlight-200 py-3 text-center text-sm dark:bg-highlight-800">
						content-column-fill
					</div>
				</div>
			</Specimen>
		</Section>
		<Section title="Prose">
			<Specimen
				bleed={true}
				name="prose (default)"
				note="Rendered from MDX through the real satteri pipeline. Carries <code>data-reading-frame</code>, so the reading bar tracks this block."
				source="components/parts/prose.astro"
			>
				<Prose class="content-column" data-reading-frame>
					<ProseSample />
				</Prose>
			</Specimen>
			<Specimen
				name="prose (showCompact)"
				note="Descriptions, card summaries, Series blurbs."
				source="components/parts/prose.astro"
			>
				<Prose showCompact={true}>
					<p>
						A Description renders inline markdown only: <em>emphasis</em>, <strong>strong</strong>,
						and a <a href={sampleUrl}>link</a>. Block content is stripped before it reaches here.
					</p>
				</Prose>
			</Specimen>
			<Specimen
				bleed={true}
				name="prose (showBlocks)"
				note="Every direct child is pushed into <code>content-column</code>, so <code>prose-escape</code> breaks the measure."
				source="components/parts/prose.astro"
			>
				<Prose showBlocks={true}>
					<p>A paragraph inside a blocked prose surface, held to the measure.</p>
					<div
						class="prose-escape rounded-xs bg-accent-100 py-3 text-center text-sm dark:bg-accent-900"
					>
						A child marked <code>prose-escape</code>, reaching past it
					</div>
					<p>And the text picks the measure back up on the far side.</p>
				</Prose>
			</Specimen>
		</Section>
		<Section title="Text">
			<Specimen
				name="anchor"
				note="Tab through: every hover has its <code>focus-visible</code> twin."
				source="components/parts/anchor.astro"
			>
				<div class="flex flex-col gap-4">
					<div class="flex flex-wrap items-baseline gap-x-6 gap-y-3">
						{
							anchorColorsOnLight.map((anchorColor) => (
								<Anchor anchorColor={anchorColor} href={sampleUrl}>
									{anchorColor}
								</Anchor>
							))
						}
						<Anchor href={sampleUrl} isActive={true}>accent, isActive</Anchor>
					</div>
					<div class="rounded-xs bg-primary-800 px-5 py-4">
						<Anchor anchorColor={anchorColorOnDark} href={sampleUrl}>{anchorColorOnDark}</Anchor>
					</div>
					<div class="rounded-xs bg-primary-100 px-5 py-4">
						<Anchor href={sampleUrl} showDarkMode={false}>accent, showDarkMode false</Anchor>
					</div>
				</div>
			</Specimen>
			<Specimen
				name="text-wash"
				note="Bright variants want a dark ground; the featured pair swaps at <code>sm</code>."
				source="components/parts/text-wash.astro"
			>
				<div class="flex flex-col gap-4">
					<div class="flex flex-wrap items-baseline gap-x-6 gap-y-2">
						{
							washColorsOnLight.map((washColor) => (
								<TextWash class="text-2xl font-semibold" washColor={washColor}>
									{washColor}
								</TextWash>
							))
						}
					</div>
					<div
						class="flex flex-wrap items-baseline gap-x-6 gap-y-2 rounded-xs bg-primary-800 px-5 py-4"
					>
						{
							washColorsOnDark.map((washColor) => (
								<TextWash class="text-2xl font-semibold" washColor={washColor}>
									{washColor}
								</TextWash>
							))
						}
						{
							washColorsFeatured.map((washColor) => (
								<TextWash class="text-2xl font-semibold" washColor={washColor}>
									{washColor}
								</TextWash>
							))
						}
					</div>
				</div>
			</Specimen>
			<Specimen
				name="divided-item / list-row"
				note="The glyph is dropped on the last item."
				source="components/parts/"
			>
				<div class="flex flex-col gap-3">
					{
						dividerContents.map((dividerContent) => (
							<ListRow>
								<DividedItem as="li" dividerContent={dividerContent}>
									{dividerContent}
								</DividedItem>
								<DividedItem as="li" dividerContent={dividerContent}>
									divider
								</DividedItem>
								<DividedItem as="li" dividerContent={dividerContent}>
									glyph
								</DividedItem>
							</ListRow>
						))
					}
					<ListRow>
						<DividedItem as="li" dividerWeight="thin">Thin</DividedItem>
						<DividedItem as="li" dividerWeight="thin">divider</DividedItem>
						<DividedItem as="li" dividerWeight="thin">weight</DividedItem>
					</ListRow>
					<ListRow>
						<DividedItem as="li" dividerColor="lighter">Lighter</DividedItem>
						<DividedItem as="li" dividerColor="lighter">divider</DividedItem>
						<DividedItem as="li" dividerColor="lighter">color</DividedItem>
					</ListRow>
				</div>
			</Specimen>
			<Specimen
				name="list-column / list-column-item"
				note="Polymorphic over <code>ul</code> and <code>ol</code>; an empty item renders nothing."
				source="components/parts/"
			>
				<div class="flex flex-wrap items-start gap-x-12 gap-y-4 font-serif text-sm">
					<ListColumn>
						<ListColumnItem>An unordered item</ListColumnItem>
						<ListColumnItem>
							<Anchor href={sampleUrl}>A second item, carrying a link</Anchor>
						</ListColumnItem>
					</ListColumn>
					<ListColumn as="ol">
						<ListColumnItem>An ordered item</ListColumnItem>
						<ListColumnItem>A second item</ListColumnItem>
					</ListColumn>
				</div>
			</Specimen>
			<Specimen
				name="text-multilingual"
				note="CJK runs pick up <code>cjk-text</code>: pinned style, phrase-level line breaking."
				source="components/parts/text-multilingual.astro"
			>
				<div class="flex flex-col gap-2">
					<div>
						Taiwan Sugar Railway<TextMultilingual content={sampleTitleChinese} parenthesis={true} />
					</div>
					<div>
						<TextMultilingual
							content={sampleTitleChinese}
							additional={[sampleTitleChineseSimplified, sampleTitleJapanese]}
						/>
					</div>
					<div class="flex flex-wrap gap-x-6 gap-y-1">
						<TextMultilingual content={sampleTitleKorean} />
						<TextMultilingual content={sampleTitleThai} />
						<TextMultilingual content={sampleTitleVietnamese} />
					</div>
				</div>
			</Specimen>
			<Specimen
				name="text-parenthesis / text-separated"
				note="<code>text-parenthesis</code> renders nothing when its slot is empty."
				source="components/parts/"
			>
				<div class="flex flex-col gap-2">
					<div>Before <TextParenthesis>a parenthesised run</TextParenthesis> after</div>
					<div>
						{
							samplePlaces.map((place, index, places) => (
								<TextSeparated index={index} total={places.length}>
									{place}
								</TextSeparated>
							))
						}
					</div>
				</div>
			</Specimen>
			<Specimen
				name="date-display"
				note="Presets read from <code>DatePresetEnum</code>. A range collapses the repeated year."
				source="components/parts/date-display.astro"
			>
				<table class="w-full border-collapse text-sm">
					<thead>
