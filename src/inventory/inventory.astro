					<LocationsNotices notices={sampleNotices} />
				</div>
			</Specimen>
			<Specimen
				name="locations-nearby-list"
				note="A real Location's neighbours; distances come from the build-time pass, so nothing here is invented."
				source="components/locations/locations-nearby-list.astro"
			>
				{
					sampleNearbyLocations.length > 0 ? (
						<LocationsNearbyList locations={sampleNearbyLocations} />
					) : (
						<p class={captionClass}>No Location has a resolved neighbour to list.</p>
					)
				}
			</Specimen>
			<Specimen
				name="regions-breadcrumbs"
				note="The deepest Region's ancestor run. The current term is plain text unless <code>showCurrentLink</code> is set."
				source="components/regions/regions-breadcrumbs.astro"
			>
				{
					sampleRegions.deepest ? (
						<div class="flex flex-col gap-2">
							<RegionsBreadcrumbs entry={sampleRegions.deepest} />
							<RegionsBreadcrumbs entry={sampleRegions.deepest} showCurrentLink={true} />
						</div>
					) : (
						<p class={captionClass}>No nested Region, so there is no ancestor run to walk.</p>
					)
				}
			</Specimen>
			<Specimen
				bleed={true}
				name="regions-related"
				note="A column per relation, each heading an overridable slot; alternate titles appear below the second level."
				source="components/regions/regions-related.astro"
			>
				{
					sampleRelatedRegion ? (
						<RegionsRelated entry={sampleRelatedRegion} limit={6} />
					) : (
						<p class={captionClass}>No Region has both children and siblings.</p>
					)
				}
			</Specimen>
			<Specimen
				name="regions-division"
				note="The cached Division outline for a Region; decorative, so it sits behind content and is hidden from assistive tech."
				source="components/regions/regions-division.astro"
			>
				{
					sampleDivisionRegionId ? (
						<RegionsDivision entryId={sampleDivisionRegionId} />
					) : (
						<p class={captionClass}>
							No Division SVG in the cache, so there is no outline to draw.
						</p>
					)
				}
			</Specimen>
		</Section>
		<Section
			note="Cards are drawn by a batch script rather than by Astro; the route behind this section renders that same template on demand."
			title="Open Graph"
		>
			{
				openGraphSpecimens.map(({ key, name, note, missing }) => {
					const card = sampleOpenGraphCards.find((item) => item.key === key);

					return (
						<Specimen name={name} note={note} source="packages/scripts/src/og-image/element.tsx">
							{card ? (
								<img
									alt={card.entry.title}
									class="h-auto w-full rounded-xs"
									height={openGraphImageHeight}
									loading="lazy"
									src={`/inventory/og/${card.key}.jpg`}
									width={openGraphImageWidth}
								/>
							) : (
								<p class={captionClass}>{missing}</p>
							)}
						</Specimen>
					);
				})
			}
		</Section>
	</div>
</MainSite>
