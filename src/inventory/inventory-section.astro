---
interface Props {
	note?: string | undefined;
	title: string;
}

const { note, title } = Astro.props;

const id = title.toLowerCase();
---

<section class="mt-16 scroll-mt-8" id={id}>
	<div class="content-column">
		<h2
			class="flex items-center gap-3 font-display text-base font-semibold text-primary-800 dark:text-primary-200"
		>
			{title}
			<span aria-hidden="true" class="h-px flex-1 bg-primary-300 dark:bg-primary-700"></span>
		</h2>
		{
			note ? (
				<p class="mt-1 max-w-prose text-sm text-primary-500 dark:text-primary-400">{note}</p>
			) : undefined
		}
	</div>
	<slot />
</section>
