---
import DividedItem from '#components/parts/divided-item.astro';
import { backlinksDisplayCountMinimum } from '#constants.ts';
import { getTranslations } from '#lib/i18n/i18n-translations.ts';

interface Props {
	backlinksCount: number;
	entryCount: number;
}

const { backlinksCount, entryCount } = Astro.props;

const t = getTranslations();
---

{entryCount > 0 ? (
	<DividedItem class="hidden lg:inline-flex">
		{t.plural('content.meta.entries.label', entryCount)}
	</DividedItem>
) : undefined}
{backlinksCount >= backlinksDisplayCountMinimum ? (
	<DividedItem class="hidden lg:inline-flex">
		{t.plural('content.meta.backlinks.label', backlinksCount)}
	</DividedItem>
) : undefined}
