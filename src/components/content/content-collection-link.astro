---
import type { CatalogCollectionKey } from '#lib/catalog/catalog-types.ts';

import Anchor from '#components/parts/anchor.astro';
import { getTranslations } from '#lib/i18n/i18n-translations.ts';
import { getSitePath } from '#lib/utils/routing.ts';

interface Props {
	collection: CatalogCollectionKey;
}

const { collection, ...props } = Astro.props;

const collectionUrl = getSitePath(collection);

const t = getTranslations();
---

<Anchor anchorColor="highlight" class="font-semibold" href={collectionUrl} {...props}>
	{t(`collection.${collection}.labelPlural`)}
</Anchor>
