---
import type { HTMLAttributes } from 'astro/types';

import { stripTags } from '@xsynaptic/unified-tools';

import TextWash from '#components/parts/text-wash.astro';
import { renderSlot } from '#lib/utils/astro.ts';

interface Props extends HTMLAttributes<'div'> {
	hasHeroImage?: boolean | undefined;
}

const { class: className, hasHeroImage, ...props } = Astro.props;

const title = await renderSlot(Astro.slots, 'header-title');
const titleMultilingual = await renderSlot(Astro.slots, 'header-title-multilingual');
const subtitle = await renderSlot(Astro.slots, 'header-subtitle');
const caption = await renderSlot(Astro.slots, 'header-caption');

const titleMultilingualText = titleMultilingual ? stripTags(titleMultilingual).trim() : undefined;
const titleMultilingualMeta = titleMultilingualText
	? { 'data-pagefind-meta': `title_ml:${titleMultilingualText}` }
	: undefined;

const skipLinkTarget = hasHeroImage ? { id: 'main-content', tabindex: -1 } : undefined;

const titleCaption = hasHeroImage ? caption : undefined;
const subtitleCaption = hasHeroImage ? undefined : caption;
---

<div
	class:list={[
		'content-column',
		hasHeroImage
			? 'z-image-header flex flex-col justify-end pt-2 sm:absolute sm:right-0 sm:bottom-0 sm:left-0 sm:mb-0 sm:pt-0'
			: 'mb-2 pt-4',
		className,
	]}
	{...props}
>
	{titleMultilingual ? (
		<TextWash
			as="div"
			class:list={[
				'title-ml -ml-0.5 pb-1 text-base leading-snug font-medium',
				hasHeroImage
					? 'text-lg sm:-mb-1 sm:drop-shadow-xs md:text-xl lg:text-2xl'
					: 'text-lg md:text-xl lg:text-2xl',
			]}
			washColor={hasHeroImage ? 'accent-featured' : 'accent'}
			{...titleMultilingualMeta}
			data-pagefind-ignore
		>
			<Fragment set:html={titleMultilingual} />
		</TextWash>
	) : undefined}
	<div
		class:list={[
			'bg-clip-padding pb-0 sm:pb-2',
			titleCaption ? 'flex items-baseline-last justify-between gap-4' : undefined,
		]}
		{...skipLinkTarget}
	>
		<TextWash
			as="h1"
			class:list={[
				'-ml-0.5 pb-2 font-display text-2xl leading-[1.125] font-semibold',
				titleCaption ? 'flex-1' : undefined,
				hasHeroImage
					? '-mb-1 sm:-mb-3 sm:text-3xl sm:drop-shadow-sm md:text-4xl lg:text-5xl'
					: 'mb-0 sm:-mb-2 md:text-3xl lg:text-4xl',
			]}
			washColor={hasHeroImage ? 'primary-featured' : 'primary'}
		>
			{title ? <Fragment set:html={title} /> : undefined}
		</TextWash>
		{titleCaption ? (
			<div class="divided-hero contents text-sm">
				<Fragment set:html={titleCaption} />
			</div>
		) : undefined}
	</div>
	{subtitle || subtitleCaption ? (
		<div
			class:list={[
				'items-start gap-1 pb-2 text-sm sm:flex sm:flex-wrap',
				hasHeroImage
					? 'divided-hero text-primary-500 sm:text-primary-300 dark:text-primary-400 dark:sm:text-primary-300'
					: 'text-primary-500 dark:text-primary-400',
			]}
			data-pagefind-ignore
		>
			{subtitle ? (
				<div class="contents">
					<Fragment set:html={subtitle} />
				</div>
			) : undefined}
			{subtitleCaption ? (
				<div class="flex flex-1 flex-nowrap items-end justify-end gap-1">
					<Fragment set:html={subtitleCaption} />
				</div>
			) : undefined}
		</div>
	) : undefined}
</div>
