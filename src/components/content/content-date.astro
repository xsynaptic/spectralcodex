---
import DateDisplay from '#components/parts/date-display.astro';
import DividedItem from '#components/parts/divided-item.astro';
import { MicroformatClassNames } from '#components/types.ts';
import { getTranslations } from '#lib/i18n/i18n-translations.ts';

interface Props {
	dateCreated: Date;
	dateUpdated?: Date | undefined;
}

const { dateCreated, dateUpdated } = Astro.props;

const t = getTranslations();
---

<DividedItem>
	<DateDisplay class={MicroformatClassNames.DatePublished} date={dateCreated} />
</DividedItem>
{dateUpdated ? (
	<DividedItem>
		{t('content.meta.dateUpdated.label')}{' '}
		<DateDisplay class={MicroformatClassNames.DateUpdated} date={dateUpdated} />
	</DividedItem>
) : undefined}
