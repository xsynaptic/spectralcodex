---
import type { HTMLAttributes } from 'astro/types';

import { IMAGE_SERVER_SECRET, IMAGE_SERVER_URL } from 'astro:env/server';

import { imageLowQualityFormat, imageLowQualityValue } from '#constants.ts';
import { getImageByIdFunction } from '#lib/collections/images/images-utils.ts';
import { createImageUrlFunction } from '#lib/image/image-server.ts';
import { ImageFitOptionEnum } from '#lib/image/image-types.ts';

interface Props extends HTMLAttributes<'article'> {
	hideSearch?: boolean | undefined;
	imageId: string | undefined;
}

const { hideSearch, imageId, ...props } = Astro.props;

// Pagefind renders result thumbnails at 64×48 (4:3) via `--pf-image-width` / `--pf-image-height`
const searchThumbnailWidth = 64;
const searchThumbnailWidth2x = searchThumbnailWidth * 2;
const searchThumbnailAspectRatio = 4 / 3;

async function getThumbnailUrls() {
	if (!imageId) return;

	const getImageById = await getImageByIdFunction();
	const imageEntry = getImageById(imageId);

	if (!imageEntry) return;

	const getImageUrl = createImageUrlFunction({
		imageFormat: imageLowQualityFormat,
		imageQuality: imageLowQualityValue,
		serverSecret: IMAGE_SERVER_SECRET,
		serverUrl: IMAGE_SERVER_URL,
	});

	const fit = ImageFitOptionEnum.Cover;

	return {
		url1x: getImageUrl(imageId, {
			fit,
			height: Math.round(searchThumbnailWidth / searchThumbnailAspectRatio),
			width: searchThumbnailWidth,
		}),
		url2x: getImageUrl(imageId, {
			fit,
			height: Math.round(searchThumbnailWidth2x / searchThumbnailAspectRatio),
			width: searchThumbnailWidth2x,
		}),
	};
}

const thumbnails = await getThumbnailUrls();
---

<article {...props} {...(hideSearch ? {} : { 'data-pagefind-body': '' })}>
	<slot />
	{thumbnails ? (
		<>
			<meta content={thumbnails.url1x} data-pagefind-meta="image[content]" />
			<meta content={thumbnails.url2x} data-pagefind-meta="image_2x[content]" />
		</>
	) : (
		<meta content="" data-pagefind-meta="image[content]" />
	)}
</article>
