---
import type { HTMLAttributes } from 'astro/types';

import { getImagePresetWidths, imagePresets } from '@spectralcodex/shared/images';
import { getUrlPathIndexing } from '@spectralcodex/shared/indexing';

import { getImageByIdFunction, getImageSource } from '#lib/collections/images/images-data.ts';
import { createImageUrlFunction } from '#lib/image/image-url.ts';

interface Props extends HTMLAttributes<'article'> {
	imageId: string | undefined;
}

const { imageId, ...props } = Astro.props;

const { index } = getUrlPathIndexing(Astro.url.pathname);

// Pagefind renders result thumbnails at 64×48 (4:3) via `--pf-image-width` / `--pf-image-height`
const [searchThumbnailWidth, searchThumbnailWidth2x] = imagePresets.search.widths;

async function getThumbnailUrls() {
	if (!imageId) return;

	const getImageById = await getImageByIdFunction();
	const imageEntry = getImageById(imageId);

	if (!imageEntry) return;

	const imageSource = getImageSource(imageEntry);
	const widths = getImagePresetWidths('search', imageSource);

	if (!widths.includes(searchThumbnailWidth2x)) return;

	const getImageUrl = createImageUrlFunction({ imageSource, preset: 'search' });

	return {
		url1x: getImageUrl(searchThumbnailWidth),
		url2x: getImageUrl(searchThumbnailWidth2x),
	};
}

const thumbnails = await getThumbnailUrls();
---

<article {...props} {...(index ? { 'data-pagefind-body': '' } : {})}>
	<slot />
	{thumbnails ? (
		<>
			<meta content={thumbnails.url1x} data-pagefind-meta="image[content]" />
			<meta content={thumbnails.url2x} data-pagefind-meta="image_2x[content]" />
		</>
	) : (
		<meta content="" data-pagefind-meta="image[content]" />
	)}
</article>
