---
import { stripDiacritics } from '@spectralcodex/shared/text';

import { MicroformatClassNames } from '#components/types.ts';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<a
	class:list={[MicroformatClassNames.Name, MicroformatClassNames.Url]}
	href={Astro.url.toString()}
	rel="bookmark"
>
	{stripDiacritics(title)}
</a>
