---
import type { HTMLAttributes } from 'astro/types';
import type { CollectionEntry } from 'astro:content';

import ContentSection from '#components/content/content-section.astro';
import LocationsNearbyList from '#components/locations/locations-nearby-list.astro';
import { locationsNearbyCountLimit } from '#constants.ts';
import { getLocationsCollection } from '#lib/collections/locations/locations-data.ts';
import { getTranslations } from '#lib/i18n/i18n-translations.ts';
import { getMultilingualContent } from '#lib/i18n/i18n-utils.ts';
import { getContentUrl } from '#lib/utils/routing.ts';

interface Props extends HTMLAttributes<'div'> {
	entry: CollectionEntry<'locations'>;
	limit?: number | undefined;
}

const { entry, limit = locationsNearbyCountLimit, ...props } = Astro.props;

const { entriesMap: locationsMap } = await getLocationsCollection();

const locations = (entry.data._nearby?.slice(0, limit) ?? []).flatMap(
	({ locationId, distanceDisplay }) => {
		const location = locationsMap.get(locationId);

		if (!location) return [];

		return [
			{
				url: getContentUrl('locations', location.id),
				title: location.data.title,
				titleMultilingual: getMultilingualContent({ data: location.data, prop: 'title' })?.primary,
				distanceDisplay,
			},
		];
	},
);

const t = getTranslations();
---

<ContentSection
	sectionTitle={t('section.locationsNearby')}
	data-pagefind-ignore
	data-nosnippet
	{...props}
>
	<LocationsNearbyList locations={locations} />
</ContentSection>
