---
import type { HTMLAttributes } from 'astro/types';

import type { ComputedEntry } from '#lib/collections/collections-types.ts';

import ContentSection from '#components/content/content-section.astro';
import LocationsNearbyList from '#components/locations/locations-nearby-list.astro';
import { getLocationsNearbyList } from '#lib/collections/locations/locations-queries.ts';
import { getTranslations } from '#lib/i18n/i18n-translations.ts';

interface Props extends HTMLAttributes<'div'> {
	entry: ComputedEntry<'locations'>;
	showChinese?: boolean | undefined;
}

const { entry, showChinese, ...props } = Astro.props;

const locations = await getLocationsNearbyList(entry);

const t = getTranslations();
---

<ContentSection
	data-nosnippet
	data-pagefind-ignore
	sectionTitle={t('section.locationsNearby')}
	{...props}
>
	<LocationsNearbyList locations={locations} showChinese={showChinese} />
</ContentSection>
