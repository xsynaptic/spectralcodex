---
import type { NoticeBoxSeverity } from '#components/types.ts';

import NoticeBox from '#components/parts/notice-box.astro';
import { renderMarkdownInline } from '#lib/utils/text.ts';

interface Props {
	notices: Array<{ severity: NoticeBoxSeverity; text: string; textAlt: string | undefined }>;
}

const { notices } = Astro.props;
---

{notices.map(({ severity, text, textAlt }) => (
	<NoticeBox severity={severity}>
		<Fragment set:html={renderMarkdownInline(text)} />
		{textAlt ? <Fragment set:html={renderMarkdownInline(textAlt)} /> : undefined}
	</NoticeBox>
))}
