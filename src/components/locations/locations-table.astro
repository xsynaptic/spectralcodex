---
import type { CollectionEntry } from 'astro:content';

import * as R from 'remeda';

import Anchor from '#components/parts/anchor.astro';
import TextMultilingual from '#components/parts/text-multilingual.astro';
import { createFirstRegionByReferenceFunction } from '#lib/collections/regions/regions-utils.ts';
import { getMultilingualContent } from '#lib/i18n/i18n-utils.ts';
import { getPublicId } from '#lib/utils/collections.ts';
import { getContentUrl } from '#lib/utils/routing.ts';

interface Props {
	locations: Array<CollectionEntry<'locations'>>;
}

const { locations } = Astro.props;

const getFirstRegionByReference = await createFirstRegionByReferenceFunction();

const columns = {
	title: 'Title',
	region: 'Region',
	status: 'Status',
	precision: 'P',
} as const;
---

{
	locations.length > 0 ? (
		<div
			class:list={[
				'overflow-hidden rounded-md border',
				'border-primary-300 dark:border-primary-600',
			]}
		>
			<table class:list={['min-w-full table-auto', 'bg-primary-50 dark:bg-primary-900']}>
				<thead>
					<tr>
						{R.entries(columns).map(([id, title], index) => (
							<th
								id={`column-${id}`}
								class:list={[
									'border-b px-2 py-1 text-left align-text-top font-display text-sm font-medium uppercase',
									'border-primary-300 bg-primary-100 dark:border-primary-600 dark:bg-primary-600',
									index === 0 ? 'rounded-tl-lg' : undefined,
									index === Object.keys(columns).length - 1 ? 'rounded-tr-lg' : undefined,
								]}
								scope="col"
							>
								{title}
							</th>
						))}
					</tr>
				</thead>
				<tbody class:list={['divide-y', 'divide-primary-200 dark:divide-primary-700']}>
					{locations.map((entry) => {
						const region = getFirstRegionByReference(entry.data.regions);
						const titleMultilingual = getMultilingualContent({
							data: entry.data,
							prop: 'title',
						})?.primary;

						return (
							<tr class="font-sans text-sm">
								<td class="w-full px-2 py-1 align-text-top">
									<div class="flex flex-wrap items-center gap-1">
										<Anchor href={getContentUrl('locations', getPublicId(entry))}>
											{entry.data.title}
										</Anchor>
										{titleMultilingual ? (
											<TextMultilingual content={titleMultilingual} parenthesis={true} />
										) : undefined}
									</div>
								</td>
								<td class="px-2 py-1 align-text-top text-nowrap">
									{region ? (
										<Anchor href={getContentUrl('regions', region.id)}>{region.data.title}</Anchor>
									) : (
										'unknown'
									)}
								</td>
								<td class="px-2 py-1 align-text-top">{entry.data.status}</td>
								<td class="px-2 py-1 text-right align-text-top">{entry.data.precision}</td>
							</tr>
						);
					})}
				</tbody>
			</table>
		</div>
	) : undefined
}
