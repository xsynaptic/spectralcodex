---
import type { CollectionEntry } from 'astro:content';

import { getPublicId } from '@spectralcodex/shared/entries';

import Anchor from '#components/parts/anchor.astro';
import TextMultilingual from '#components/parts/text-multilingual.astro';
import { createFirstRegionByReferenceFunction } from '#lib/collections/regions/regions-data.ts';
import { getTranslations } from '#lib/i18n/i18n-translations.ts';
import { getMultilingualContent } from '#lib/i18n/i18n-utils.ts';
import { getContentPath } from '#lib/utils/routing.ts';

interface Props {
	locations: Array<CollectionEntry<'locations'>>;
}

interface Column {
	label: string;
	abbreviation?: string;
}

const { locations } = Astro.props;

const t = getTranslations();

const getFirstRegionByReference = await createFirstRegionByReferenceFunction();

const columns: Array<Column> = [
	{ label: 'Title' },
	{ label: 'Region' },
	{ label: 'Status' },
	{ label: 'Precision', abbreviation: 'P' },
];

const caption = t('collection.locations.labelPlural');

// Keyboard users need a tab stop to scroll a clipped table; the lint rule cannot see a scroll region
const scrollRegionProps = { role: 'region' as const, tabindex: 0, 'aria-label': caption };
---

{locations.length > 0 ? (
	<div
		class:list={['overflow-x-auto rounded-md border', 'border-primary-300 dark:border-primary-600']}
		{...scrollRegionProps}
	>
		<table class:list={['min-w-full table-auto', 'bg-primary-50 dark:bg-primary-900']}>
			<caption class="sr-only">{caption}</caption>
			<thead>
				<tr>
					{columns.map((column, index) => (
						<th
							class:list={[
								'border-b px-2 py-1 text-left align-text-top font-display text-sm font-medium uppercase',
								'border-primary-300 bg-primary-100 dark:border-primary-600 dark:bg-primary-600',
								index === 0 ? 'rounded-tl-lg' : undefined,
								index === columns.length - 1 ? 'rounded-tr-lg' : undefined,
							]}
							scope="col"
						>
							{column.abbreviation ? (
								<>
									<abbr class="no-underline" title={column.label} aria-hidden="true">
										{column.abbreviation}
									</abbr>
									<span class="sr-only">{column.label}</span>
								</>
							) : (
								column.label
							)}
						</th>
					))}
				</tr>
			</thead>
			<tbody class:list={['divide-y', 'divide-primary-200 dark:divide-primary-700']}>
				{locations.map((entry) => {
					const region = getFirstRegionByReference(entry.data.regions);
					const titleMultilingual = getMultilingualContent({
						data: entry.data,
						prop: 'title',
					})?.primary;

					return (
						<tr class="font-sans text-sm">
							<td class="w-full px-2 py-1 align-text-top">
								<div class="flex flex-wrap items-center gap-1">
									<Anchor href={getContentPath('locations', getPublicId(entry))}>
										{entry.data.title}
									</Anchor>
									{titleMultilingual ? (
										<TextMultilingual content={titleMultilingual} parenthesis={true} />
									) : undefined}
								</div>
							</td>
							<td class="px-2 py-1 align-text-top text-nowrap">
								{region ? (
									<Anchor href={getContentPath('regions', region.id)}>{region.data.title}</Anchor>
								) : (
									'unknown'
								)}
							</td>
							<td class="px-2 py-1 align-text-top">{entry.data.status}</td>
							<td class="px-2 py-1 text-right align-text-top">{entry.data.precision}</td>
						</tr>
					);
				})}
			</tbody>
		</table>
	</div>
) : undefined}
