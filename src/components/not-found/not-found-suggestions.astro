---
import { getTranslations } from '#lib/i18n/i18n-translations.ts';

const t = getTranslations();
---

<path-suggestions
	aria-live="polite"
	link-class="anchor-base anchor-accent"
	link-data-astro-history="replace"
	src="/content-manifest.json"
>
	<p class="suggestions-heading">{t('notFound.suggestions')}</p>
	<div aria-hidden="true" class="suggestions-loading text-primary-700 dark:text-highlight-400">
		<div class="loading-animation w-6"></div>
	</div>
</path-suggestions>

<script>
	import { navigate } from 'astro:transitions/client';
	import '@xsynaptic/path-suggestions/element';

	document.addEventListener('path-suggestions:redirect', (event) => {
		event.preventDefault();
		void navigate(event.detail.url, { history: 'replace' });
	});
</script>
