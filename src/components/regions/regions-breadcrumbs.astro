---
import type { CollectionEntry } from 'astro:content';

import Anchor from '#components/parts/anchor.astro';
import DividedItem from '#components/parts/divided-item.astro';
import ListRow from '#components/parts/list-row.astro';
import { createRegionAncestorsFunction } from '#lib/collections/regions/regions-utils.ts';
import { getTranslations } from '#lib/i18n/i18n-translations.ts';
import { getContentPath } from '#lib/utils/routing.ts';

interface Props {
	entry: CollectionEntry<'regions'>;
	showCurrentLink?: boolean;
}

const { entry, showCurrentLink = false, ...props } = Astro.props;

const getRegionAncestors = await createRegionAncestorsFunction();

const termAncestors = getRegionAncestors(entry).toReversed();

const t = getTranslations();
---

{termAncestors.length > 1 ? (
	<nav
		class="inline sm:flex"
		aria-label={t('site.breadcrumbs.label')}
		data-pagefind-ignore
		{...props}
	>
		<ListRow as="ol" class="text-sm">
			{termAncestors.map((termAncestor) => {
				const isCurrent = termAncestor.id === entry.id;

				return (
					<DividedItem as="li" dividerContent="chevron">
						{!showCurrentLink && isCurrent ? (
							<span aria-current="page">{termAncestor.data.title}</span>
						) : (
							<Anchor
								href={getContentPath('regions', termAncestor.id)}
								anchorColor="accent"
								{...(isCurrent ? { 'aria-current': 'page' as const } : undefined)}
							>
								{termAncestor.data.title}
							</Anchor>
						)}
					</DividedItem>
				);
			})}
		</ListRow>
	</nav>
) : undefined}
