---
import type { HTMLAttributes } from 'astro/types';
import type { CollectionEntry } from 'astro:content';

import { getRegionsDivisionSvgContent } from '#components/regions/regions-division.ts';

interface Props extends HTMLAttributes<'div'> {
	entry: CollectionEntry<'regions'>;
}

const { class: className, entry, ...props } = Astro.props;

const svgContent = await getRegionsDivisionSvgContent(entry);

// Note: `--division-stroke-color` and `--division-stroke-width` are available for styling
---

{svgContent ? (
	<div
		aria-hidden="true"
		class:list={[
			'pointer-events-none relative -z-1 mx-auto flex h-full max-h-75 max-w-48 opacity-60 select-none sm:max-w-60 md:max-w-72 dark:opacity-30',
			'text-primary-200 dark:text-primary-700',
			'[--division-stroke-color:var(--color-primary-300)] [--division-stroke-width:4] dark:[--division-stroke-color:var(--color-primary-500)]',
			className,
		]}
		{...props}
	>
		<Fragment set:html={svgContent} />
	</div>
) : undefined}
