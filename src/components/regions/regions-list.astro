---
import type { CollectionEntry } from 'astro:content';

import type { DividerContent } from '#components/types.ts';

import Anchor from '#components/parts/anchor.astro';
import DividedItem from '#components/parts/divided-item.astro';
import ListRow from '#components/parts/list-row.astro';
import TextMultilingual from '#components/parts/text-multilingual.astro';
import { MicroformatClassNames } from '#components/types.ts';
import { createRegionAncestorsFunction } from '#lib/collections/regions/regions-utils.ts';
import { getMultilingualContent } from '#lib/i18n/i18n-utils.ts';
import { getContentUrl } from '#lib/utils/routing.ts';

interface Props {
	terms: Array<CollectionEntry<'regions'>> | undefined;
	dividerContent?: DividerContent;
	showMicroformats?: boolean;
	showSingleRegionAncestors?: boolean;
	showTitleMultilingual?: boolean;
}

const {
	terms,
	dividerContent = 'dot',
	showMicroformats = false,
	showSingleRegionAncestors,
	showTitleMultilingual = true,
} = Astro.props;

// Optionally expand the list of regions to include ancestors
async function getRegions() {
	const getRegionAncestors = await createRegionAncestorsFunction();

	const ancestors = terms?.length === 1 && terms[0] ? getRegionAncestors(terms[0]) : undefined;

	return ancestors ?? terms;
}

const regions = showSingleRegionAncestors ? await getRegions() : terms;
---

{
	regions && regions.length > 0 ? (
		<ListRow class="font-serif text-sm">
			{regions.map((entry) => {
				const titleMultilingual = showTitleMultilingual
					? getMultilingualContent({ data: entry.data, prop: 'title' })?.primary
					: undefined;

				return (
					<DividedItem
						as="li"
						dividerContent={dividerContent}
						class:list={[showMicroformats ? MicroformatClassNames.Category : undefined]}
						data-pagefind-filter="region"
					>
						{entry.data.title ? (
							<Anchor href={getContentUrl(entry.collection, entry.id)}>
								<Fragment set:html={entry.data.title} />
							</Anchor>
						) : undefined}
						{titleMultilingual ? (
							<TextMultilingual
								content={titleMultilingual}
								class="text-primary-600 dark:text-primary-400"
								parenthesis={true}
							/>
						) : undefined}
					</DividedItem>
				);
			})}
		</ListRow>
	) : undefined
}
