---
import { getTranslations } from '#lib/i18n/i18n-translations.ts';

const t = getTranslations();
---

<button
	aria-label={t('carousel.nav.previous')}
	class:list={['carousel-nav carousel-nav-prev z-image-navigation']}
	data-carousel-nav="prev"
	type="button"
>
	<svg
		aria-hidden="true"
		height="24"
		viewBox="0 0 24 24"
		width="24"
		xmlns="http://www.w3.org/2000/svg"
	>
		<path
			d="m15 18l-6-6l6-6"
			fill="none"
			stroke="currentColor"
			stroke-linecap="round"
			stroke-linejoin="round"
			stroke-width="3"
		></path>
	</svg>
</button>
<button
	aria-label={t('carousel.nav.next')}
	class:list={['carousel-nav carousel-nav-next z-image-navigation']}
	data-carousel-nav="next"
	type="button"
>
	<svg
		aria-hidden="true"
		height="24"
		viewBox="0 0 24 24"
		width="24"
		xmlns="http://www.w3.org/2000/svg"
	>
		<path
			d="m9 18l6-6l-6-6"
			fill="none"
			stroke="currentColor"
			stroke-linecap="round"
			stroke-linejoin="round"
			stroke-width="3"
		></path>
	</svg>
</button>

<script>
	import '#components/image/image-carousel.ts';
</script>
