---
import type { ImageFeaturedWithCaption } from '#lib/catalog/catalog-types.ts';

import ImageCarouselCaption from '#components/image/image-carousel-caption.astro';
import ImagePlaceholder from '#components/image/image-placeholder.astro';
import Image from '#components/parts/image.astro';
import { imageHighQualityFormat, imageHighQualityValue } from '#constants.ts';
import { getImageFeaturedProps } from '#lib/image/image-featured-props.ts';
import { getImageLayoutSizesProp } from '#lib/image/image-layout.ts';
import { ImageLayoutEnum, ImageSizeEnum } from '#lib/image/image-types.ts';

type Props = ImageFeaturedWithCaption;

const { id: imageId, title: alt = '', caption } = Astro.props;

const { imageProps, placeholderProps } = await getImageFeaturedProps({
	imageId,
	alt,
	widths: [
		ImageSizeEnum.ExtraSmall,
		ImageSizeEnum.Small,
		ImageSizeEnum.Medium,
		ImageSizeEnum.Large,
		ImageSizeEnum.ExtraLarge,
	],
	sizes: getImageLayoutSizesProp(ImageLayoutEnum.Default),
	width: ImageSizeEnum.Large,
	imageQuality: imageHighQualityValue,
	imageFormat: imageHighQualityFormat,
});
---

{imageProps ? (
	<ImagePlaceholder as="figure" class="carousel-item relative" placeholderProps={placeholderProps}>
		<Image class:list={['m-0 aspect-3/2 text-sm text-transparent']} {...imageProps} />
		{caption ? (
			<ImageCarouselCaption caption={caption} isHero={false} withTitle={false} />
		) : undefined}
	</ImagePlaceholder>
) : undefined}
