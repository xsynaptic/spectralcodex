---
import type { HTMLTag, Polymorphic } from 'astro/types';

import { getPlaceholder } from '@xsynaptic/astro-image-pipeline/node';

import type { ImagePlaceholderProps } from '#lib/image/image-types.ts';

import { getImageByIdFunction, getImageSource } from '#lib/collections/images/images-data.ts';

// A standardized image placeholder component with a fallback image when no placeholder is passed
type Props<Tag extends HTMLTag = HTMLTag> = Polymorphic<{
	as: Tag;
	placeholderProps?: ImagePlaceholderProps | undefined;
}>;

const { as: Tag = 'div', class: className, placeholderProps, ...props } = Astro.props;

const getImageById = await getImageByIdFunction();

async function getPlaceholderUrl() {
	if (!placeholderProps) return;

	const imageEntry = getImageById(placeholderProps.imageId);

	if (!imageEntry) return;

	return getPlaceholder(getImageSource(imageEntry), placeholderProps.request);
}

const placeholder = await getPlaceholderUrl();
---

<Tag
	class:list={['image-placeholder', placeholder ? 'bg-placeholder' : 'bg-fallback', className]}
	style={placeholder ? `background-image: url(${placeholder});` : undefined}
	{...props}
>
	<slot />
</Tag>
