---
import { ImageSizeEnum } from '@spectralcodex/shared/images';

import type { ImageFeaturedWithCaption } from '#lib/catalog/catalog-types.ts';

import ImageCarouselCaption from '#components/image/image-carousel-caption.astro';
import ImagePlaceholder from '#components/image/image-placeholder.astro';
import Image from '#components/parts/image.astro';
import { MicroformatClassNames } from '#components/types.ts';
import { getImageFeaturedProps } from '#lib/image/image-featured-props.ts';

interface Props extends ImageFeaturedWithCaption {
	alt: string;
	class?: string | undefined;
	index: number;
	showMicroformats?: boolean | undefined;
	withTitle?: boolean | undefined;
}

const {
	alt,
	caption,
	class: className,
	id: imageId,
	index,
	showMicroformats = false,
	withTitle = false,
} = Astro.props;

const { imageProps, placeholderProps } = await getImageFeaturedProps({
	alt,
	imageId,
	preset: 'hero',
	priority: index === 0,
	sizes: '100vw',
	width: ImageSizeEnum.ExtraExtraLarge,
});
---

{imageProps ? (
	<ImagePlaceholder
		as="figure"
		class:list={['relative', className]}
		placeholderProps={placeholderProps}
	>
		<Image
			class:list={[
				'z-image max-h-screen min-h-100 w-full text-sm text-transparent xl:min-h-screen',
				'aspect-3/2 lg:aspect-video xl:aspect-auto',
				showMicroformats ? MicroformatClassNames.Photo : undefined,
			]}
			data-hero-image
			{...imageProps}
		/>
		{caption ? (
			<ImageCarouselCaption caption={caption} isHero={true} withTitle={withTitle} />
		) : undefined}
	</ImagePlaceholder>
) : undefined}
