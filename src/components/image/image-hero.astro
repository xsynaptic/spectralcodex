---
import type { HTMLAttributes } from 'astro/types';

import type { ImageFeaturedWithCaption } from '#lib/catalog/catalog-types.ts';

import ImageCarouselNavigation from '#components/image/image-carousel-navigation.astro';
import ImageHeroCarouselItem from '#components/image/image-hero-carousel-item.astro';
import { getTranslations } from '#lib/i18n/i18n-translations.ts';
import { formatStringTemplate } from '#lib/utils/text.ts';

interface Props extends HTMLAttributes<'div'> {
	imageFeaturedGroup?: Array<ImageFeaturedWithCaption> | undefined;
	alt: string;
	showMicroformats?: boolean | undefined;
	withTitle?: boolean | undefined;
}

const {
	imageFeaturedGroup,
	alt,
	showMicroformats = false,
	withTitle = true,
	class: className,
	...props
} = Astro.props;

const t = getTranslations();

const hasHeroImage = !!imageFeaturedGroup && imageFeaturedGroup.length > 0;
const hasHeroCarousel = !!imageFeaturedGroup && imageFeaturedGroup.length > 1;
---

{hasHeroImage ? (
	<div
		class:list={[
			'sm:relative',
			'dark:sm-bg-primary-300 sm:bg-primary-300',
			hasHeroCarousel ? 'carousel-group' : 'overflow-hidden',
			className,
		]}
		{...props}
	>
		<div
			class:list={[
				'pointer-events-none top-0 right-0 left-0 z-image-shadow block h-0 w-full text-transparent select-none sm:absolute sm:h-image-shadow-sm md:h-image-shadow-md lg:h-image-shadow-lg',
				'sm:bg-gradient-a',
			]}
		/>
		{hasHeroCarousel ? (
			<image-carousel
				class="block"
				role="group"
				aria-roledescription={t('carousel.roledescription')}
				aria-label={formatStringTemplate(t('carousel.label'), { title: alt })}
				data-slide-label={t('carousel.slide.label')}
				data-slide-roledescription={t('carousel.slide.roledescription')}
			>
				<div class="carousel-container">
					{imageFeaturedGroup.map((heroImage, index) => (
						<ImageHeroCarouselItem
							{...heroImage}
							class="carousel-item"
							index={index}
							alt={alt}
							showMicroformats={showMicroformats}
							withTitle={withTitle}
						/>
					))}
				</div>
				<ImageCarouselNavigation />
			</image-carousel>
		) : undefined}
		{!hasHeroCarousel && imageFeaturedGroup[0] ? (
			<ImageHeroCarouselItem
				{...imageFeaturedGroup[0]}
				index={0}
				alt={alt}
				showMicroformats={showMicroformats}
				withTitle={withTitle}
			/>
		) : undefined}
		<slot />
		<div
			class:list={[
				'pointer-events-none right-0 bottom-0 left-0 z-image-shadow block h-0 w-full select-none sm:absolute',
				withTitle
					? 'sm:min-h-image-shadow-md md:h-image-shadow-lg lg:h-image-shadow-xl'
					: 'sm:min-h-image-gradient',
				'sm:bg-gradient-b',
			]}
		/>
	</div>
) : (
	<slot />
)}
