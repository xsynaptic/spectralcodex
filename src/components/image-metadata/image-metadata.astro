---
import type { HTMLAttributes } from 'astro/types';
import type { CollectionEntry } from 'astro:content';

import { IMAGE_SERVER_SECRET, IMAGE_SERVER_URL } from 'astro:env/server';

import ImageMetadataItem from '#components/image-metadata/image-metadata-item.astro';
import DateDisplay from '#components/parts/date-display.astro';
import {
	imageDownloadWidthMax,
	imageHighQualityFormat,
	imageHighQualityValue,
} from '#constants.ts';
import { getTranslations } from '#lib/i18n/i18n-translations.ts';
import { getImageBreakpoints } from '#lib/image/image-layout.ts';
import { createImageUrlFunction } from '#lib/image/image-server.ts';
import { DatePresetEnum } from '#lib/utils/date.ts';
import { formatStringTemplate } from '#lib/utils/text.ts';

interface Props extends HTMLAttributes<'div'> {
	entry: CollectionEntry<'images'>;
}

const { entry, ...props } = Astro.props;

const t = getTranslations();

// Mirrors the srcset params in `content-image.astro` so the link hits an existing render and cache entry
const downloadBreakpoints = getImageBreakpoints({
	maxWidth: Math.min(entry.data.width, imageDownloadWidthMax),
});
const downloadWidth = downloadBreakpoints.length > 0 ? Math.max(...downloadBreakpoints) : undefined;
const downloadHeight = downloadWidth
	? Math.round((downloadWidth * entry.data.height) / entry.data.width)
	: undefined;

const getImageUrl = createImageUrlFunction({
	imageFormat: imageHighQualityFormat,
	imageQuality: imageHighQualityValue,
	serverSecret: IMAGE_SERVER_SECRET,
	serverUrl: IMAGE_SERVER_URL,
});
const downloadUrl = downloadWidth ? getImageUrl(entry.id, { width: downloadWidth }) : undefined;
---

<div class="meta-overlay" data-pagefind-ignore {...props}>
	<details class="meta-details">
		<summary
			aria-label={
				entry.data.title
					? formatStringTemplate(t('collection.images.metadata.label'), { title: entry.data.title })
					: t('collection.images.metadata.title')
			}
			class="meta-show"
			data-umami-event="image-metadata-open"
			data-umami-event-image={entry.id}
		>
			<span class="meta-show-icon">
				<svg aria-hidden="true" class="meta-svg" height="24" viewBox="0 0 24 24" width="24">
					<use href="#icon:eye-open"></use>
				</svg>
			</span>
			<span class="meta-close-icon">
				<svg aria-hidden="true" class="meta-svg" height="24" viewBox="0 0 24 24" width="24">
					<use href="#icon:eye-closed"></use>
				</svg>
			</span>
		</summary>
		<div class="meta-panel">
			<dl class="meta-grid">
				<ImageMetadataItem class="meta-span-4">
					<Fragment slot="image-metadata-item-title">
						{t('collection.images.metadata.dateCreated.label')}
					</Fragment>
					{entry.data.dateCreated ? (
						<DateDisplay date={entry.data.dateCreated} datePreset={DatePresetEnum.Long} />
					) : undefined}
				</ImageMetadataItem>
				<ImageMetadataItem class="meta-span-4">
					<Fragment slot="image-metadata-item-title">
						{t('collection.images.metadata.cameraModel.label')}
					</Fragment>
					{entry.data.camera}
				</ImageMetadataItem>
				<ImageMetadataItem class="meta-span-4">
					<Fragment slot="image-metadata-item-title">
						{t('collection.images.metadata.lensModel.label')}
					</Fragment>
					{entry.data.lens}
				</ImageMetadataItem>
				<ImageMetadataItem class="meta-span-2">
					<Fragment slot="image-metadata-item-title">
						{t('collection.images.metadata.aperture.label')}
					</Fragment>
					{entry.data.aperture ? (
						<>
							<em>&#402;</em>&#8202;/&#8202;{entry.data.aperture}
						</>
					) : undefined}
				</ImageMetadataItem>
				<ImageMetadataItem class="meta-span-2">
					<Fragment slot="image-metadata-item-title">
						{t('collection.images.metadata.shutterSpeed.label')}
					</Fragment>
					{entry.data.shutterSpeed ? `${entry.data.shutterSpeed} sec` : undefined}
				</ImageMetadataItem>
				<ImageMetadataItem class="meta-span-2">
					<Fragment slot="image-metadata-item-title">
						{t('collection.images.metadata.focalLength.label')}
					</Fragment>
					{entry.data.focalLength}
				</ImageMetadataItem>
				<ImageMetadataItem class="meta-span-2">
					<Fragment slot="image-metadata-item-title">
						{t('collection.images.metadata.iso.label')}
					</Fragment>
					{entry.data.iso}
				</ImageMetadataItem>
				<ImageMetadataItem class="meta-span-2">
					<Fragment slot="image-metadata-item-title">
						{t('collection.images.metadata.exposureValue.label')}
					</Fragment>
					{entry.data.exposureValue ? (
						<>
							{Number(entry.data.exposureValue).toFixed(1)}&nbsp;
							{t('collection.images.metadata.ev.label')}
						</>
					) : undefined}
				</ImageMetadataItem>
				<ImageMetadataItem class="meta-span-2">
					<Fragment slot="image-metadata-item-title">
						{t('collection.images.metadata.download.label')}
					</Fragment>
					{downloadUrl && downloadHeight ? (
						<a
							class="anchor-plain"
							data-umami-event="image-download"
							data-umami-event-image={entry.id}
							href={downloadUrl}
						>
							<Fragment
								set:html={`${String(downloadWidth)}&#8202;&#215;&#8202;${String(downloadHeight)}`}
							/>
						</a>
					) : undefined}
				</ImageMetadataItem>
			</dl>
		</div>
	</details>
</div>
