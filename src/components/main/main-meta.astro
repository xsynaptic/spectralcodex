---
import { openGraphImageHeight, openGraphImageWidth } from '@spectralcodex/shared/constants';
import { SEO } from 'astro-seo';

import type { MetaProps } from '#components/types.ts';

import { openGraphTwitterUsername } from '#constants.ts';
import { getTranslations } from '#lib/i18n/i18n-translations.ts';
import { sanitizeImageAltAttribute } from '#lib/utils/text.ts';

type Props = MetaProps;

const {
	title: contentTitle,
	description: contentDescription,
	ogType,
	image,
	imageAlt,
	article,
	prefetchUrls,
	noIndex,
	noFollow,
} = Astro.props;

const t = getTranslations();

const siteTitle = t('site.title');
const siteDescription = t('site.description');

const description = contentDescription ?? siteDescription;

const titleDisplay =
	contentTitle && contentTitle !== siteTitle ? `${contentTitle} - ${siteTitle}` : siteTitle;

const openGraphImage = image?.url
	? {
			url: new URL(image.url, Astro.site).href,
			height: openGraphImageHeight,
			width: openGraphImageWidth,
			alt: sanitizeImageAltAttribute(image.alt ?? imageAlt ?? description),
		}
	: undefined;

// A card is what makes these tags worth emitting; the pages without one are `noindex`
const socialProps = openGraphImage
	? {
			openGraph: {
				basic: {
					title: titleDisplay,
					type: ogType ?? 'website',
					image: openGraphImage.url,
				},
				optional: {
					description,
					locale: 'en_US',
					siteName: siteTitle,
				},
				image: openGraphImage,
				...(ogType === 'article' && article !== undefined ? { article } : {}),
			},
			twitter: {
				card: 'summary_large_image' as const,
				site: openGraphTwitterUsername,
				title: contentTitle ?? siteTitle,
				description,
				image: openGraphImage.url,
				imageAlt: openGraphImage.alt,
			},
		}
	: {};
---

<SEO
	title={titleDisplay}
	description={description}
	{...socialProps}
	extend={{
		...(prefetchUrls?.length
			? {
					link: prefetchUrls.map((prefetchUrl) => ({ rel: 'prefetch', href: prefetchUrl })),
				}
			: {}),
		meta: [{ name: 'generator', content: Astro.generator }],
	}}
	noindex={noIndex ?? false}
	nofollow={noFollow ?? false}
	robotsExtras="max-snippet:-1, max-image-preview:large, max-video-preview:-1"
/>
