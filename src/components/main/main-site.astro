---
import type { MetaProps } from '#components/types.ts';
import type { AtlasPageProps } from '#lib/atlas/atlas-data.ts';
import type { Thing } from '#lib/utils/seo-structured-data.ts';

import AtlasSheetHandle from '#components/atlas/atlas-sheet-handle.astro';
import Colophon from '#components/main/main-colophon.astro';
import Document from '#components/main/main-document.astro';
import Header from '#components/main/main-header.astro';
import TopButton from '#components/main/main-top-button.astro';
import NavigationFooter from '#components/navigation/navigation-footer.astro';

interface Props {
	atlas?: AtlasPageProps | undefined;
	hasHeroImage?: boolean;
	isHomepage?: boolean;
	meta?: MetaProps;
	schemas?: Array<Thing>;
}

const { atlas, hasHeroImage = false, isHomepage = false, meta, schemas } = Astro.props;

// Avoid using `position: fixed` anywhere in the sheet; the pane must be the containing block for Atlas
---

<Document atlas={atlas} meta={meta} schemas={schemas}>
	<div class="main-pane @container/pane flex min-h-screen flex-col" tabindex="-1">
		{atlas ? <AtlasSheetHandle /> : undefined}
		<Header hasHeroImage={hasHeroImage} isHomepage={isHomepage} />
		<main class="flex-1" {...(hasHeroImage ? {} : { id: 'main-content', tabindex: -1 })}>
			<slot />
		</main>
		<footer class="content-column mt-8 mb-4 w-full pt-4 sm:mb-8">
			<div
				class:list={[
					'border-t pt-4 pb-4 sm:pb-8',
					'border-primary-200 text-primary-400 dark:border-primary-700 dark:text-primary-700',
				]}
			>
				<NavigationFooter />
				<Colophon />
			</div>
		</footer>
	</div>
	<TopButton />
</Document>
