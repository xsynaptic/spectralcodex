---
import { Font } from 'astro:assets';
import { UMAMI_DOMAIN, UMAMI_ID, WEBMENTION_DOMAIN } from 'astro:env/client';

import '#styles/main.css';
import { IMAGE_SERVER_URL } from 'astro:env/server';
import { ClientRouter } from 'astro:transitions';

import type { MetaProps } from '#components/types.ts';
import type { Thing } from '#lib/utils/seo-structured-data.ts';

import Analytics from '#components/main/main-analytics.astro';
import Colophon from '#components/main/main-colophon.astro';
import Meta from '#components/main/main-meta.astro';
import SkipLink from '#components/main/main-skip-link.astro';
import Sprites from '#components/main/main-sprites.astro';
import Stylesheet from '#components/main/main-stylesheet.astro';
import TopButton from '#components/main/main-top-button.astro';
import ModeManagerSetup from '#components/mode-manager/mode-manager-setup.astro';
import ModeManager from '#components/mode-manager/mode-manager.astro';
import ModeToggle from '#components/mode-manager/mode-toggle.astro';
import NavigationFooter from '#components/navigation/navigation-footer.astro';
import NavigationHeader from '#components/navigation/navigation-header.astro';
import Anchor from '#components/parts/anchor.astro';
import ProgressLoading from '#components/progress/progress-loading.astro';
import ProgressReading from '#components/progress/progress-reading.astro';
import Search from '#components/search/search.astro';
import { getTranslations } from '#lib/i18n/i18n-translations.ts';
import { getBasePath, getSitePath } from '#lib/utils/routing.ts';
import { serializeGraph } from '#lib/utils/seo-structured-data.ts';

interface Props {
	hasHeroImage?: boolean;
	isHomepage?: boolean;
	meta?: MetaProps;
	schemas?: Array<Thing>;
}

const { hasHeroImage = false, isHomepage = false, meta, schemas } = Astro.props;

const siteUrl = getSitePath();

const t = getTranslations();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta content="width=device-width,initial-scale=1" name="viewport" />
		<meta content="light dark" name="color-scheme" />
		<meta content="#f4f4f5" name="theme-color" />
		<link
			href={getBasePath('favicon.svg')}
			media="(prefers-color-scheme: light)"
			rel="icon"
			type="image/svg+xml"
		/>
		<link
			href={getBasePath('favicon.svg')}
			media="(prefers-color-scheme: dark)"
			rel="icon"
			type="image/svg+xml"
		/>
		{IMAGE_SERVER_URL.startsWith('http') ? (
			<link crossorigin href={IMAGE_SERVER_URL} rel="preconnect" />
		) : undefined}
		<Stylesheet />
		<Font cssVariable="--font-commissioner" preload={[{ subset: 'latin' }]} />
		<Font cssVariable="--font-geologica" preload={[{ subset: 'latin' }]} />
		<Font cssVariable="--font-lora" preload={[{ style: 'normal', subset: 'latin' }]} />
		<ModeManagerSetup />
		<Meta {...meta} />
		{UMAMI_ID && UMAMI_DOMAIN && import.meta.env.PROD ? (
			<Analytics isViewTransitionsEnabled={true} umamiDomain={UMAMI_DOMAIN} umamiId={UMAMI_ID} />
		) : undefined}
		<ClientRouter />
		<meta content={import.meta.env.BUILD_VERSION} name="build-version" />
		<script is:inline>
			(() => {
				const version = document.querySelector('meta[name="build-version"]')?.content;
				if (!version) return;
				document.addEventListener('astro:before-swap', (event) => {
					const next = event.newDocument.querySelector('meta[name="build-version"]')?.content;
					if (next && next !== version) window.location.assign(event.to.href);
				});
			})();
		</script>
		<link
			href={getBasePath('rss.xml')}
			rel="alternate"
			title={t('site.title')}
			type="application/rss+xml"
		/>
		<link href={getBasePath('sitemap-index.xml')} rel="sitemap" />
		{WEBMENTION_DOMAIN ? (
			<link href={`https://webmention.io/${WEBMENTION_DOMAIN}/webmention`} rel="webmention" />
		) : undefined}
	</head>
	<body
		class:list={[
			'bg-(--color-body-bg)',
			'text-primary-700 dark:text-primary-400',
			'visible flex min-h-screen flex-col overflow-visible overscroll-contain transition-colors',
		]}
	>
		<ModeManager />
		<Sprites />
		<ProgressLoading
			class:list={[
				'z-progress-loading rounded-br-md shadow-lg shadow-current',
				'bg-linear-to-r from-highlight-400 to-highlight-300 text-highlight-200 dark:text-highlight-800',
			]}
			height="2.5px"
		/>
		<ProgressReading
			class:list={[
				'z-progress rounded-br-md shadow-lg shadow-current',
				'bg-linear-to-r from-accent-500 to-accent-300 text-accent-200 dark:text-accent-800',
			]}
			height="2.5px"
		/>
		<header
			class:list={[
				'z-header transition-colors',
				hasHeroImage
					? 'bg-header-fade sm:absolute sm:top-0 sm:right-0 sm:left-0'
					: 'bg-primary-100 dark:bg-primary-800',
			]}
		>
			<SkipLink
				class:list={[
					'rounded-br-sm px-4 py-1 uppercase',
					'bg-primary-50 text-accent-500 hover:text-accent-400 focus-visible:text-accent-400 dark:bg-primary-800 dark:text-accent-400 dark:hover:text-accent-300 dark:focus-visible:text-accent-300',
				]}
				label={t('site.skip.label')}
				parentClass="z-skip-link"
				target="#main-content"
			/>
			<div class="content-column flex flex-wrap items-center justify-between gap-x-2 gap-y-2 pt-2 sm:pb-1">
				{isHomepage ? (
					<h1 class="flex grow items-center gap-1">
						<Anchor
							anchorColor="primary"
							class="text-xl font-semibold md:text-2xl lg:text-3xl"
							href={siteUrl}
						>
							{t('site.title')}
						</Anchor>
					</h1>
				) : (
					<div class="flex grow items-center gap-1">
						<Anchor
							anchorColor="primary"
							class="text-xl font-semibold md:text-2xl lg:text-3xl"
							href={siteUrl}
						>
							{t('site.title')}
						</Anchor>
					</div>
				)}
				<ModeToggle />
				<Search />
			</div>
			<div class="content-column-fill w-full overflow-x-clip">
				<NavigationHeader hasHeroImage={hasHeroImage} />
			</div>
		</header>
		<main class="flex-1" {...(hasHeroImage ? {} : { id: 'main-content', tabindex: -1 })}>
			<slot />
		</main>
		<footer class="content-column mt-8 mb-8 w-full pt-4">
			<div
				class:list={[
					'border-t pt-4 pb-8',
					'border-primary-200 text-primary-400 dark:border-primary-700 dark:text-primary-700',
				]}
			>
				<NavigationFooter />
				<Colophon />
			</div>
		</footer>
		<TopButton />
		{schemas && schemas.length > 0 ? (
			<script is:inline set:html={serializeGraph(schemas)} type="application/ld+json"></script>
		) : undefined}
	</body>
</html>
