---
import Anchor from '#components/parts/anchor.astro';
import DateDisplay from '#components/parts/date-display.astro';
import DividedItem from '#components/parts/divided-item.astro';
import { siteYearFounded } from '#constants.ts';
import { getTranslations } from '#lib/i18n/i18n-translations.ts';
import { getSiteUrl } from '#lib/utils/routing.ts';
import { formatStringTemplate } from '#lib/utils/text.ts';

const siteUrl = getSiteUrl();

const dateBuild = new Date();
const currentYear = dateBuild.getFullYear();

const t = getTranslations();
---

<nav
	class:list={[
		'flex flex-wrap gap-x-0 gap-y-2 text-xs sm:gap-x-1',
		'text-primary-500 dark:text-primary-400',
	]}
	aria-label={t('site.colophon.label')}
>
	<DividedItem dividerColor="muted"
		><span class="text-primary-400 dark:text-primary-500">※</span>
		<span>{t('site.footer.updated.label')} <DateDisplay date={dateBuild} /></span></DividedItem
	>
	<DividedItem dividerColor="muted"
		><span>
			{
				formatStringTemplate(t('site.footer.copyright.label'), {
					year: siteYearFounded,
					currentYear,
				})
			}
			{' '}
			<Anchor href={siteUrl} anchorColor="accent">{t('site.title')}</Anchor></span
		>
	</DividedItem>
	<DividedItem dividerColor="muted">
		<span
			>{t('site.footer.powered.label')}{' '}
			<Anchor href="https://astro.build" anchorColor="accent">Astro</Anchor></span
		>
	</DividedItem>
	<DividedItem dividerColor="muted">
		<Anchor href={getSiteUrl('build-stats')} anchorColor="accent"
			>{t('site.footer.buildStats.label')}</Anchor
		>
	</DividedItem>
	<DividedItem dividerColor="muted">
		<Anchor href="https://github.com/xsynaptic/spectralcodex" anchorColor="accent"
			>{t('site.footer.sourceCode.label')}</Anchor
		>
	</DividedItem>
	<DividedItem dividerColor="muted">
		<Anchor
			class:list={['colophon-rss-link']}
			href={`${getSiteUrl()}rss.xml`}
			anchorColor="accent"
			rel="feed"
			data-astro-prefetch="false"
			><span>{t('site.footer.feed.label')}</span>
			<div class="colophon-rss-icon">
				<svg
					xmlns="http://www.w3.org/2000/svg"
					class:list={['transition-colors duration-300']}
					width="1em"
					height="1em"
					viewBox="0 0 24 24"
					aria-labelledby="colophon-rss-icon"
					><path
						fill="currentColor"
						d="M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2m2.5 12A1.5 1.5 0 0 0 6 16.5A1.5 1.5 0 0 0 7.5 18A1.5 1.5 0 0 0 9 16.5A1.5 1.5 0 0 0 7.5 15M6 10v2a6 6 0 0 1 6 6h2a8 8 0 0 0-8-8m0-4v2a10 10 0 0 1 10 10h2A12 12 0 0 0 6 6"
					></path><title id="colophon-rss-icon">{t('site.footer.feed.label')}</title></svg
				>
			</div>
		</Anchor>
	</DividedItem>
</nav>
