---
import { getTranslations } from '#lib/i18n/i18n-translations.ts';

const t = getTranslations();
---

<button
	class="atlas-open anchor-base anchor-accent items-center gap-1 font-semibold"
	data-atlas-open
	data-umami-event="atlas-open"
	title={t('atlas.open.label')}
	type="button"
>
	<svg aria-hidden="true" height="16" viewBox="0 0 24 24" width="16">
		<use href="#icon:globe"></use>
	</svg>
	{t('atlas.title')}
</button>
