---
import { getTranslations } from '#lib/i18n/i18n-translations.ts';

const t = getTranslations();
---

<button
	class="atlas-open cursor-pointer items-center gap-1 font-semibold underline-offset-2 hover:underline focus-visible:underline"
	data-atlas-open
	data-umami-event="atlas-open"
	title={t('atlas.open.label')}
	type="button"
>
	<svg
		aria-hidden="true"
		height="16"
		viewBox="0 0 24 24"
		width="16"
		xmlns="http://www.w3.org/2000/svg"
	>
		<path
			d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0-18 0m.6-3h16.8M3.6 15h16.8M11.5 3a17 17 0 0 0 0 18m1-18a17 17 0 0 1 0 18"
			fill="none"
			stroke="currentColor"
			stroke-linecap="round"
			stroke-linejoin="round"
			stroke-width="2"
		></path>
	</svg>
	{t('atlas.title')}
</button>
