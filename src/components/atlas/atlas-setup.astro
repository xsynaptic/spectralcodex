---
import {
	atlasFlagStorageKey,
	atlasLinkParam,
	atlasPage,
	atlasPaneMediaQuery,
	atlasPaneSizeProperty,
	atlasPaneStorageKey,
	atlasSheetAttribute,
	atlasSheetHalfMediaQuery,
	atlasSheetRest,
	atlasSheetRestStorageKey,
} from '#lib/atlas/atlas-constants.ts';
---

<script
	define:vars={{
		flagStorageKey: atlasFlagStorageKey,
		linkParam: atlasLinkParam,
		mapPage: atlasPage.map,
		paneMediaQuery: atlasPaneMediaQuery,
		panePage: atlasPage.pane,
		paneSizeProperty: atlasPaneSizeProperty,
		paneStorageKey: atlasPaneStorageKey,
		sheetAttribute: atlasSheetAttribute,
		sheetHalf: atlasSheetRest.half,
		sheetHalfMediaQuery: atlasSheetHalfMediaQuery,
		sheetRaised: atlasSheetRest.raised,
		sheetRestStorageKey: atlasSheetRestStorageKey,
	}}
	is:inline
>
	// Cold load only; atlas-mode.ts stamps every later document before its swap
	const root = document.documentElement;
	const url = new URL(location.href);
	const hasLink = url.searchParams.has(linkParam);

	// Removed before the return path and analytics read the URL, so a reload or Back does not force the mode again
	if (hasLink) {
		url.searchParams.delete(linkParam);
		history.replaceState(history.state, '', url);
	}

	let isEnabled = root.dataset.atlasPage === mapPage || (hasLink && 'atlasPage' in root.dataset);

	try {
		if (isEnabled) sessionStorage.setItem(flagStorageKey, '1');
		else isEnabled = sessionStorage.getItem(flagStorageKey) === '1';
	} catch {
		// sessionStorage unavailable
	}

	if (isEnabled) root.dataset.atlas = '';

	let paneSize;

	try {
		paneSize = Number(localStorage.getItem(paneStorageKey));
	} catch {
		// localStorage unavailable
	}

	if (Number.isFinite(paneSize) && paneSize > 0) {
		root.style.setProperty(paneSizeProperty, `${paneSize}px`);
	}

	let sheetRest;

	try {
		sheetRest = localStorage.getItem(sheetRestStorageKey);
	} catch {
		// localStorage unavailable
	}

	if (
		isEnabled &&
		sheetRest !== sheetRaised &&
		root.dataset.atlasPage === panePage &&
		!matchMedia(paneMediaQuery).matches &&
		matchMedia(sheetHalfMediaQuery).matches
	) {
		root.setAttribute(sheetAttribute, sheetHalf);
	}
</script>

<script>
	import { startAtlasMode } from '#lib/atlas/atlas-mode.ts';

	startAtlasMode();
</script>
