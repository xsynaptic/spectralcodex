---
import type { ResourceSource } from '#lib/collections/resources/resources-utils.ts';

import CitationLine from '#components/parts/citation-line.astro';
import ListColumnItem from '#components/parts/list-column-item.astro';
import ListColumn from '#components/parts/list-column.astro';
import { buildSourceCitations } from '#lib/collections/resources/resources-citation.ts';

interface Props {
	class?: string | undefined;
	sources: Array<ResourceSource>;
}

const { class: className, sources } = Astro.props;
---

{sources.length > 0 ? (
	<ListColumn class:list={['font-serif text-xs sm:text-sm', className]}>
		{sources.map((source) => {
			const { multilingual, primary, url } = buildSourceCitations(source);

			return (
				<ListColumnItem class="flex flex-col items-start gap-1 font-serif">
					{primary ? <CitationLine citation={primary} titleClass="italic" url={url} /> : undefined}
					{multilingual ? (
						<CitationLine citation={multilingual} lang={multilingual.lang} url={url} />
					) : undefined}
				</ListColumnItem>
			);
		})}
	</ListColumn>
) : undefined}
