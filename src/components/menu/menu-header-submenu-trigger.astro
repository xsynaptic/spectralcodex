---
import type { MenuItem } from '#components/menu/menu-types.ts';

import { getMenuItemTriggerType, isActiveMenuItem } from '#components/menu/menu-utils.ts';
import Anchor from '#components/parts/anchor.astro';

interface Props {
	item: MenuItem;
	hasChildren: boolean;
}

const { item, hasChildren } = Astro.props;

const triggerType = getMenuItemTriggerType(item);
const triggerClasses = [
	'nav-sub-link',
	isActiveMenuItem(item, Astro.url.pathname) ? 'link-active' : undefined,
];
---

<div class="nav-sub-trigger">
	{
		triggerType === 'anchor' ? (
			<Anchor
				class:list={triggerClasses}
				href={item.url}
				linkColor="accent"
				{...(item.rel ? { rel: item.rel } : undefined)}
			>
				<slot />
			</Anchor>
		) : undefined
	}
	{
		triggerType === 'button' ? (
			<button type="button" class:list={['link link-accent', ...triggerClasses]}>
				<slot />
			</button>
		) : undefined
	}
	{
		triggerType === 'span' ? (
			<span class:list={triggerClasses}>
				<slot />
			</span>
		) : undefined
	}
	{
		hasChildren ? (
			<svg class="nav-sub-icon" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
				<use href="#icon:chevron-right" />
			</svg>
		) : undefined
	}
</div>
