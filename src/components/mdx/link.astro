---
import type { HTMLAttributes } from 'astro/types';

import MdxAnchor from '#components/mdx/mdx-anchor.astro';
import { getCatalog } from '#lib/catalog/catalog-data.ts';

interface Props extends Omit<HTMLAttributes<'a'>, 'id'> {
	id: string | undefined;
}

const { id, ...props } = Astro.props;

const pathname = Astro.url.pathname;

if (!id) {
	throw new Error(`Link component requires an ID; rendering path: ${pathname}`);
}

const catalog = await getCatalog();
const catalogItem = catalog.getById(id);
---

<MdxAnchor href={catalogItem?.url} {...props}>
	<slot />
</MdxAnchor>
