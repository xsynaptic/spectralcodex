---
import BuildStatsDuration from '#components/build-stats/build-stats-duration.astro';
import BuildStatsPages from '#components/build-stats/build-stats-pages.astro';
import { getBuildStatsGeometry } from '#lib/build-stats/build-stats-geometry.ts';
import { getBuildRecords } from '#lib/build-stats/build-stats-loader.ts';
import { getTranslations } from '#lib/i18n/i18n-translations.ts';
import buildStatsCssUrl from '#styles/build-stats.css?url';

interface Props {
	daysLimit?: number;
	trendWindowDays?: number;
}

const { daysLimit = Infinity, trendWindowDays = 14 } = Astro.props;

const t = getTranslations();

const geometry = getBuildStatsGeometry(await getBuildRecords(), { daysLimit, trendWindowDays });
---

{geometry ? (
	<Fragment>
		<link href={buildStatsCssUrl} rel="stylesheet" />
		<BuildStatsDuration axisTicks={geometry.axisTicks} geometry={geometry.duration} />
		{geometry.pages ? (
			<BuildStatsPages axisTicks={geometry.axisTicks} geometry={geometry.pages} />
		) : undefined}
	</Fragment>
) : (
	<p class="text-sm text-primary-500 dark:text-primary-400">{t('buildStats.empty')}</p>
)}
