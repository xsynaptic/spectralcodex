---
import type { HTMLAttributes } from 'astro/types';

import MdxAnchor from '#components/mdx/mdx-anchor.astro';
import { getResourcesCollection } from '#lib/collections/resources/resources-data.ts';
import { getResourcePath } from '#lib/utils/routing.ts';

interface Props extends Omit<HTMLAttributes<'a'>, 'id'> {
	id: string | undefined;
}

const { id, ...props } = Astro.props;

const pathname = Astro.url.pathname;

if (!id) {
	throw new Error(`Resource component requires an ID; rendering path: ${pathname}`);
}

const { entriesMap } = await getResourcesCollection();
const resource = entriesMap.get(id);

if (!resource && import.meta.env.DEV) {
	console.warn(`[Resource] Referenced resource "${id}" not found; rendering path: ${pathname}`);
}

const href = resource ? getResourcePath(resource.id, resource.data.showPage) : undefined;
---

<MdxAnchor href={href} {...props}>
	<slot />
</MdxAnchor>
