---
import type { HTMLAttributes } from 'astro/types';

import MapComponent from '#components/map/map-component.astro';
import { createLocationsByIdsFunction } from '#lib/collections/locations/locations-data.ts';
import { createMapDataFunction } from '#lib/map/map-data.ts';
import { getLocationsMapRule } from '#lib/map/map-locations.ts';

interface Props extends HTMLAttributes<'div'> {
	languages?: Array<string> | undefined;
	locations: Array<string>;
}

const { class: className, languages, locations: locationIds, ...props } = Astro.props;

const { isFeed } = Astro.locals;

const getLocationsByReference = await createLocationsByIdsFunction();
const getMapData = await createMapDataFunction();

const { hasGeodata, props: mapComponentProps } = getMapData({
	languages,
	rule: getLocationsMapRule(getLocationsByReference(locationIds)),
});
---

{hasGeodata && !isFeed ? (
	<div {...props} class:list={['content-column-fill', className]} data-pagefind-ignore>
		<MapComponent mapComponentProps={mapComponentProps} />
	</div>
) : undefined}
