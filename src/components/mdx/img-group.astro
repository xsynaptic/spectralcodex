---
import type { HTMLAttributes } from 'astro/types';

import type { ImageContext, ImageLayout } from '#lib/image/image-types.ts';

import ImageCarouselNavigation from '#components/image/image-carousel-navigation.astro';
import { ImageContextEnum, ImageLayoutEnum } from '#lib/image/image-types.ts';
import { renderSlot } from '#lib/utils/astro.ts';

// `context` and `imageCount` are both injected by the satteri-img-group plugin
interface Props extends HTMLAttributes<'div'> {
	layout?: ImageLayout;
	context?: ImageContext;
	columns?: number | string;
	imageCount?: number | string;
}

const { layout, context, columns: columnsProp, imageCount: imageCountProp, ...props } = Astro.props;

// This conditional controls whether slot contents are just passed through
const { isFeed } = Astro.locals;

// This outputs MDX components already transformed into HTML
const slotContents = await renderSlot(Astro.slots, 'default');

const imageCount = imageCountProp ? Number(imageCountProp) : 0;

const isCarousel = context === ImageContextEnum.Carousel;

function getGridColumnCount(itemCount: number) {
	if (itemCount % 5 === 0) return 5;
	if (itemCount % 4 === 0) return 4;
	if (itemCount % 3 === 0) return 3;
	if (itemCount % 2 === 0) return 2;
	return 1;
}

function getLayoutClass() {
	if (layout === ImageLayoutEnum.Wide) return 'img-group-wide';
	if (layout === ImageLayoutEnum.Full) return 'img-group-full';
	return;
}

const gridColumnClasses = {
	1: undefined,
	2: 'grid grid-cols-1 gap-2 sm:grid-cols-2 md:gap-4',
	3: 'grid grid-cols-1 gap-2 md:grid-cols-3 md:gap-4',
	4: 'grid grid-cols-1 gap-2 md:grid-cols-4 md:gap-4',
	5: 'grid grid-cols-1 gap-2 md:grid-cols-5 md:gap-4',
} as const;

function getRenderMode() {
	if (imageCount === 0) return;
	if (isFeed) return 'feed';
	return isCarousel ? 'carousel' : 'grid';
}

const layoutClass = getLayoutClass();
const columns = getGridColumnCount(columnsProp ? Number(columnsProp) : imageCount);
const renderMode = getRenderMode();
---

{renderMode === 'feed' ? <Fragment set:html={slotContents} /> : undefined}
{renderMode === 'carousel' ? (
	<image-carousel class:list={['img-group prose-escape carousel-group', layoutClass]} {...props}>
		<div class="img-group-viewport">
			<div class="carousel-container">
				<Fragment set:html={slotContents} />
			</div>
			<ImageCarouselNavigation />
		</div>
	</image-carousel>
) : undefined}
{renderMode === 'grid' ? (
	<div class:list={['img-group prose-escape', layoutClass, gridColumnClasses[columns]]} {...props}>
		<Fragment set:html={slotContents} />
	</div>
) : undefined}
