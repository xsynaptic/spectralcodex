<script is:inline>
	{
		let stored;

		try {
			stored = localStorage.getItem('scx-mode');
		} catch {
			// localStorage unavailable
		}

		let mode = ['auto', 'light', 'dark'].includes(stored) ? stored : 'auto';

		if (mode === 'auto') {
			mode = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
		}

		document.documentElement.dataset.mode = mode;
		document.documentElement.style.colorScheme = mode;

		const themeColor = getComputedStyle(document.documentElement)
			.getPropertyValue('--color-body-bg')
			.trim();
		const meta = document.querySelector('meta[name="theme-color"]');
		if (meta && themeColor) meta.setAttribute('content', themeColor);
	}
</script>
