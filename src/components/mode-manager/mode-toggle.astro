---
import type { HTMLAttributes } from 'astro/types';

import { getTranslations } from '#lib/i18n/i18n-translations.ts';

type Props = HTMLAttributes<'div'>;

const props = Astro.props;

const t = getTranslations();
---

<mode-toggle
	class:list={[
		'flex cursor-pointer items-center justify-center rounded-full opacity-60 transition-opacity focus-within:opacity-100 hover:opacity-100',
	]}
	data-label-dark={t('site.mode.toggle.dark.label')}
	data-label-light={t('site.mode.toggle.light.label')}
	transition:persist
	{...props}
>
	<button
		aria-label={t('site.mode.toggle.dark.label')}
		class="text-primary-700 dark:text-primary-300"
		data-umami-event="mode-toggle"
		title={t('site.mode.toggle.dark.label')}
		type="button"
	>
		<svg
			aria-hidden="true"
			class="block dark:hidden"
			height="24"
			viewBox="0 0 24 24"
			width="24"
			xmlns="http://www.w3.org/2000/svg"
		>
			<g
				fill="none"
				stroke="currentColor"
				stroke-linecap="round"
				stroke-linejoin="round"
				stroke-width="2"
			>
				<circle cx="12" cy="12" r="4"></circle>
				<path d="M12 3v1m0 16v1m-9-9h1m16 0h1m-2.636-6.364l-.707.707M6.343 17.657l-.707.707m0-12.728l.707.707m11.314 11.314l.707.707"></path>
			</g>
		</svg>
		<svg
			aria-hidden="true"
			class="hidden dark:block"
			height="24"
			viewBox="0 0 24 24"
			width="24"
			xmlns="http://www.w3.org/2000/svg"
		>
			<path
				d="M12 3a6 6 0 0 0 9 9a9 9 0 1 1-9-9"
				fill="none"
				stroke="currentColor"
				stroke-linecap="round"
				stroke-linejoin="round"
				stroke-width="2"
			></path>
		</svg>
	</button>
</mode-toggle>

<script>
	import '#components/mode-manager/mode-toggle.ts';
</script>
