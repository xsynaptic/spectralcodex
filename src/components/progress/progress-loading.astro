---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
	height?: string | undefined;
}

const { class: className, height = '1px', style = {}, ...props } = Astro.props;
---

<progress-loading
	aria-hidden="true"
	class:list={['progress-bar', className]}
	style={{ height, ...style }}
	transition:persist="progress-loading"
	{...props}
></progress-loading>

<script>
	import { defineProgressLoading } from '@xsynaptic/web-components/progress-loading';

	defineProgressLoading();
</script>
