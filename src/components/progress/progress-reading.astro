---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
	height?: string | undefined;
}

const { class: className, height = '1px', style = {}, ...props } = Astro.props;
---

<progress-reading
	aria-hidden="true"
	class:list={['progress-bar', className]}
	style={{ height, ...style }}
	{...props}
></progress-reading>

<script>
	import '#components/progress/progress-reading.ts';
</script>
