---
import type { NavigationItem } from '#components/navigation/navigation-types.ts';

import {
	getNavigationItemTriggerType,
	isActiveNavigationItem,
	isCurrentNavigationItem,
} from '#components/navigation/navigation-utils.ts';
import Anchor from '#components/parts/anchor.astro';

interface Props {
	hasChildren: boolean;
	item: NavigationItem;
}

const { hasChildren, item } = Astro.props;

const triggerType = getNavigationItemTriggerType(item);
const isCurrent = isCurrentNavigationItem(item, Astro.url.pathname);
const triggerClasses = [
	'nav-item-link',
	isActiveNavigationItem(item, Astro.url.pathname) ? 'anchor-active' : undefined,
];
---

<div class="nav-item-trigger">
	{triggerType === 'anchor' ? (
		<Anchor
			anchorColor="accent"
			class:list={triggerClasses}
			href={item.url}
			{...(isCurrent ? { 'aria-current': 'page' as const } : undefined)}
			{...(item.rel ? { rel: item.rel } : undefined)}
		>
			<Fragment set:html={item.title} />
		</Anchor>
	) : undefined}
	{triggerType === 'button' ? (
		<button
			class:list={['anchor-base anchor-accent', ...triggerClasses]}
			set:html={item.title}
			type="button"
		/>
	) : undefined}
	{triggerType === 'span' ? <span class:list={triggerClasses} set:html={item.title} /> : undefined}
	{hasChildren ? (
		<svg aria-hidden="true" class="nav-icon" height="24" viewBox="0 0 24 24" width="24">
			<use href="#icon:chevron-down" />
		</svg>
	) : undefined}
</div>
