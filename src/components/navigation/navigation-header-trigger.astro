---
import type { NavigationItem } from '#components/navigation/navigation-types.ts';

import {
	getNavigationItemTriggerType,
	isActiveNavigationItem,
	isCurrentNavigationItem,
} from '#components/navigation/navigation-utils.ts';
import Anchor from '#components/parts/anchor.astro';

const triggerVariants = {
	item: {
		icon: 'nav-icon',
		iconHref: '#icon:chevron-down',
		link: 'nav-item-link',
		trigger: 'nav-item-trigger',
	},
	submenu: {
		icon: 'nav-sub-icon',
		iconHref: '#icon:chevron-right',
		link: 'nav-sub-link',
		trigger: 'nav-sub-trigger',
	},
} as const;

interface Props {
	currentPath: string | undefined;
	hasChildren: boolean;
	item: NavigationItem;
	variant: keyof typeof triggerVariants;
}

const { currentPath, hasChildren, item, variant } = Astro.props;

const variantClasses = triggerVariants[variant];
const triggerType = getNavigationItemTriggerType(item);
const isCurrent = isCurrentNavigationItem(item, currentPath);
const triggerClasses = [
	variantClasses.link,
	isActiveNavigationItem(item, currentPath) ? 'anchor-active' : undefined,
];
---

<div class:list={[variantClasses.trigger, hasChildren ? 'select-none' : undefined]}>
	{triggerType === 'anchor' ? (
		<Anchor
			anchorColor="accent"
			class:list={triggerClasses}
			href={item.url}
			{...(isCurrent ? { 'aria-current': 'page' as const } : undefined)}
			{...(item.rel ? { rel: item.rel } : undefined)}
		>
			<slot />
		</Anchor>
	) : undefined}
	{triggerType === 'button' ? (
		<button class:list={['anchor-base anchor-accent', ...triggerClasses]} type="button">
			<slot />
		</button>
	) : undefined}
	{triggerType === 'span' ? (
		<span class:list={triggerClasses}>
			<slot />
		</span>
	) : undefined}
	{hasChildren ? (
		<svg aria-hidden="true" class={variantClasses.icon} height="24" viewBox="0 0 24 24" width="24">
			<use href={variantClasses.iconHref} />
		</svg>
	) : undefined}
</div>
