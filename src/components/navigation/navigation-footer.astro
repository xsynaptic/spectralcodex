---
import type { HTMLAttributes } from 'astro/types';

import { navigationFooterItems } from '#components/navigation/navigation-footer.ts';
import {
	isActiveNavigationItem,
	isCurrentNavigationItem,
} from '#components/navigation/navigation-utils.ts';
import Anchor from '#components/parts/anchor.astro';
import { getTranslations } from '#lib/i18n/i18n-translations.ts';

type Props = HTMLAttributes<'nav'>;

const props = Astro.props;

const { pathname } = Astro.url;

const t = getTranslations();
---

<nav class="pb-4 text-sm" aria-label={t('site.navigation.footer.label')} data-nosnippet {...props}>
	<ul class="flex flex-wrap gap-x-4 gap-y-2">
		{
			navigationFooterItems.map((item) => (
				<li class="text-xs font-medium sm:text-sm">
					<Anchor
						anchorColor="primary"
						isActive={isActiveNavigationItem(item, pathname)}
						href={item.url}
						{...(isCurrentNavigationItem(item, pathname)
							? { 'aria-current': 'page' as const }
							: undefined)}
						{...(item.rel ? { rel: item.rel } : undefined)}
					>
						{item.title}
					</Anchor>
				</li>
			))
		}
	</ul>
</nav>
