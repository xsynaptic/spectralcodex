---
import type { HTMLAttributes } from 'astro/types';

import type { NavigationItem } from '#components/navigation/navigation-types.ts';

import NavigationHeaderSubmenuTrigger from '#components/navigation/navigation-header-submenu-trigger.astro';
import {
	getNavigationItemAriaLabel,
	shouldShowNavigationItemMultilingual,
} from '#components/navigation/navigation-utils.ts';
import TextMultilingual from '#components/parts/text-multilingual.astro';

interface Props extends HTMLAttributes<'ul'> {
	ariaLabel?: string;
	depth: number;
	isFirstNavigationItem?: boolean;
	navigationItems: Array<NavigationItem>;
}

const { ariaLabel, depth, isFirstNavigationItem = true, navigationItems, ...props } = Astro.props;
---

<ul
	aria-label={ariaLabel}
	class:list={[
		'nav-sub-menu',
		depth === 1 ? 'nav-sub-menu-d1' : undefined,
		depth === 2 ? 'nav-sub-menu-d2' : undefined,
		depth > 2 ? 'nav-sub-menu-d3' : undefined,
		!isFirstNavigationItem && depth > 1 ? 'sm:rounded-tr-md' : undefined,
	]}
	{...props}
>
	{navigationItems.map((item, index) => {
		const children = item.children ?? [];
		const hasChildren = children.length > 0;

		return (
			<li class="nav-sub-item">
				<NavigationHeaderSubmenuTrigger hasChildren={hasChildren} item={item}>
					<Fragment set:html={item.title} />
					{shouldShowNavigationItemMultilingual(item, depth) ? (
						<TextMultilingual class="nav-ml" content={item.titleMultilingual} parenthesis={true} />
					) : undefined}
				</NavigationHeaderSubmenuTrigger>
				{hasChildren ? (
					<Astro.self
						ariaLabel={getNavigationItemAriaLabel(item)}
						depth={depth + 1}
						isFirstNavigationItem={isFirstNavigationItem && index === 0}
						navigationItems={children}
					/>
				) : undefined}
			</li>
		);
	})}
</ul>
