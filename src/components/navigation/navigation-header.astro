---
import NavigationHeaderMenu from '#components/navigation/navigation-header-menu.astro';
import {
	getNavigationHeaderItems,
	getNavigationHeaderUrls,
} from '#components/navigation/navigation-header.ts';
import RenderCache from '#components/parts/render-cache.astro';

interface Props {
	hasHeroImage: boolean;
}

const { hasHeroImage } = Astro.props;

const navigationItems = await getNavigationHeaderItems();
const navigationUrls = await getNavigationHeaderUrls();

const currentPath = navigationUrls.has(Astro.url.pathname) ? Astro.url.pathname : undefined;
---

<RenderCache cacheKey={`navigation-header:${String(hasHeroImage)}:${currentPath ?? ''}`}>
	<NavigationHeaderMenu
		currentPath={currentPath}
		hasHeroImage={hasHeroImage}
		navigationItems={navigationItems}
	/>
</RenderCache>

<script>
	import '#components/navigation/navigation-site.ts';
</script>
