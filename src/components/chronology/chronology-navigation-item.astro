---
import Anchor from '#components/parts/anchor.astro';
import DividedItem from '#components/parts/divided-item.astro';

interface Props {
	href: string;
	isCurrent: boolean;
}

const { href, isCurrent } = Astro.props;
---

<DividedItem as="li">
	{isCurrent ? (
		<span aria-current="page" class="font-semibold text-highlight-600">
			<slot />
		</span>
	) : (
		<Anchor href={href} anchorColor="highlight">
			<slot />
		</Anchor>
	)}
</DividedItem>
