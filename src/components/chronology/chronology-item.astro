---
import type { CatalogItem } from '#lib/catalog/catalog-types.ts';

import PreviewList from '#components/parts/preview-list.astro';
import Prose from '#components/parts/prose.astro';

interface Props {
	class?: string | undefined;
	count?: number | undefined;
	items: Array<CatalogItem>;
	showItemCount?: boolean | undefined;
	title: string;
	url?: string | undefined;
}

const { class: className, count, items, showItemCount = false, title, url, ...props } = Astro.props;

const itemCountLabel =
	showItemCount && items.length >= 10 ? ` (${String(items.length)})` : undefined;
---

{items.length > 0 ? (
	<Prose class={className} {...props}>
		<span class="font-medium">
			{title}
			{itemCountLabel}
		</span>
		: <PreviewList count={count} items={items} url={url} />
	</Prose>
) : undefined}
