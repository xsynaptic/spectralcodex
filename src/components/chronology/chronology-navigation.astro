---
import type { HTMLAttributes } from 'astro/types';

import ChronologyNavigationItem from '#components/chronology/chronology-navigation-item.astro';
import DividedItem from '#components/parts/divided-item.astro';
import { getTranslations } from '#lib/i18n/i18n-translations.ts';
import { renderSlot } from '#lib/utils/astro.ts';
import { getSitePath } from '#lib/utils/routing.ts';

interface Props extends HTMLAttributes<'nav'> {
	currentYear?: string | undefined;
	currentMonth?: string | undefined;
	chronologyYears: Array<string>;
	chronologyMonths?: Array<string> | undefined;
	hasHeroImage?: boolean | undefined;
}

const {
	class: className,
	currentYear,
	currentMonth,
	chronologyYears,
	chronologyMonths,
	hasHeroImage = false,
	...props
} = Astro.props;

const t = getTranslations();

const indexSlot = await renderSlot(Astro.slots, 'default');

const months = chronologyMonths?.toSorted((monthA, monthB) => monthA.localeCompare(monthB)) ?? [];

function getMonthName(month: string) {
	return new Date(0, Number(month) - 1).toLocaleDateString('en-US', { month: 'long' });
}
---

<nav
	class:list={[
		'flex flex-col gap-1 overflow-hidden text-sm text-primary-500 dark:text-primary-400',
		hasHeroImage ? 'divided-hero mb-8 sm:mb-0' : '',
		className,
	]}
	aria-label={t('chronology.index.title')}
	{...props}
>
	<ul
		class:list={[
			'flex gap-1',
			hasHeroImage ? 'flex-wrap sm:flex-nowrap sm:overflow-x-scroll' : 'flex-wrap',
		]}
	>
		{indexSlot ? (
			<DividedItem as="li" dividerContent="chevron">
				<Fragment set:html={indexSlot} />
			</DividedItem>
		) : undefined}
		{chronologyYears.map((year) => (
			<ChronologyNavigationItem
				href={getSitePath('chronology', year)}
				period="year"
				hasHeroImage={hasHeroImage}
				isCurrent={!currentMonth && currentYear === year}
				isActive={Boolean(currentMonth) && currentYear === year}
			>
				{year}
			</ChronologyNavigationItem>
		))}
	</ul>
	{currentYear && currentMonth && months.length > 0 ? (
		<ul
			class:list={[
				'flex gap-1',
				hasHeroImage ? 'flex-wrap sm:flex-nowrap sm:overflow-x-scroll' : 'flex-wrap',
			]}
		>
			{months.map((month) => (
				<ChronologyNavigationItem
					href={getSitePath('chronology', currentYear, month)}
					period="month"
					hasHeroImage={hasHeroImage}
					isCurrent={currentMonth === month}
				>
					{getMonthName(month)}
				</ChronologyNavigationItem>
			))}
		</ul>
	) : undefined}
</nav>
