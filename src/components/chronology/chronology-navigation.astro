---
import type { HTMLAttributes } from 'astro/types';

import ChronologyNavigationItem from '#components/chronology/chronology-navigation-item.astro';
import Anchor from '#components/parts/anchor.astro';
import DividedItem from '#components/parts/divided-item.astro';
import PaginationSelect from '#components/parts/pagination-select.astro';
import { getChronologyYearPagination } from '#lib/collections/chronology/chronology-utils.ts';
import { getTranslations } from '#lib/i18n/i18n-translations.ts';
import { getSitePath } from '#lib/utils/routing.ts';

interface Props extends HTMLAttributes<'nav'> {
	chronologyMonths?: Array<string> | undefined;
	chronologyYears: Array<string>;
	currentMonth?: string | undefined;
	currentYear?: string | undefined;
}

const {
	chronologyMonths,
	chronologyYears,
	class: className,
	currentMonth,
	currentYear,
	...props
} = Astro.props;

const t = getTranslations();

const yearPagination = getChronologyYearPagination(chronologyYears, currentYear, currentMonth);

const months = chronologyMonths?.toSorted((monthA, monthB) => monthA.localeCompare(monthB)) ?? [];

function getMonthName(month: string) {
	return new Date(0, Number(month) - 1).toLocaleDateString('en-US', { month: 'long' });
}
---

<nav
	aria-label={t('chronology.index.title')}
	class:list={[
		'flex w-full flex-col gap-2 text-sm text-primary-500 dark:text-primary-400',
		className,
	]}
	{...props}
>
	<PaginationSelect pagination={yearPagination}>
		<slot />
	</PaginationSelect>
	{currentYear && currentMonth && months.length > 0 ? (
		<div class="flex gap-1">
			<DividedItem class="shrink-0" dividerContent="chevron">
				<Anchor anchorColor="highlight" href={getSitePath('chronology', currentYear)}>
					{currentYear}
				</Anchor>
			</DividedItem>
			<ul class="flex flex-wrap gap-1">
				{months.map((month) => (
					<ChronologyNavigationItem
						href={getSitePath('chronology', currentYear, month)}
						isCurrent={currentMonth === month}
					>
						{getMonthName(month)}
					</ChronologyNavigationItem>
				))}
			</ul>
		</div>
	) : undefined}
</nav>
