---
import type { HTMLAttributes } from 'astro/types';

import { renderSlot } from '#lib/utils/astro.ts';

interface Props extends HTMLAttributes<'li'> {
	label?: string | undefined;
}

const { class: className, label, ...props } = Astro.props;

const children = await renderSlot(Astro.slots, 'default');
---

{children ? (
	<li class="list-item">
		<div class:list={['list-item-body', className]} {...props}>
			{label ? <span class="font-semibold">{label}</span> : undefined}
			<Fragment set:html={children} />
		</div>
	</li>
) : undefined}
