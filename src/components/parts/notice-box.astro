---
import type { HTMLAttributes } from 'astro/types';

import type { NoticeBoxSeverity } from '#components/types.ts';

import { NoticeBoxSeverityEnum } from '#components/types.ts';
import { getTranslations } from '#lib/i18n/i18n-translations.ts';

const severityLabelKeys = {
	[NoticeBoxSeverityEnum.Info]: 'notice.severity.info',
	[NoticeBoxSeverityEnum.Success]: 'notice.severity.success',
	[NoticeBoxSeverityEnum.Warning]: 'notice.severity.warning',
	[NoticeBoxSeverityEnum.Error]: 'notice.severity.error',
} as const;

const severityContainerClasses = {
	[NoticeBoxSeverityEnum.Info]:
		'border-primary-300 bg-primary-200 text-primary-600 dark:border-primary-900 dark:bg-primary-600 dark:text-primary-200',
	[NoticeBoxSeverityEnum.Success]:
		'border-green-300 bg-green-100 text-green-600 dark:border-green-900 dark:bg-green-600 dark:text-green-200',
	[NoticeBoxSeverityEnum.Warning]:
		'border-highlight-300 bg-highlight-100 text-highlight-700 dark:border-highlight-600 dark:bg-highlight-700 dark:text-highlight-200',
	[NoticeBoxSeverityEnum.Error]:
		'border-orange-300 bg-orange-100 text-orange-700 dark:border-orange-600 dark:bg-orange-700 dark:text-orange-200',
} as const;

const severityIconClasses = {
	[NoticeBoxSeverityEnum.Info]:
		'border-primary-300 bg-primary-100 text-primary-500 dark:border-primary-600 dark:bg-primary-600 dark:text-primary-300',
	[NoticeBoxSeverityEnum.Success]:
		'border-green-200 bg-green-50 text-green-500 dark:border-green-600 dark:bg-green-600 dark:text-green-300',
	[NoticeBoxSeverityEnum.Warning]:
		'border-highlight-200 bg-highlight-50 text-highlight-500 dark:border-highlight-600 dark:bg-highlight-600 dark:text-highlight-300',
	[NoticeBoxSeverityEnum.Error]:
		'border-orange-200 bg-orange-50 text-orange-500 dark:border-orange-600 dark:bg-orange-600 dark:text-orange-300',
} as const;

interface Props extends HTMLAttributes<'div'> {
	severity: NoticeBoxSeverity;
	showIcon?: boolean;
}

const { severity, class: className, showIcon = true, role = 'note', ...props } = Astro.props;

// Glyphs from iconamoon information-circle, check-circle-1, attention-circle, and close-circle-1 (duotone)
const iconSize = 20;

const t = getTranslations();
---

<div
	class:list={[
		'flex gap-x-1 overflow-clip rounded-sm border',
		severityContainerClasses[severity],
		className,
	]}
	role={role}
	{...props}
>
	{showIcon ? (
		<div class:list={['border-r px-1 py-1', severityIconClasses[severity]]}>
			<span class="sr-only">{t(severityLabelKeys[severity])}</span>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				width={iconSize}
				height={iconSize}
				viewBox="0 0 24 24"
				aria-hidden="true"
			>
				<g fill="none">
					<circle cx="12" cy="12" r="9" fill="currentColor" opacity="0.2" />
					<circle
						cx="12"
						cy="12"
						r="9"
						stroke="currentColor"
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
					/>
					{severity === NoticeBoxSeverityEnum.Info ? (
						<>
							<path
								stroke="currentColor"
								stroke-linejoin="round"
								stroke-width="3"
								d="M12 8h.01v.01H12z"
							/>
							<path
								stroke="currentColor"
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M12 12v4"
							/>
						</>
					) : undefined}
					{severity === NoticeBoxSeverityEnum.Success ? (
						<path
							stroke="currentColor"
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="m15 10l-4 4l-2-2"
						/>
					) : undefined}
					{severity === NoticeBoxSeverityEnum.Warning ? (
						<>
							<path
								stroke="currentColor"
								stroke-linejoin="round"
								stroke-width="3"
								d="M12 16h.01v.01H12z"
							/>
							<path
								stroke="currentColor"
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M12 12V8"
							/>
						</>
					) : undefined}
					{severity === NoticeBoxSeverityEnum.Error ? (
						<path
							stroke="currentColor"
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="m14 10l-4 4m0-4l4 4"
						/>
					) : undefined}
				</g>
			</svg>
		</div>
	) : undefined}
	<div class="py-1 pr-2 pl-1 text-sm">
		<slot />
	</div>
</div>
