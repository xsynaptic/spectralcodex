---
import type { HTMLAttributes } from 'astro/types';

import { getTranslations } from '#lib/i18n/i18n-translations.ts';

const NoticeBoxSeverityEnum = {
	Default: 'default',
	Success: 'success',
	Info: 'info',
	Warning: 'warning',
	Error: 'error',
} as const;

const severityLabelKeys = {
	[NoticeBoxSeverityEnum.Default]: 'notice.severity.default',
	[NoticeBoxSeverityEnum.Success]: 'notice.severity.success',
	[NoticeBoxSeverityEnum.Info]: 'notice.severity.info',
	[NoticeBoxSeverityEnum.Warning]: 'notice.severity.warning',
	[NoticeBoxSeverityEnum.Error]: 'notice.severity.error',
} as const;

interface Props extends HTMLAttributes<'div'> {
	severity?: (typeof NoticeBoxSeverityEnum)[keyof typeof NoticeBoxSeverityEnum];
	showIcon?: boolean;
}

const {
	severity = NoticeBoxSeverityEnum.Default,
	class: className,
	showIcon = true,
	role = 'note',
	...props
} = Astro.props;

const iconSize = 20;

const t = getTranslations();
---

<div
	class:list={[
		'flex gap-x-1 overflow-clip rounded-sm border',
		severity === NoticeBoxSeverityEnum.Default
			? 'border-primary-300 bg-primary-100 text-primary-600 dark:border-primary-900 dark:bg-primary-600 dark:text-primary-200'
			: undefined,
		severity === NoticeBoxSeverityEnum.Success
			? 'border-green-300 bg-green-100 text-green-600 dark:border-green-900 dark:bg-green-600 dark:text-green-200'
			: undefined,
		severity === NoticeBoxSeverityEnum.Info
			? 'border-cyan-300 bg-cyan-100 text-cyan-600 dark:border-cyan-900 dark:bg-cyan-600 dark:text-cyan-200'
			: undefined,
		severity === NoticeBoxSeverityEnum.Warning
			? 'border-amber-300 bg-amber-100 text-amber-700 dark:border-amber-600 dark:bg-amber-700 dark:text-amber-200'
			: undefined,
		severity === NoticeBoxSeverityEnum.Error
			? 'border-orange-300 bg-orange-100 text-orange-700 dark:border-orange-600 dark:bg-orange-700 dark:text-orange-200'
			: undefined,
		className,
	]}
	role={role}
	{...props}
>
	{
		showIcon ? (
			<div
				class:list={[
					'border-r px-1 py-1',
					severity === NoticeBoxSeverityEnum.Default
						? 'border-primary-200 bg-primary-50 text-primary-500 dark:border-primary-600 dark:bg-primary-600 dark:text-primary-300'
						: undefined,
					severity === NoticeBoxSeverityEnum.Success
						? 'border-green-200 bg-green-50 text-green-500 dark:border-green-600 dark:bg-green-600 dark:text-green-300'
						: undefined,
					severity === NoticeBoxSeverityEnum.Info
						? 'border-cyan-200 bg-cyan-50 text-cyan-500 dark:border-cyan-600 dark:bg-cyan-600 dark:text-cyan-300'
						: undefined,
					severity === NoticeBoxSeverityEnum.Warning
						? 'border-amber-200 bg-amber-50 text-amber-500 dark:border-amber-600 dark:bg-amber-600 dark:text-amber-300'
						: undefined,
					severity === NoticeBoxSeverityEnum.Error
						? 'border-orange-200 bg-orange-50 text-orange-500 dark:border-orange-600 dark:bg-orange-600 dark:text-orange-300'
						: undefined,
				]}
			>
				<span class="sr-only">{t(severityLabelKeys[severity])}</span>
				{(() => {
					switch (severity) {
						case NoticeBoxSeverityEnum.Default: {
							return (
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width={iconSize}
									height={iconSize}
									viewBox="0 0 24 24"
									aria-hidden="true"
								>
									<g fill="none">
										<circle cx="12" cy="12" r="9" fill="currentColor" opacity="0.2" />
										<circle
											cx="12"
											cy="12"
											r="9"
											stroke="currentColor"
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
										/>
										<path
											stroke="currentColor"
											stroke-linejoin="round"
											stroke-width="3"
											d="M12 16h.01v.01H12z"
										/>
										<path
											stroke="currentColor"
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
											d="M10.586 7.586c.39-.39.9-.585 1.41-.586a2 2 0 0 1 1.418.586c.39.39.586.902.586 1.414s-.195 1.024-.586 1.414a2 2 0 0 1-1.418.586L12 12"
										/>
									</g>
								</svg>
							);
						}
						case NoticeBoxSeverityEnum.Success: {
							// iconamoon:check-circle-1-duotone
							return (
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width={iconSize}
									height={iconSize}
									viewBox="0 0 24 24"
									aria-hidden="true"
								>
									<g fill="none">
										<circle cx="12" cy="12" r="9" fill="currentColor" opacity="0.2" />
										<circle
											cx="12"
											cy="12"
											r="9"
											stroke="currentColor"
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
										/>
										<path
											stroke="currentColor"
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
											d="m15 10l-4 4l-2-2"
										/>
									</g>
								</svg>
							);
						}
						case NoticeBoxSeverityEnum.Info: {
							// iconamoon:information-circle-duotone
							return (
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width={iconSize}
									height={iconSize}
									viewBox="0 0 24 24"
									aria-hidden="true"
								>
									<g fill="none">
										<circle cx="12" cy="12" r="9" fill="currentColor" opacity="0.2" />
										<circle
											cx="12"
											cy="12"
											r="9"
											stroke="currentColor"
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
										/>
										<path
											stroke="currentColor"
											stroke-linejoin="round"
											stroke-width="3"
											d="M12 8h.01v.01H12z"
										/>
										<path
											stroke="currentColor"
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
											d="M12 12v4"
										/>
									</g>
								</svg>
							);
						}
						case NoticeBoxSeverityEnum.Warning: {
							// iconamoon:attention-circle-duotone
							return (
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width={iconSize}
									height={iconSize}
									viewBox="0 0 24 24"
									aria-hidden="true"
								>
									<g fill="none">
										<circle cx="12" cy="12" r="9" fill="currentColor" opacity="0.2" />
										<circle
											cx="12"
											cy="12"
											r="9"
											stroke="currentColor"
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
										/>
										<path
											stroke="currentColor"
											stroke-linejoin="round"
											stroke-width="3"
											d="M12 16h.01v.01H12z"
										/>
										<path
											stroke="currentColor"
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
											d="M12 12V8"
										/>
									</g>
								</svg>
							);
						}
						case NoticeBoxSeverityEnum.Error: {
							// iconamoon:close-circle-1-duotone
							return (
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width={iconSize}
									height={iconSize}
									viewBox="0 0 24 24"
									aria-hidden="true"
								>
									<g fill="none">
										<circle cx="12" cy="12" r="9" fill="currentColor" opacity="0.2" />
										<circle
											cx="12"
											cy="12"
											r="9"
											stroke="currentColor"
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
										/>
										<path
											stroke="currentColor"
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
											d="m14 10l-4 4m0-4l4 4"
										/>
									</g>
								</svg>
							);
						}
						default: {
							severity satisfies never;
							return;
						}
					}
				})()}
			</div>
		) : undefined
	}
	<div class="py-1 pr-2 pl-1 text-sm">
		<slot />
	</div>
</div>
