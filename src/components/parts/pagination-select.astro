---
import type { HTMLAttributes } from 'astro/types';

import type { Pagination } from '#lib/utils/pagination-types.ts';

import Anchor from '#components/parts/anchor.astro';
import { renderSlot } from '#lib/utils/astro.ts';

interface Props extends HTMLAttributes<'nav'> {
	pagination: Pagination;
}

const { class: className, pagination, ...props } = Astro.props;

const {
	counter,
	label,
	next,
	options,
	placeholder,
	previous,
	selectLabel,
	selectSuffix,
	submitLabel,
} = pagination;

const hasCurrent = options.some((option) => option.isCurrent);

const middleContent = await renderSlot(Astro.slots, 'default');

const isEmptyWithoutScript = !counter && !previous && !next && !middleContent;
---

{options.length > 1 ? (
	<pagination-select class="block" data-nosnippet data-pagefind-ignore>
		<nav
			aria-label={label}
			class:list={[
				'flex flex-wrap items-center justify-between gap-4 text-base font-medium tabular-nums select-none md:text-sm',
				className,
			]}
			hidden={isEmptyWithoutScript}
			{...props}
		>
			<div class="flex items-center">
				{counter ? (
					<span class="text-primary-500 dark:text-primary-600" data-pagination-counter>
						{counter}
					</span>
				) : undefined}
				<form class="flex items-center gap-2" data-pagination-form hidden={true}>
					<span class="relative inline-flex items-center">
						<select
							aria-label={selectLabel}
							autocomplete="off"
							class="pagination-control overflow-hidden rounded-sm border border-primary-300 bg-transparent py-2 pr-6 pl-2 text-ellipsis whitespace-nowrap tabular-nums transition-colors ease-linear hover:border-primary-400 focus-visible:border-primary-400 md:py-1 dark:border-primary-600 dark:bg-primary-900 dark:hover:border-primary-500 dark:focus-visible:border-primary-500"
							data-pagination-control
							name="page"
						>
							{hasCurrent ? undefined : (
								<option disabled={true} hidden={true} selected={true} value="">
									{placeholder ?? selectLabel}
								</option>
							)}
							{options.map((option) => (
								<option
									data-current={option.isCurrent ? '' : undefined}
									selected={option.isCurrent}
									value={option.url}
								>
									{option.label}
								</option>
							))}
						</select>
						<span
							aria-hidden="true"
							class="pagination-arrow pointer-events-none absolute flex items-center text-accent-400 dark:text-accent-400"
						>
							<svg height="16" viewBox="0 0 24 24" width="16">
								<use href="#icon:chevron-down" />
							</svg>
						</span>
					</span>
					{selectSuffix ? (
						<span class="text-primary-500 dark:text-primary-600">{selectSuffix}</span>
					) : undefined}
					<button
						class="pagination-button cursor-pointer rounded px-2 py-2 font-medium text-accent-500 hover:text-accent-300 focus-visible:text-accent-300 md:py-1 dark:text-accent-400 dark:hover:text-accent-300 dark:focus-visible:text-accent-300"
						data-pagination-submit
						type="submit"
					>
						{submitLabel}
					</button>
				</form>
			</div>
			<div class="flex items-center gap-6">
				{previous ? (
					<span class="flex flex-wrap gap-1">
						<span class="text-accent-300 select-none dark:text-accent-400">&lsaquo;</span>
						<Anchor aria-label={previous.ariaLabel} href={previous.url}>
							{previous.label}
						</Anchor>
					</span>
				) : undefined}
				<Fragment set:html={middleContent} />
				{next ? (
					<span class="flex flex-wrap gap-1">
						<Anchor aria-label={next.ariaLabel} href={next.url}>
							{next.label}
						</Anchor>
						<span class="text-accent-300 select-none dark:text-accent-400">&rsaquo;</span>
					</span>
				) : undefined}
			</div>
		</nav>
	</pagination-select>
) : undefined}

<script>
	import '#components/parts/pagination-select.ts';
</script>
