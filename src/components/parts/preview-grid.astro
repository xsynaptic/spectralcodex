---
import { stripDiacritics } from '@spectralcodex/shared/text';

import type { PreviewOptions } from '#components/types.ts';
import type { CatalogItem } from '#lib/catalog/catalog-types.ts';

import Grid from '#components/parts/grid.astro';
import PreviewCard from '#components/parts/preview-card.astro';
import PreviewSubtitle from '#components/parts/preview-subtitle.astro';
import TextMultilingual from '#components/parts/text-multilingual.astro';
import { MicroformatClassNames } from '#components/types.ts';
import { createRegionAncestorsByIdFunction } from '#lib/collections/regions/regions-utils.ts';
import { renderMarkdownInline } from '#lib/utils/text.ts';

interface Props extends PreviewOptions {
	class?: string | undefined;
	items: Array<CatalogItem>;
	showMicroformats?: boolean | undefined;
	titleAs?: 'h2' | 'h3' | undefined;
}

const {
	class: className,
	items,
	showMicroformats = false,
	titleAs,
	...previewOptions
} = Astro.props;

// Rebuilding the ancestor lookup per card is wasteful at build time
const getRegionAncestorsById = await createRegionAncestorsByIdFunction();

function getRegions(item: CatalogItem) {
	if (!previewOptions.showRegion || !item.regionPrimaryId) return;

	return getRegionAncestorsById(item.regionPrimaryId).slice(0, 2).toReversed();
}
---

{
	items.length > 0 ? (
		<Grid class:list={[className, showMicroformats ? MicroformatClassNames.Feed : undefined]}>
			{items.map((item) => (
				<PreviewCard
					imageId={item.imageId}
					linkUrl={item.url}
					alt={item.title}
					showMicroformats={showMicroformats}
					titleAs={titleAs}
				>
					<Fragment slot="preview-title">{stripDiacritics(item.title)}</Fragment>
					{previewOptions.showTitleMultilingual && item.titleMultilingual ? (
						<Fragment slot="preview-title-multilingual">
							<TextMultilingual content={item.titleMultilingual} />
						</Fragment>
					) : undefined}
					<Fragment slot="preview-subtitle">
						<PreviewSubtitle
							item={item}
							regions={getRegions(item)}
							showMicroformats={showMicroformats}
							{...previewOptions}
						/>
					</Fragment>
					{previewOptions.showDescription && item.description ? (
						<Fragment slot="preview-description">
							<Fragment set:html={renderMarkdownInline(item.description)} />
						</Fragment>
					) : undefined}
				</PreviewCard>
			))}
		</Grid>
	) : undefined
}
