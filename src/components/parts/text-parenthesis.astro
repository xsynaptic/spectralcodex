---
import type { HTMLTag, Polymorphic } from 'astro/types';

import { renderSlot } from '#lib/utils/astro.ts';

type Props<Tag extends HTMLTag = HTMLTag> = Polymorphic<{
	after?: string | undefined;
	as: Tag;
	before?: string | undefined;
}>;

const { after = ')', as: Tag = 'span', before = '(', class: className, ...props } = Astro.props;

const content = await renderSlot(Astro.slots, 'default');
---

{content ? (
	<Tag class={className} {...props} set:html={`${before}${content}${after}`} />
) : undefined}
