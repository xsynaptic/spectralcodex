---
import type { HTMLAttributes } from 'astro/types';

import type { DatePreset } from '#lib/utils/date.ts';

import { DatePresetEnum, getDateDisplay } from '#lib/utils/date.ts';

interface Props extends HTMLAttributes<'time'> {
	date: Date;
	dateEnd?: Date | undefined;
	datePreset?: DatePreset;
	dateOptions?: Intl.DateTimeFormatOptions | undefined;
}

const datePresets = {
	[DatePresetEnum.Short]: {
		year: 'numeric',
		month: 'numeric',
		day: 'numeric',
		hour12: false,
		timeZone: 'UTC',
	},
	[DatePresetEnum.Medium]: {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
		hour12: false,
		timeZone: 'UTC',
	},
	[DatePresetEnum.Long]: {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
		hour: 'numeric',
		minute: 'numeric',
		hour12: false,
		timeZone: 'UTC',
		timeZoneName: 'short',
	},
} satisfies Record<DatePreset, Intl.DateTimeFormatOptions>;

const { date, dateEnd, datePreset = DatePresetEnum.Medium, dateOptions, ...props } = Astro.props;

const dateTimeAttribute = date.toISOString();

const formatOptions = { ...datePresets[datePreset], ...dateOptions };

const dateDisplay = getDateDisplay(date, dateEnd, formatOptions);
---

<time datetime={dateTimeAttribute} {...props}>{dateDisplay}</time>
