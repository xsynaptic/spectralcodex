---
import type { HTMLAttributes } from 'astro/types';

import type { DateDisplayOptions, DatePreset } from '#lib/utils/date.ts';

import { DatePresetEnum, getDateDisplay } from '#lib/utils/date.ts';

interface Props extends HTMLAttributes<'time'> {
	date: Date;
	dateEnd?: Date | undefined;
	dateOptions?: DateDisplayOptions | undefined;
	datePreset?: DatePreset;
}

const datePresets = {
	[DatePresetEnum.Long]: {
		day: 'numeric',
		hour: 'numeric',
		hour12: false,
		minute: 'numeric',
		month: 'long',
		timeZoneName: 'short',
		year: 'numeric',
	},
	[DatePresetEnum.Medium]: {
		day: 'numeric',
		hour12: false,
		month: 'long',
		year: 'numeric',
	},
	[DatePresetEnum.Short]: {
		day: 'numeric',
		hour12: false,
		month: 'numeric',
		year: 'numeric',
	},
} satisfies Record<DatePreset, DateDisplayOptions>;

const { date, dateEnd, dateOptions, datePreset = DatePresetEnum.Medium, ...props } = Astro.props;

const dateTimeAttribute = date.toISOString();

const formatOptions = { ...datePresets[datePreset], ...dateOptions };

const dateDisplay = getDateDisplay(date, dateEnd, formatOptions);
---

<time datetime={dateTimeAttribute} {...props}>
	{dateDisplay}
</time>
