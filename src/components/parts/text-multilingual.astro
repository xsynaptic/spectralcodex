---
import type { HTMLTag, Polymorphic } from 'astro/types';

import type { MultilingualContent } from '#lib/i18n/i18n-types.ts';

import TextParenthesis from '#components/parts/text-parenthesis.astro';
import { isCjkLanguage } from '#lib/i18n/i18n-utils.ts';

type Props<Tag extends HTMLTag = HTMLTag> = Polymorphic<{
	additional?: Array<MultilingualContent> | undefined;
	as: Tag;
	content?: MultilingualContent | undefined;
	parenthesis?: boolean | undefined;
}>;

const {
	additional,
	as: Tag = 'span',
	class: className,
	content,
	parenthesis = false,
	...props
} = Astro.props;

const segments = content && !parenthesis ? [content, ...(additional ?? [])] : [];
---

{content && parenthesis ? (
	<>
		{' '}
		<TextParenthesis as={Tag} class={className}>
			<Tag
				class:list={[isCjkLanguage(content.lang) ? 'cjk-text' : undefined]}
				lang={content.lang}
				{...props}
				set:html={content.value.trim()}
			/>
		</TextParenthesis>
	</>
) : undefined}
{segments.map((segment, index) => (
	<>
		{index > 0 ? '／' : undefined}
		<Tag
			class:list={[className, isCjkLanguage(segment.lang) ? 'cjk-text' : undefined]}
			lang={segment.lang}
			{...props}
			set:html={segment.value.trim()}
		/>
	</>
))}
