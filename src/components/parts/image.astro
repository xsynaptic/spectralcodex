---
import { Image as UnpicImage } from '@unpic/astro/base';
import { IMAGE_SERVER_SECRET, IMAGE_SERVER_URL } from 'astro:env/server';

import type { ImageComponentProps } from '#lib/image/image-types.ts';

import { imageLowQualityFormat, imageLowQualityValue } from '#constants.ts';
import { createImageUrlFunction } from '#lib/image/image-server.ts';

type Props = ImageComponentProps;

const {
	class: className,
	imageFormat = imageLowQualityFormat,
	imageQuality = imageLowQualityValue,
	...props
} = Astro.props;

const transformer = createImageUrlFunction({
	imageFormat,
	imageQuality,
	serverSecret: IMAGE_SERVER_SECRET,
	serverUrl: IMAGE_SERVER_URL,
});
---

<UnpicImage
	{...props}
	class:list={['image-element', 'w-full object-cover', className]}
	transformer={transformer}
/>
