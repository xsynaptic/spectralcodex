---
import type { CatalogItem } from '#lib/catalog/catalog-types.ts';

import Anchor from '#components/parts/anchor.astro';
import TextMultilingual from '#components/parts/text-multilingual.astro';
import TextSeparated from '#components/parts/text-separated.astro';
import { getTranslations } from '#lib/i18n/i18n-translations.ts';
import { formatNumber, formatStringTemplate } from '#lib/utils/text.ts';

interface Props {
	count?: number | undefined;
	countThreshold?: number | undefined;
	items: Array<CatalogItem>;
	url?: string | undefined;
}

const { count, countThreshold = 10, items, url, ...props } = Astro.props;

const shouldShowCount = count ? Math.abs(items.length - count) > countThreshold : false;

const t = getTranslations();

function getCountText() {
	if (shouldShowCount && count) {
		return {
			title: formatStringTemplate(t('parts.textSeparatedList.more'), {
				count: formatNumber({
					number: count - items.length,
					options: { maximumFractionDigits: 0 },
				}),
			}),
			titleMultilingual: undefined,
			url,
		};
	}
	return;
}

const countText = getCountText();

const listItems = countText ? [...items, countText] : items;
---

{listItems.map((item, index) => (
	<TextSeparated index={index} total={listItems.length} {...props}>
		{item.url ? (
			<>
				<Anchor href={item.url}>{item.title}</Anchor>
				<TextMultilingual content={item.titleMultilingual} parenthesis={true} />
			</>
		) : (
			item.title
		)}
	</TextSeparated>
))}
