---
import type { PreviewOptions } from '#components/types.ts';
import type { CatalogItem } from '#lib/catalog/catalog-types.ts';
import type { ComputedEntry } from '#lib/collections/collections-types.ts';

import Anchor from '#components/parts/anchor.astro';
import DateDisplay from '#components/parts/date-display.astro';
import DividedItem from '#components/parts/divided-item.astro';
import { MicroformatClassNames } from '#components/types.ts';
import { getTranslations } from '#lib/i18n/i18n-translations.ts';
import { getContentPath, getSitePath } from '#lib/utils/routing.ts';
import { formatNumber } from '#lib/utils/text.ts';

interface Props extends PreviewOptions {
	item: CatalogItem;
	regions?: Array<ComputedEntry<'regions'>> | undefined;
	showMicroformats?: boolean | undefined;
}

const {
	item,
	regions,
	showCollection,
	showDate,
	showLocations,
	showMicroformats = false,
	showPosts,
} = Astro.props;

const indexUrl = getSitePath(item.collection);

const t = getTranslations();

const counts = [
	{
		isShown: showLocations,
		label: t('collection.locations.labelPlural'),
		number: item.locationCount ?? 0,
	},
	{ isShown: showPosts, label: t('collection.posts.labelPlural'), number: item.postCount ?? 0 },
].filter((count) => count.isShown && count.number > 0);
---

{showCollection ? (
	<DividedItem>
		{indexUrl ? (
			<Anchor class="font-semibold" href={indexUrl} showDarkMode={false}>
				{t(`collection.${item.collection}.labelSingular`)}
			</Anchor>
		) : (
			<div class="font-semibold">{t(`collection.${item.collection}.labelSingular`)}</div>
		)}
	</DividedItem>
) : undefined}
{regions && regions.length > 0 ? (
	<DividedItem>
		{regions.map((region) => (
			<DividedItem dividerContent="chevron">
				<Anchor href={getContentPath('regions', region.id)} showDarkMode={false}>
					{region.data.title}
				</Anchor>
			</DividedItem>
		))}
	</DividedItem>
) : undefined}
{counts.map((count) => (
	<DividedItem>
		<span set:html={`${count.label}: ${formatNumber({ number: count.number })}`} />
	</DividedItem>
))}
{showDate ? (
	<DividedItem>
		<DateDisplay
			class:list={[showMicroformats ? MicroformatClassNames.DatePublished : undefined]}
			date={item.dateUpdated ?? item.dateCreated}
		/>
	</DividedItem>
) : undefined}
