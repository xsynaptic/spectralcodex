---
import type { HTMLAttributes } from 'astro/types';

import { renderSlot } from '#lib/utils/astro.ts';

type AnchorColor = 'accent' | 'highlight' | 'primary' | 'primary-bright' | 'title';

interface Props extends HTMLAttributes<'a'> {
	anchorColor?: AnchorColor | undefined;
	isActive?: boolean | undefined;
	showDarkMode?: boolean | undefined;
}

const {
	class: className,
	href,
	anchorColor = 'accent',
	isActive = false,
	showDarkMode = true,
	...props
} = Astro.props;

const children = await renderSlot(Astro.slots, 'default');
---

<a
	href={href}
	class:list={[
		'anchor-base',
		`anchor-${anchorColor}`,
		isActive ? 'anchor-active' : undefined,
		showDarkMode ? undefined : 'anchor-static',
		className,
	]}
	{...props}><Fragment set:html={children} /></a
>
