---
import type { AxisTick, PagesGeometry } from '#lib/build-stats/build-stats-geometry.ts';

import BuildStatsChart from '#components/build-stats/build-stats-chart.astro';
import BuildStatsEndpoint from '#components/build-stats/build-stats-endpoint.astro';
import { pagesFrame } from '#lib/build-stats/build-stats-geometry.ts';
import { getTranslations } from '#lib/i18n/i18n-translations.ts';

interface Props {
	axisTicks: Array<AxisTick>;
	geometry: PagesGeometry;
}

const { axisTicks, geometry } = Astro.props;

const t = getTranslations();

const tooltipRows = [{ label: t('buildStats.tooltip.pages'), series: 'pages' }];
---

<BuildStatsChart
	ariaLabel={t('buildStats.chart.pages.aria')}
	axisTicks={axisTicks}
	frame={pagesFrame}
	label={t('buildStats.chart.pages.label')}
	points={geometry.points}
	series="pages"
	tooltipRows={tooltipRows}
	valueTicks={geometry.ticks}
>
	<path class="stats-area stats-series-pages" d={geometry.areaPath}></path>
	<path class="stats-line stats-series-pages" d={geometry.linePath}></path>
	<BuildStatsEndpoint end={geometry.end} series="pages" />
</BuildStatsChart>
