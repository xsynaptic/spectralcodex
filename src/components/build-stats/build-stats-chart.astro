---
import type {
	AxisTick,
	ChartFrame,
	TooltipPoint,
	ValueTick,
} from '#lib/build-stats/build-stats-geometry.ts';

import { buildStatsLayout } from '#lib/build-stats/build-stats-geometry.ts';

interface Props {
	ariaLabel: string;
	axisTicks: Array<AxisTick>;
	frame: ChartFrame;
	label: string;
	points: Array<TooltipPoint>;
	series: 'duration' | 'pages';
	tooltipRows: Array<{ label: string; series: string }>;
	valueTicks: Array<ValueTick>;
}

const { series, label, ariaLabel, frame, axisTicks, valueTicks, tooltipRows, points } = Astro.props;

const { width, marginLeft, marginRight, headingY, monthLabelOffset, yearLabelOffset } =
	buildStatsLayout;

const plotRight = width - marginRight;

const hitLeft = points.at(0)?.x ?? marginLeft;
const hitRight = points.at(-1)?.x ?? plotRight;

// Escaped so no value can close the script tag it is injected into
const tooltipData = JSON.stringify(points)
	.replaceAll('<', String.raw`\u003c`)
	.replaceAll('>', String.raw`\u003e`)
	.replaceAll('&', String.raw`\u0026`);
---

<script>
	import '#components/build-stats/build-stats-chart.ts';
</script>

<build-stats-chart class="stats-chart">
	<div class="stats-frame">
		<svg
			aria-label={ariaLabel}
			class="stats-plot"
			height={frame.height}
			role="img"
			viewBox={`0 0 ${String(width)} ${String(frame.height)}`}
			width={width}
		>
			<text class="stats-chart-label" x={marginLeft} y={headingY}>
				{label}
			</text>
			{axisTicks.map((tick) => (
				<line
					class="stats-grid stats-grid-month"
					x1={tick.x}
					x2={tick.x}
					y1={frame.top}
					y2={frame.bottom}
				/>
			))}
			{valueTicks.map((tick) => (
				<Fragment>
					<line class="stats-grid" x1={marginLeft} x2={plotRight} y1={tick.y} y2={tick.y} />
					<text class="stats-tick" text-anchor="end" x={marginLeft - 10} y={tick.y + 3.5}>
						{tick.label}
					</text>
				</Fragment>
			))}
			<slot />
			<line
				class="stats-axis"
				x1={marginLeft}
				x2={plotRight}
				y1={frame.bottom}
				y2={frame.bottom}
			></line>
			{axisTicks.map((tick) => (
				<Fragment>
					<line
						class="stats-grid"
						x1={tick.x}
						x2={tick.x}
						y1={frame.bottom}
						y2={frame.bottom + 5}
					/>
					<text
						class="stats-tick"
						text-anchor="middle"
						x={tick.x}
						y={frame.bottom + monthLabelOffset}
					>
						{tick.label}
					</text>
					{tick.yearLabel ? (
						<text
							class="stats-tick"
							text-anchor="middle"
							x={tick.x}
							y={frame.bottom + yearLabelOffset}
						>
							{tick.yearLabel}
						</text>
					) : undefined}
				</Fragment>
			))}
			<g aria-hidden="true" class="stats-crosshair" data-chart-crosshair>
				<line class="stats-axis" data-crosshair-line y1={frame.top} y2={frame.bottom}></line>
				<circle
					class:list={['stats-endpoint', `stats-series-${series}`]}
					data-crosshair-dot
					r="4"
				></circle>
			</g>
			<rect
				data-chart-hit
				fill="transparent"
				height={frame.bottom - frame.top}
				width={hitRight - hitLeft}
				x={hitLeft}
				y={frame.top}
			></rect>
		</svg>
	</div>
	<div aria-hidden="true" class="stats-tooltip" data-chart-tooltip>
		<div class="stats-tooltip-date" data-tooltip-date></div>
		{tooltipRows.map((row) => (
			<div class="stats-tooltip-row" data-tooltip-row>
				<span class="stats-tooltip-key">
					<span class:list={['stats-swatch', `stats-swatch-${row.series}`]} />
					{row.label}
				</span>
				<b data-tooltip-value />
			</div>
		))}
	</div>
	<script data-chart-tooltips is:inline set:html={tooltipData} type="application/json"></script>
</build-stats-chart>
