---
import type { CatalogItem } from '#lib/catalog/catalog-types.ts';

import ContentSection from '#components/content/content-section.astro';
import Anchor from '#components/parts/anchor.astro';
import ListColumnItem from '#components/parts/list-column-item.astro';
import ListColumn from '#components/parts/list-column.astro';
import TextMultilingual from '#components/parts/text-multilingual.astro';
import { getTranslations } from '#lib/i18n/i18n-translations.ts';

// Well-connected entries have hundreds of backlinks; the list is a sample, not an inventory
const BACKLINKS_DISPLAY_LIMIT = 10;

interface Props {
	backlinks: Array<CatalogItem> | undefined;
	limit?: number;
}

const { backlinks: backlinksAll, limit = BACKLINKS_DISPLAY_LIMIT, ...props } = Astro.props;

const backlinks = backlinksAll?.slice(0, limit);

const t = getTranslations();
---

{
	backlinks && backlinks.length > 0 ? (
		<ContentSection data-pagefind-ignore data-nosnippet {...props}>
			<Fragment slot="section-title">{t('section.backlinks')}</Fragment>
			<ListColumn class="font-serif text-xs sm:text-sm">
				{backlinks.map(({ url, title, titleMultilingual }) => (
					<ListColumnItem>
						<Anchor href={url}>{title}</Anchor>
						{titleMultilingual ? (
							<TextMultilingual
								content={titleMultilingual}
								parenthesis={true}
								class="text-primary-600 dark:text-primary-400"
							/>
						) : undefined}
					</ListColumnItem>
				))}
			</ListColumn>
		</ContentSection>
	) : undefined
}
