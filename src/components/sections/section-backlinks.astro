---
import type { HTMLAttributes } from 'astro/types';

import type { CatalogItem } from '#lib/catalog/catalog-types.ts';

import ContentSection from '#components/content/content-section.astro';
import PreviewColumn from '#components/parts/preview-column.astro';
import { getTranslations } from '#lib/i18n/i18n-translations.ts';

// Well-connected entries have hundreds of backlinks; the list is a sample, not an inventory
const backlinksDisplayLimit = 10;

interface Props extends HTMLAttributes<'div'> {
	backlinks: Array<CatalogItem> | undefined;
	limit?: number;
}

const { backlinks: backlinksAll, limit = backlinksDisplayLimit, ...props } = Astro.props;

const backlinks = backlinksAll?.slice(0, limit) ?? [];

const t = getTranslations();
---

<ContentSection
	sectionTitle={t('section.backlinks')}
	data-pagefind-ignore
	data-nosnippet
	{...props}
>
	<PreviewColumn items={backlinks} />
</ContentSection>
