---
import type { HTMLAttributes } from 'astro/types';
import type { CollectionEntry } from 'astro:content';

import ContentSection from '#components/content/content-section.astro';
import ResourcesLinks from '#components/resources/resources-links.astro';
import { createResolveResourceLinksFunction } from '#lib/collections/resources/resources-utils.ts';
import { getTranslations } from '#lib/i18n/i18n-translations.ts';

interface Props extends HTMLAttributes<'div'> {
	entry: CollectionEntry<'locations' | 'posts' | 'regions' | 'resources' | 'themes'>;
}

const { entry, ...props } = Astro.props;

const getResolveResourceLinks = await createResolveResourceLinksFunction();

const links = getResolveResourceLinks(entry) ?? [];

const t = getTranslations();
---

<ContentSection data-nosnippet data-pagefind-ignore sectionTitle={t('section.links')} {...props}>
	<ResourcesLinks links={links} />
</ContentSection>
