---
import type { HTMLAttributes } from 'astro/types';

import type { ComputedEntry } from '#lib/collections/collections-types.ts';

import ContentSection from '#components/content/content-section.astro';
import ResourcesSources from '#components/resources/resources-sources.astro';
import { createResolveResourceSourcesFunction } from '#lib/collections/resources/resources-data.ts';
import { getTranslations } from '#lib/i18n/i18n-translations.ts';

interface Props extends HTMLAttributes<'div'> {
	entry: ComputedEntry<'locations' | 'posts' | 'regions' | 'themes'>;
}

const { entry, ...props } = Astro.props;

const getResolveResourceSources = await createResolveResourceSourcesFunction();

const sources = getResolveResourceSources(entry) ?? [];

const t = getTranslations();
---

<ContentSection data-nosnippet data-pagefind-ignore sectionTitle={t('section.sources')} {...props}>
	<ResourcesSources sources={sources} />
</ContentSection>
