---
import ContentSection from '#components/content/content-section.astro';
import Anchor from '#components/parts/anchor.astro';
import DividedItem from '#components/parts/divided-item.astro';
import ListRow from '#components/parts/list-row.astro';
import TextMultilingual from '#components/parts/text-multilingual.astro';
import { MicroformatClassNames } from '#components/types.ts';
import { createThemesByIdsFunction } from '#lib/collections/themes/themes-utils.ts';
import { getTranslations } from '#lib/i18n/i18n-translations.ts';
import { getMultilingualContent } from '#lib/i18n/i18n-utils.ts';
import { sortByEntryCount } from '#lib/utils/collections.ts';
import { getContentUrl } from '#lib/utils/routing.ts';

interface Props {
	themeIds: Array<string> | undefined;
}

const { themeIds, ...props } = Astro.props;

const getThemesByIds = await createThemesByIdsFunction();

const themes = themeIds ? getThemesByIds(themeIds).sort(sortByEntryCount) : undefined;

const t = getTranslations();
---

{
	themes && themes.length > 0 ? (
		<ContentSection data-pagefind-ignore data-nosnippet {...props}>
			<Fragment slot="section-title">{t('collection.themes.labelPlural')}</Fragment>
			<ListRow>
				{themes.map((item) => {
					const titleMultilingual = getMultilingualContent({
						data: item.data,
						prop: 'title',
					})?.primary;

					return (
						<DividedItem
							as="li"
							dividerWeight="thin"
							class:list={['font-serif text-sm', MicroformatClassNames.Category]}
							data-pagefind-filter="theme"
						>
							{item.data.title ? (
								<Anchor href={getContentUrl(item.collection, item.id)}>{item.data.title}</Anchor>
							) : undefined}
							{titleMultilingual ? (
								<TextMultilingual content={titleMultilingual} parenthesis={true} />
							) : undefined}
						</DividedItem>
					);
				})}
			</ListRow>
		</ContentSection>
	) : undefined
}
