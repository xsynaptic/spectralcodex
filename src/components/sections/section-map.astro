---
import type { MapComponentData } from '@spectralcodex/react-map-component';
import type { HTMLAttributes } from 'astro/types';

import ContentSection from '#components/content/content-section.astro';
import MapComponent from '#components/map/map-component.astro';
import { getTranslations } from '#lib/i18n/i18n-translations.ts';

interface Props extends HTMLAttributes<'div'> {
	mapData: MapComponentData;
	entryTitle?: string | undefined;
}

const {
	mapData: { hasGeodata, ...mapComponentProps },
	entryTitle,
	...props
} = Astro.props;

const t = getTranslations();
---

{hasGeodata ? (
	<ContentSection
		sectionTitle={t('section.map')}
		fillViewport={true}
		data-pagefind-ignore
		data-nosnippet
		{...props}
	>
		<MapComponent mapComponentProps={mapComponentProps} entryTitle={entryTitle} />
		<slot />
	</ContentSection>
) : undefined}
