---
import type { HTMLAttributes } from 'astro/types';

import type { MapComponentData } from '#lib/map/map-types.ts';

import ContentSection from '#components/content/content-section.astro';
import MapComponent from '#components/map/map-component.astro';
import { getTranslations } from '#lib/i18n/i18n-translations.ts';

interface Props extends HTMLAttributes<'div'> {
	entryTitle?: string | undefined;
	mapData: MapComponentData;
	showAtlasOpen?: boolean | undefined;
}

const {
	entryTitle,
	mapData: { hasGeodata, props: mapComponentProps },
	showAtlasOpen = false,
	...props
} = Astro.props;

const t = getTranslations();
---

{hasGeodata ? (
	<ContentSection
		data-nosnippet
		data-pagefind-ignore
		fillViewport={true}
		sectionTitle={t('section.map')}
		{...props}
	>
		<MapComponent
			entryTitle={entryTitle}
			mapComponentProps={{
				...mapComponentProps,
				...(showAtlasOpen
					? {
							controls: ['enter'],
							messages: { enterAriaLabel: t('atlas.open.label') },
						}
					: {}),
			}}
		/>
	</ContentSection>
) : undefined}
