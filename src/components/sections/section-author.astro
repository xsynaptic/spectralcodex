---
import type { HTMLAttributes } from 'astro/types';

import ContentSection from '#components/content/content-section.astro';
import AuthorCard from '#components/parts/author-card.astro';
import AuthorPhoto from '#components/parts/author-photo.astro';
import CardFrame from '#components/parts/card-frame.astro';
import Prose from '#components/parts/prose.astro';
import { MicroformatClassNames } from '#components/types.ts';
import { getTranslations } from '#lib/i18n/i18n-translations.ts';
import { ImageFitOptionEnum } from '#lib/image/image-types.ts';
import { renderMarkdownInline } from '#lib/utils/text.ts';

type Props = HTMLAttributes<'div'> & {
	showAuthor?: boolean | undefined;
};

const { class: className, showAuthor = false, ...props } = Astro.props;

const t = getTranslations();
---

<ContentSection
	sectionTitle={t('section.author')}
	class:list={[
		showAuthor ? undefined : 'sr-only',
		MicroformatClassNames.Card,
		MicroformatClassNames.Author,
		className,
	]}
	data-pagefind-ignore
	data-nosnippet
	{...props}
>
	<div class="flex items-start gap-4">
		<CardFrame class:list={['w-[90px] shrink-0 sm:w-[150px] md:w-[200px]']}>
			<AuthorPhoto
				sizes="auto, (max-width: 640px) 150px, 150px"
				operations={{ fit: ImageFitOptionEnum.Cover }}
			/>
			<AuthorCard />
		</CardFrame>
		<Prose>
			<Fragment set:html={renderMarkdownInline(t('author.description'))} />
		</Prose>
	</div>
</ContentSection>
