---
import type { Page } from 'astro';
import type { HTMLAttributes } from 'astro/types';

import type { PreviewOptions } from '#components/types.ts';
import type { CatalogItem } from '#lib/catalog/catalog-types.ts';

import ContentSection from '#components/content/content-section.astro';
import PaginationSelect from '#components/parts/pagination-select.astro';
import PreviewGrid from '#components/parts/preview-grid.astro';
import { getTranslations } from '#lib/i18n/i18n-translations.ts';
import { getPagination } from '#lib/utils/pagination.ts';

interface Props extends HTMLAttributes<'div'> {
	items?: Array<CatalogItem>;
	page?: Page<CatalogItem>;
	previewOptions?: PreviewOptions | undefined;
	sectionTitle?: string;
	showMicroformats?: boolean | undefined;
}

const {
	sectionTitle,
	items,
	page,
	previewOptions,
	showMicroformats = false,
	...props
} = Astro.props;

const defaultPreviewOptions: PreviewOptions = {
	showDate: true,
	showRegion: true,
	showTitleMultilingual: true,
};

const t = getTranslations();
---

<ContentSection
	data-nosnippet
	data-pagefind-ignore
	sectionTitle={sectionTitle ?? t('section.content')}
	{...props}
>
	{page ? (
		<>
			<PreviewGrid
				items={page.data}
				showMicroformats={showMicroformats}
				{...defaultPreviewOptions}
				{...previewOptions}
			/>
			<PaginationSelect class="mt-4 md:mt-8" pagination={getPagination(page)} />
		</>
	) : undefined}
	{items ? (
		<PreviewGrid
			items={items}
			showMicroformats={showMicroformats}
			{...defaultPreviewOptions}
			{...previewOptions}
		/>
	) : undefined}
</ContentSection>
