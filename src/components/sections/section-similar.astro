---
import type { HTMLAttributes } from 'astro/types';
import type { CollectionEntry, CollectionKey } from 'astro:content';

import ContentSection from '#components/content/content-section.astro';
import PreviewColumn from '#components/parts/preview-column.astro';
import PreviewGrid from '#components/parts/preview-grid.astro';
import { getSimilarContentFunction } from '#components/sections/section-similar.ts';
import { getTranslations } from '#lib/i18n/i18n-translations.ts';

interface Props extends HTMLAttributes<'div'> {
	entry: CollectionEntry<CollectionKey>;
	limit?: number | undefined;
	showPreviews?: boolean | undefined;
	threshold?: number;
}

const { entry, limit = 10, showPreviews, threshold = 0.5, ...props } = Astro.props;

const getSimilarContent = await getSimilarContentFunction();

const similarContentItems = getSimilarContent({
	id: entry.id,
	limit,
	threshold,
});

const t = getTranslations();
---

<ContentSection data-nosnippet data-pagefind-ignore sectionTitle={t('section.similar')} {...props}>
	{showPreviews ? (
		<PreviewGrid
			items={similarContentItems}
			showDate={true}
			showRegion={true}
			showTitleMultilingual={true}
		/>
	) : (
		<PreviewColumn items={similarContentItems} />
	)}
</ContentSection>
