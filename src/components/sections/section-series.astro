---
import type { HTMLAttributes } from 'astro/types';
import type { CollectionEntry } from 'astro:content';

import { render } from 'astro:content';

import SeriesSection from '#components/series/series-section.astro';
import { createSeriesByIdFunction } from '#lib/collections/series/series-utils.ts';
import { getContentUrl } from '#lib/utils/routing.ts';

interface Props extends HTMLAttributes<'div'> {
	entry: CollectionEntry<'locations' | 'posts'>;
}

const { entry, ...props } = Astro.props;

const getSeriesById = await createSeriesByIdFunction();

const seriesData = getSeriesById({ collection: entry.collection, id: entry.id });
---

{
	seriesData.map(async ({ entry: seriesEntry, catalogItems }) => {
		const { Content } = await render(seriesEntry);

		return catalogItems.length > 0 ? (
			<SeriesSection
				items={catalogItems}
				seriesTitle={seriesEntry.data.title}
				url={getContentUrl(seriesEntry.collection, seriesEntry.id)}
				{...props}
			>
				<Content />
			</SeriesSection>
		) : undefined;
	})
}
