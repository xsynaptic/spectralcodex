---
import type { HTMLAttributes } from 'astro/types';

import { render } from 'astro:content';

import type { ComputedEntry } from '#lib/collections/collections-types.ts';

import SeriesSection from '#components/series/series-section.astro';
import { createSeriesByEntryFunction } from '#lib/collections/series/series-queries.ts';
import { getContentPath } from '#lib/utils/routing.ts';

interface Props extends HTMLAttributes<'div'> {
	entry: ComputedEntry<'locations' | 'posts'>;
}

const { entry, ...props } = Astro.props;

const getSeriesByEntry = await createSeriesByEntryFunction();

const seriesData = getSeriesByEntry({ collection: entry.collection, id: entry.id });
---

{seriesData.map(async ({ catalogItems, entry: seriesEntry }) => {
	const { Content } = await render(seriesEntry);

	return catalogItems.length > 0 ? (
		<SeriesSection
			items={catalogItems}
			seriesTitle={seriesEntry.data.title}
			url={getContentPath(seriesEntry.collection, seriesEntry.id)}
			{...props}
		>
			<Content />
		</SeriesSection>
	) : undefined;
})}
