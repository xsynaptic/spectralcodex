---
import type { MapComponentProps } from '@spectralcodex/react-map-component';
import type { HTMLAttributes } from 'astro/types';

import { ReactMapComponent } from '@spectralcodex/react-map-component';
import mapCssUrl from '@spectralcodex/react-map-component/styles/map-component.css?url';

import MapComponentSprites from '#components/map/map-component-sprites.astro';
import { getTranslations } from '#lib/i18n/i18n-translations.ts';
import { formatStringTemplate } from '#lib/utils/text.ts';

interface Props extends HTMLAttributes<'div'> {
	entryTitle?: string | undefined;
	mapComponentProps: MapComponentProps;
}

const { entryTitle, mapComponentProps, ...props } = Astro.props;

const t = getTranslations();

// Local to the map's own stacking context; the React component needs a number, not a class
const zIndex = 10;
---

<link href={mapCssUrl} rel="stylesheet" />
<MapComponentSprites />
<div
	aria-label={
		entryTitle ? formatStringTemplate(t('section.map.label'), { title: entryTitle }) : undefined
	}
	class:list={[
		'bg-fallback',
		'relative flex h-full max-h-screen min-h-[min(600px,100vh)] overflow-hidden shadow-sm sm:rounded-xs lg:rounded-md',
		'shadow-primary-300 dark:shadow-primary-900',
	]}
	role={entryTitle ? 'group' : undefined}
	{...props}
	data-pagefind-ignore
>
	<ReactMapComponent {...mapComponentProps} client:visible style={{ zIndex: zIndex + 1 }} />
	<div
		class:list={[
			'map-loading absolute flex h-full w-full justify-center',
			'text-primary-700 dark:text-highlight-400',
		]}
		role="status"
		style={{ zIndex }}
	>
		<span class="map-loading-label sr-only">{t('section.map.loading')}</span>
		<div class="loading-animation w-1/5"></div>
	</div>
</div>
