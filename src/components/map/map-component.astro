---
import type { MapComponentProps } from '@spectralcodex/react-map-component';
import type { HTMLAttributes } from 'astro/types';

import { ReactMapComponent } from '@spectralcodex/react-map-component';
import mapCssUrl from '@spectralcodex/react-map-component/styles/map-component.css?url';

import MapComponentSprites from '#components/map/map-component-sprites.astro';

interface Props extends HTMLAttributes<'div'> {
	mapComponentProps: MapComponentProps;
}

const { mapComponentProps, ...props } = Astro.props;

// Local to the map's own stacking context; the React component needs a number, not a class
const zIndex = 10;
---

<link rel="stylesheet" href={mapCssUrl} />
<MapComponentSprites />
<div
	class:list={[
		'bg-fallback',
		'max-h-100vh relative flex h-full min-h-[min(600px,100vh)] overflow-hidden shadow-sm sm:rounded-xs lg:rounded-md',
		'shadow-primary-300 dark:shadow-primary-900',
	]}
	{...props}
	data-pagefind-ignore
>
	<ReactMapComponent {...mapComponentProps} style={{ zIndex: zIndex + 1 }} client:visible />
	<div
		class:list={[
			'absolute flex h-full w-full justify-center',
			'text-primary-700 dark:text-highlight-400',
		]}
		style={{ zIndex }}
	>
		<div class="loading-animation w-[20%]"></div>
	</div>
</div>
