{
	"ignorePatterns": [
		"packages/scripts/src/validate-content/fixtures/**",
		// Docker build context with its own package.json; fallow reads it as an undeclared workspace
		"deploy/**",
	],
	"rulePacks": ["fallow-rules.jsonc"],
	"rules": {
		// Dead code and dependency hygiene belong to knip
		"unused-files": "off",
		"unused-exports": "off",
		"unused-types": "off",
		"unused-enum-members": "off",
		"unused-class-members": "off",
		"unused-dependencies": "off",
		"unused-dev-dependencies": "off",
		"unused-optional-dependencies": "off",
		"unlisted-dependencies": "off",
		"unresolved-imports": "off",
		"duplicate-exports": "off",
		"type-only-dependencies": "off",
		"test-only-dependencies": "off",
		"dev-dependencies-in-production": "off",
		"unused-dependency-overrides": "off",
		"misconfigured-dependency-overrides": "off",
		"re-export-cycle": "error",
		"package-cycle": "error",
	},
	"health": {
		// Zero disables CRAP; without Istanbul data fallow estimates coverage from the module graph
		"maxCrap": 0,
		"ignore": ["src/dev/**"],
		// Cognitive ceilings sit at the measured score plus 2; re-measure on a deliberate change, never raise one to clear a failure
		"thresholdOverrides": [
			{
				"files": ["src/components/content/content-section.astro"],
				"functions": ["<template>"],
				"maxCognitive": 32,
				"reason": "Flat optional slots and class switches",
			},
			{
				"files": ["src/components/content/content-header.astro"],
				"functions": ["<template>"],
				"maxCognitive": 22,
				"reason": "Flat optional slots and class switches",
			},
			{
				"files": ["src/components/image/image-carousel-caption.astro"],
				"functions": ["<template>"],
				"maxCognitive": 22,
				"reason": "Flat optional slots and class switches",
			},
		],
	},
	"duplicates": {
		"minTokens": 40,
		// A threshold of zero means no limit; this fails on any clone group
		"threshold": 0.01,
	},
	// On-demand semantic pass; the 0.80 default is mostly shared idiom, not shared logic
	"similarCode": { "threshold": 0.9 },
	"boundaries": {
		// First match wins, so the map package's zones sit before `packages`
		"zones": [
			{
				"name": "map-ui",
				"patterns": [
					"packages/react-map-component/src/index.ts",
					"packages/react-map-component/src/react-map-component.tsx",
					"packages/react-map-component/src/canvas/**",
					"packages/react-map-component/src/controls/**",
					"packages/react-map-component/src/popup/**",
					"packages/react-map-component/src/search/**",
					"packages/react-map-component/src/source/**",
					"packages/react-map-component/src/targets/**",
				],
			},
			{
				"name": "map-state",
				"patterns": [
					"packages/react-map-component/src/data/**",
					"packages/react-map-component/src/host/**",
					"packages/react-map-component/src/store/**",
				],
			},
			{ "name": "map-base", "patterns": ["packages/react-map-component/src/**"] },
			{ "name": "packages", "patterns": ["packages/**"] },
			// Dev-only routes; no other zone may import them
			{ "name": "dev", "patterns": ["src/dev/**"] },
			// The read path sits below the Catalog and Map Directory, which import it
			{
				"name": "assembly",
				"patterns": [
					"src/lib/catalog/**",
					"src/lib/map/**",
					"src/lib/collections/*/*-queries.ts",
					"src/lib/collections/chronology/chronology-data.ts",
				],
			},
			{ "name": "read-path", "patterns": ["src/lib/collections/*/*-data.ts"] },
			{ "name": "lib", "patterns": ["src/lib/**", "src/constants.ts", "src/types/**"] },
			{
				"name": "components",
				"patterns": [
					"src/components/**",
					"src/layouts/**",
					"src/pages/**",
					"src/styles/**",
					"src/content.config.ts",
				],
			},
		],
		// Unzoned files are unrestricted both ways, so every analyzed file needs a zone
		"coverage": {
			"requireAllFiles": true,
			"allowUnmatched": ["*.config.{ts,mjs}", "tests/**"],
		},
		// Imports within a zone are always allowed
		"rules": [
			{ "from": "map-ui", "allow": ["map-state", "map-base", "packages"] },
			{ "from": "map-state", "allow": ["map-base", "packages"] },
			{ "from": "map-base", "allow": ["packages"] },
			// Vite/Rolldown build breaks when packages import the app
			{ "from": "packages", "allow": [] },
			{ "from": "read-path", "allow": ["lib", "packages"] },
			{ "from": "assembly", "allow": ["read-path", "lib", "packages", "map-ui", "map-base"] },
			{ "from": "lib", "allow": ["assembly", "read-path", "packages", "map-ui", "map-base"] },
			{
				"from": "components",
				"allow": ["lib", "assembly", "read-path", "packages", "map-ui", "map-base"],
			},
		],
	},
}
