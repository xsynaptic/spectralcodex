{
	"ignorePatterns": ["packages/scripts/src/validate-content/fixtures/**", "deploy/**"],
	"rulePacks": ["fallow-rules.jsonc"],
	// MDX components load by auto-import, which fallow can't follow, and rule packs skip what they can't reach
	"dynamicallyLoaded": ["src/components/mdx/*.astro"],
	"rules": {
		// knip already covers dead code and dependencies, so fallow stays out of it
		"unused-files": "off",
		"unused-exports": "off",
		"unused-types": "off",
		"unused-enum-members": "off",
		"unused-class-members": "off",
		"unused-dependencies": "off",
		"unused-dev-dependencies": "off",
		"unused-optional-dependencies": "off",
		"unlisted-dependencies": "off",
		"unresolved-imports": "off",
		"duplicate-exports": "off",
		"type-only-dependencies": "off",
		"test-only-dependencies": "off",
		"dev-dependencies-in-production": "off",
		"unused-dependency-overrides": "off",
		"misconfigured-dependency-overrides": "off",
		"re-export-cycle": "error",
		"package-cycle": "error",
	},
	"health": {
		// CRAP is off; without Istanbul data fallow would only be guessing at coverage from the module graph
		"maxCrap": 0,
		"maxCognitive": 12,
		"ignore": ["src/dev/**"],
		// Each ceiling is the measured score plus two; re-measure after a deliberate change, but never raise one just to pass
		"thresholdOverrides": [
			{
				"files": ["src/components/content/content-section.astro"],
				"functions": ["<template>"],
				"maxCognitive": 32,
				"reason": "Many optional slots and class switches, none of them nested",
			},
			{
				"files": ["src/components/content/content-header.astro"],
				"functions": ["<template>"],
				"maxCognitive": 22,
				"reason": "Many optional slots and class switches, none of them nested",
			},
			{
				"files": ["src/components/image/image-carousel-caption.astro"],
				"functions": ["<template>"],
				"maxCognitive": 22,
				"reason": "Many optional slots and class switches, none of them nested",
			},
		],
	},
	"duplicates": {
		"minTokens": 40,
		// Zero would mean no limit, so a threshold just above it fails on any clone group
		"threshold": 0.01,
	},
	// Runs only on demand; at the 0.80 default it mostly finds shared idiom rather than shared logic
	"similarCode": { "threshold": 0.9 },
	"boundaries": {
		// A file takes the first zone it matches, so the map zones and `shared-map` come before the catch-all `packages`
		"zones": [
			{
				"name": "map-tests",
				"patterns": [
					"packages/react-map-component/src/**/*.test.ts",
					"packages/react-map-component/src/lib/map-test-utils.ts",
				],
			},
			{
				"name": "map-domain",
				"patterns": [
					"packages/react-map-component/src/data/data-filter.ts",
					"packages/react-map-component/src/lib/canvas-palette.ts",
				],
			},
			{
				"name": "map-ui",
				"patterns": [
					"packages/react-map-component/src/index.ts",
					"packages/react-map-component/src/react-map-component.tsx",
					"packages/react-map-component/src/canvas/**",
					"packages/react-map-component/src/controls/**",
					"packages/react-map-component/src/popup/**",
					"packages/react-map-component/src/search/**",
					"packages/react-map-component/src/source/**",
					"packages/react-map-component/src/targets/**",
				],
			},
			{
				"name": "map-state",
				"patterns": [
					"packages/react-map-component/src/data/**",
					"packages/react-map-component/src/host/**",
					"packages/react-map-component/src/store/**",
				],
			},
			{ "name": "map-base", "patterns": ["packages/react-map-component/src/**"] },
			{
				"name": "shared-map",
				"patterns": [
					"packages/shared/src/map/location-status.ts",
					"packages/shared/src/map/map-locations.ts",
					"packages/shared/src/map/tailwind-colors.ts",
				],
			},
			{ "name": "packages", "patterns": ["packages/**"] },
			{ "name": "dev", "patterns": ["src/dev/**"] },
			// The Catalog and Map Directory are built on the read path, so it sits a layer below them
			{
				"name": "assembly",
				"patterns": [
					"src/lib/catalog/**",
					"src/lib/map/**",
					"src/lib/collections/*/*-queries.ts",
					"src/lib/collections/chronology/chronology-data.ts",
				],
			},
			{ "name": "read-path", "patterns": ["src/lib/collections/*/*-data.ts"] },
			{ "name": "lib", "patterns": ["src/lib/**", "src/constants.ts", "src/types/**"] },
			{
				"name": "components",
				"patterns": [
					"src/components/**",
					"src/layouts/**",
					"src/pages/**",
					"src/styles/**",
					"src/content.config.ts",
				],
			},
		],
		// A file outside every zone can import and be imported freely, so every analyzed file needs one
		"coverage": {
			"requireAllFiles": true,
			"allowUnmatched": ["*.config.{ts,mjs}", "tests/**"],
		},
		"rules": [
			{
				"from": "map-tests",
				"allow": ["map-domain", "map-ui", "map-state", "map-base", "shared-map", "packages"],
			},
			{ "from": "map-domain", "allow": ["shared-map", "map-base", "packages"] },
			{ "from": "map-ui", "allow": ["map-domain", "map-state", "map-base", "packages"] },
			{ "from": "map-state", "allow": ["map-domain", "map-base", "packages"] },
			{ "from": "map-base", "allow": ["packages"] },
			// The Vite/Rolldown build breaks if a package imports from the app
			{ "from": "packages", "allow": ["shared-map"] },
			{ "from": "read-path", "allow": ["lib", "shared-map", "packages"] },
			{
				"from": "assembly",
				"allow": ["read-path", "lib", "shared-map", "packages", "map-ui", "map-base"],
			},
			{
				"from": "lib",
				"allow": ["assembly", "read-path", "shared-map", "packages", "map-ui", "map-base"],
			},
			{
				"from": "components",
				"allow": ["lib", "assembly", "read-path", "shared-map", "packages", "map-ui", "map-base"],
			},
		],
	},
}
