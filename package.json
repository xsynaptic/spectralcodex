{
	"name": "@xsynaptic/spectralcodex",
	"version": "7.34.0",
	"scripts": {
		"build": "astro check && astro build",
		"check": "lefthook run check",
		"check-content": "mdxlint-content packages/content --root-path=$PWD",
		"check-content-demo": "mdxlint-content packages/content-demo --root-path=$PWD",
		"check-links": "pnpm -F @spectralcodex/scripts check-links",
		"check-types": "tsc --noEmit --extendedDiagnostics",
		"content-schemas": "pnpm -F @spectralcodex/scripts content-schemas",
		"deploy-app": "pnpm -F @spectralcodex/scripts deploy-app",
		"deploy-caddy": "pnpm -F @spectralcodex/scripts deploy-caddy",
		"deploy-images": "pnpm -F @spectralcodex/scripts deploy-images",
		"deploy-infra": "pnpm -F @spectralcodex/scripts deploy-infra",
		"deploy-site": "pnpm -F @spectralcodex/scripts deploy-site",
		"dev": "astro dev",
		"fallow": "fallow",
		"fix": "lefthook run fix",
		"fix-content": "mdxlint-content packages/content --fix --root-path=$PWD",
		"fix-content-demo": "mdxlint-content packages/content-demo --fix --root-path=$PWD",
		"generate-redirects": "pnpm -F @spectralcodex/scripts generate-redirects",
		"improve-content": "pnpm -F @spectralcodex/scripts improve-content",
		"knip": "knip",
		"lint": "eslint",
		"lint-css": "stylelint \"{src,packages}/**/*.{css,astro}\"",
		"lint-css-fix": "stylelint \"{src,packages}/**/*.{css,astro}\" --fix",
		"map-divisions": "pnpm -F @spectralcodex/scripts map-divisions",
		"media-orphans": "pnpm -F @spectralcodex/scripts media-orphans",
		"render-opengraph": "pnpm -F @spectralcodex/scripts render-opengraph",
		"render-images": "pnpm -F @spectralcodex/scripts render-images",
		"similar-content": "pnpm -F @spectralcodex/scripts similar-content",
		"stryker": "stryker run",
		"stryker-file": "stryker run --reporters clear-text --mutate",
		"sweep-images": "pnpm -F @spectralcodex/scripts sweep-images",
		"test": "vitest",
		"test-e2e": "playwright test",
		"test-e2e-dev": "TEST_ENV=dev playwright test",
		"test-e2e-engines": "TEST_ENGINES=all playwright test --grep @engines",
		"test-e2e-engines-dev": "TEST_ENV=dev TEST_ENGINES=all playwright test --grep @engines",
		"test-e2e-smoke": "playwright test --grep @smoke --max-failures=3",
		"test-e2e-smoke-prod": "TEST_ENV=prod playwright test --grep @smoke --max-failures=3",
		"validate-content": "astro sync && pnpm -F @spectralcodex/scripts validate-content",
		"validate-image-alt": "astro sync && pnpm -F @spectralcodex/scripts validate-image-alt",
		"webmentions": "pnpm -F @spectralcodex/scripts webmentions"
	},
	"type": "module",
	"license": "MIT",
	"imports": {
		"#e2e/*": "./tests/e2e/*",
		"#*": "./src/*"
	},
	"dependencies": {
		"astro": "^7.4.4",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@astrojs/markdown-satteri": "^0.4.6",
		"@astrojs/mdx": "^8.1.2",
		"@astrojs/node": "^11.1.9",
		"@astrojs/react": "^7.1.2",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"@pagefind/component-ui": "^1.5.2",
		"@playwright/test": "^1.64.1",
		"@spectralcodex/map-codec": "workspace:*",
		"@spectralcodex/react-map-component": "workspace:*",
		"@spectralcodex/scripts": "workspace:*",
		"@spectralcodex/shared": "workspace:*",
		"@stryker-mutator/core": "^10.1.1",
		"@stryker-mutator/vitest-runner": "^10.1.1",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/eslint-plugin-query": "^5.105.0",
		"@turf/centroid": "^7.4.0",
		"@turf/distance": "^7.4.0",
		"@turf/helpers": "^7.4.0",
		"@types/d3-geo": "^3.1.1",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-time": "^3.0.4",
		"@types/geojson": "^7946.0.16",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@xsynaptic/astro-build-logger": "^1.1.0",
		"@xsynaptic/astro-image-loader": "^1.4.0",
		"@xsynaptic/astro-image-pipeline": "^0.10.0",
		"@xsynaptic/astro-scripts": "^0.14.0",
		"@xsynaptic/eslint-config": "^6.8.0",
		"@xsynaptic/mdxlint-config": "^2.0.0",
		"@xsynaptic/path-suggestions": "^0.2.0",
		"@xsynaptic/satteri-auto-import": "^0.2.2",
		"@xsynaptic/satteri-img-group": "^2.0.2",
		"@xsynaptic/satteri-trailing-slash": "^0.2.1",
		"@xsynaptic/satteri-wrap-cjk": "^0.3.1",
		"@xsynaptic/stylelint-config": "^1.1.6",
		"@xsynaptic/unified-tools": "^5.1.3",
		"@xsynaptic/word-count": "^1.0.0",
		"astro-compressor": "^2.0.1",
		"astro-pagefind": "^2.0.1",
		"astro-seo": "^1.2.0",
		"d3-geo": "^3.1.1",
		"d3-scale": "^4.0.2",
		"d3-time": "^3.1.0",
		"eslint": "^10.13.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react-hooks": "^7.1.1",
		"exiftool-vendored": "^39.0.1",
		"fallow": "^3.37.0",
		"geokdbush": "^2.1.0",
		"globals": "^17.13.0",
		"kdbush": "^4.1.0",
		"knip": "^6.43.0",
		"lefthook": "^2.2.2",
		"ohash": "^2.0.12",
		"p-memoize": "^9.0.0",
		"prettier": "^3.9.10",
		"prettier-plugin-astro": "^1.1.2",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"remeda": "^2.55.0",
		"satteri": "^0.10.5",
		"sharp": "0.35.5",
		"stylelint": "^17.16.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"vitest": "^4.1.12",
		"zod": "^4.6.7"
	},
	"packageManager": "pnpm@12.14.0"
}
